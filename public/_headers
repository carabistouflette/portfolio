# Hashed build output: safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed but stable assets; short window so an art-directed update
# propagates within a week without renaming files.
/fonts/*
  Cache-Control: public, max-age=604800
/images/*
  Cache-Control: public, max-age=604800
/butterflies/*
  Cache-Control: public, max-age=604800
/icons.svg
  Cache-Control: public, max-age=604800
