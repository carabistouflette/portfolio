---
import DisclosureSummary from "./DisclosureSummary.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import GitHubCalendar from "./GitHubCalendar.astro";
import SecurityContributions from "./SecurityContributions.astro";
import { portfolio, type Locale } from "../data/portfolio";
import rawSnapshot from "../data/github.json";
import { validateGitHubSnapshot } from "../lib/github";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = portfolio[locale];
const openSource = content.openSource;
const copy = openSource.github;
const snapshot = validateGitHubSnapshot(rawSnapshot);
const homePath = locale === "fr" ? "/" : "/en/";
const paths: Record<Locale, string> = { fr: "/github/", en: "/en/github/" };
---

<BaseLayout
  locale={locale}
  content={content}
  canonicalPath={paths[locale]}
  alternatePaths={paths}
  meta={{
    title: "GitHub",
    description: `${openSource.intro} ${openSource.profileLink.label}`,
  }}
>
  <main id="main">
    <div class="content-shell pb-6 pt-8 sm:pt-10">
      <a
        class="text-link inline-flex min-h-11 items-center gap-2 text-sm text-muted underline"
        href={`${homePath}#open-source`}
      >
        <span aria-hidden="true">←</span>
        {copy.homeLabel}
      </a>
    </div>
    <section
      class="content-shell pb-24 md:pb-36"
      aria-labelledby="github-title"
    >
      <header class="max-w-4xl border-t border-rule pt-7">
        <div data-motion-reveal>
          <p class="eyebrow mb-3 text-[#9dc7df]">{copy.eyebrow}</p>
          <h1 id="github-title" class="page-title max-w-4xl">
            {copy.pageTitle}
          </h1>
        </div>
        <div data-motion-reveal>
          <p class="body-copy mt-5 max-w-[72ch] text-muted">
            {openSource.intro}{" "}
            <a
              class="underline decoration-[#9dc7df]/40 underline-offset-4 hover:decoration-[#9dc7df]"
              href={openSource.profileLink.url}
              target="_blank"
              rel="noreferrer"
            >
              {openSource.profileLink.label}
            </a>
          </p>
        </div>
      </header>
      <div data-motion-reveal class="mt-10">
        <SecurityContributions
          content={openSource.security}
          headingLevel="h2"
        />
      </div>
      <details class="reading-disclosure content-disclosure mt-6">
        <DisclosureSummary>
          <span>
            <h2 class="card-title">
              {openSource.projects.heading} ·{" "}
              {openSource.projects.entries.length}
            </h2>
            <span class="disclosure-preview">
              {openSource.projects.entries
                .map((project) => project.name)
                .join(" · ")}
            </span>
          </span>
        </DisclosureSummary>
        <div class="reading-disclosure-body">
          <ul class="mt-8 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
            {openSource.projects.entries.map((project) => (
              <li class="min-w-0 border-t border-rule pt-6">
                <h3 class="card-title">
                  <a
                    class="underline decoration-[#9dc7df]/40 underline-offset-4 hover:decoration-[#9dc7df]"
                    href={project.url}
                    target="_blank"
                    rel="noreferrer"
                  >
                    {project.name}
                    <span class="ml-2 text-muted" aria-hidden="true">
                      ↗
                    </span>
                  </a>
                </h3>
                <p class="eyebrow mt-2 text-[#abd1ed]">{project.role}</p>
                <p class="body-copy mt-4 text-muted">{project.description}</p>
                {project.zenodo && (
                  <p class="mt-3 text-sm">
                    <a
                      class="underline decoration-[#9dc7df]/40 underline-offset-4 hover:decoration-[#9dc7df]"
                      href={project.zenodo.url}
                      target="_blank"
                      rel="noreferrer"
                    >
                      {project.zenodo.label}
                      <span class="ml-2 text-muted" aria-hidden="true">
                        ↗
                      </span>
                    </a>
                  </p>
                )}
                {project.publication && (
                  <p class="body-copy mt-2 text-muted">{project.publication}</p>
                )}
              </li>
            ))}
          </ul>
        </div>
      </details>
      <div class="mt-8">
        <GitHubCalendar
          calendar={snapshot.calendar}
          locale={locale}
          copy={copy.calendar}
        />
      </div>
    </section>
  </main>
</BaseLayout>
