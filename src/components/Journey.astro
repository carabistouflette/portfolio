---
import type { JourneyEntry, PortfolioContent } from "../data/portfolio";
import JourneyAxis from "./JourneyAxis.astro";

interface Props {
  content: PortfolioContent;
}

const { content } = Astro.props;
const section = content.navigation.sections.journey;
const axis = content.journey.axis;
const invitation = content.journey.invitation;
const positions = Object.fromEntries(
  axis.map((marker, index) => [marker.id, index + 1]),
) as Record<JourneyEntry["start"], number>;
const entries = content.journey.entries.toSorted(
  (a, b) => positions[a.start] - positions[b.start],
);
const yearGroups: { label: string; start: number; end: number }[] = [];
axis.forEach((marker, index) => {
  const previous = yearGroups.at(-1);
  if (previous?.label === marker.label) previous.end = index;
  else yearGroups.push({ label: marker.label, start: index, end: index });
});

const projectForEntry = (entry: JourneyEntry) =>
  entry.projectId
    ? content.projects.entries.find((project) => project.id === entry.projectId)
    : undefined;
---

<section
  id={section.id}
  class="section-shell content-shell"
  aria-labelledby="journey-title"
>
  <header class="mb-10 border-t border-rule pt-10 md:mb-14">
    <h2 id="journey-title" class="section-title text-balance">
      {content.journey.heading}
    </h2>
  </header>

  <div class="mb-7 hidden lg:block">
    <p class="font-display text-2xl text-muted">
      {content.journey.labels.education}
    </p>
  </div>
  <p class="eyebrow mb-5 text-[#9dc7df] lg:hidden">
    {content.journey.labels.education}
  </p>
  <div class="relative" data-journey-band style={`--steps: ${axis.length - 1}`}>
    <JourneyAxis axis={axis} yearGroups={yearGroups} />
    <p
      class="journey-pill sticky top-[4.25rem] z-10 mb-4 flex w-fit items-center rounded-full border border-rule bg-[#050505]/80 px-3 py-1 text-xs tabular-nums text-[#abd1ed] backdrop-blur-sm max-lg:block lg:hidden"
      data-journey-pill
    >
      {entries.find((entry) => entry.kind === "education")?.period}
    </p>
    <div class="journey-grid relative grid gap-8 max-lg:before:absolute max-lg:before:inset-y-0 max-lg:before:left-0 max-lg:before:w-px max-lg:before:bg-rule/50 max-lg:before:content-[''] lg:gap-x-0 lg:gap-y-12 lg:pt-14">
      {entries
        .filter((entry) => entry.kind === "education")
        .map((entry) => {
          const project = projectForEntry(entry);
          const start = positions[entry.start];
          const end = entry.end ? positions[entry.end] : start + 1;
          return (
            <article
              class="journey-entry relative min-w-0 bg-linear-to-b from-[#24353f]/75 to-[#14212b]/40 px-5 py-5 max-lg:before:absolute max-lg:before:left-[-5px] max-lg:before:top-7 max-lg:before:size-2.5 max-lg:before:rounded-full max-lg:before:bg-[#a5b9c4] max-lg:before:content-[''] lg:border-t-2"
              style={`--start: ${start}; --end: ${end}`}
              data-journey-entry
              data-period={entry.period}
            >
              {entry.logos && (
                <div class="mb-3 flex flex-wrap items-center gap-x-4 gap-y-2">
                  {entry.logos.map((src) => (
                    <img
                      class="h-8 w-auto max-w-full object-contain object-left sm:h-14"
                      src={src}
                      alt=""
                      loading="lazy"
                    />
                  ))}
                </div>
              )}
              <p class="mb-3 text-sm leading-relaxed text-muted tabular-nums">
                {entry.period}
              </p>
              <h3 class="card-title [overflow-wrap:anywhere]">
                {entry.title}
              </h3>
              <p class="body-copy mt-2">{entry.subtitle}</p>
              {entry.detail && (
                <details class="reading-disclosure mt-4">
                  <summary>
                    {content.journey.detailLabel}
                    <span class="sr-only"> — {entry.title}</span>
                  </summary>
                  <div class="reading-disclosure-body">
                    <p class="body-copy max-w-[46ch] text-muted">
                      {entry.detail}
                    </p>
                  </div>
                </details>
              )}
              {project?.url && project.linkLabel && (
                <a
                  class="text-link mt-3 max-w-full border-b border-paper/50 text-xs leading-relaxed"
                  href={project.url}
                >
                  {project.linkLabel}
                  <span class="ml-2" aria-hidden="true">
                    ↗
                  </span>
                </a>
              )}
            </article>
          );
        })}
    </div>
  </div>

  <div class="mt-14 border-t border-rule pt-8 lg:mt-20">
    <div class="mb-7 hidden lg:block">
      <p class="font-display text-2xl text-muted">
        {content.journey.labels.experience}
      </p>
    </div>
    <p class="eyebrow mb-5 text-[#9dc7df] lg:hidden">
      {content.journey.labels.experience}
    </p>
    <div class="relative" data-journey-band style={`--steps: ${axis.length - 1}`}>
      <JourneyAxis axis={axis} yearGroups={yearGroups} />
      <p
        class="journey-pill sticky top-[4.25rem] z-10 mb-4 flex w-fit items-center rounded-full border border-rule bg-[#050505]/80 px-3 py-1 text-xs tabular-nums text-[#abd1ed] backdrop-blur-sm max-lg:block lg:hidden"
        data-journey-pill
      >
        {entries.find((entry) => entry.kind !== "education")?.period}
      </p>
      <div
        class="journey-grid relative grid gap-8 max-lg:before:absolute max-lg:before:inset-y-0 max-lg:before:left-0 max-lg:before:w-px max-lg:before:bg-rule/50 max-lg:before:content-[''] lg:gap-x-0 lg:pt-14"
      >
        {entries
          .filter((entry) => entry.kind !== "education")
          .map((entry) => {
            const project = projectForEntry(entry);
            const start = positions[entry.start];
            const end = entry.end ? positions[entry.end] : start + 1;
            return (
              <article
                class="journey-entry relative min-w-0 self-start px-5 py-5 max-lg:before:absolute max-lg:before:left-[-5px] max-lg:before:top-7 max-lg:before:size-2.5 max-lg:before:rounded-full max-lg:before:bg-[#8fc6ee] max-lg:before:content-[''] lg:border-t-2"
                style={`--start: ${start}; --end: ${end}`}
                data-journey-entry
                data-period={entry.period}
              >
                {entry.logos && (
                  <div class="mb-3 flex flex-wrap items-center gap-x-4 gap-y-2">
                    {entry.logos.map((src) => (
                      <img
                        class="h-8 w-auto max-w-full object-contain object-left sm:h-14"
                        src={src}
                        alt=""
                        loading="lazy"
                      />
                    ))}
                  </div>
                )}
                <p class="mb-3 text-sm leading-relaxed text-muted tabular-nums">
                  {entry.period}
                </p>
                <h3 class="card-title text-[#abd1ed] [overflow-wrap:anywhere]">
                  {entry.title}
                </h3>
                <p class="body-copy mt-2">{entry.subtitle}</p>
                {entry.detail && (
                  <details class="reading-disclosure mt-4">
                    <summary>
                      {content.journey.detailLabel}
                      <span class="sr-only"> — {entry.title}</span>
                    </summary>
                    <div class="reading-disclosure-body">
                      <p class="body-copy max-w-[46ch] text-muted">
                        {entry.detail}
                      </p>
                    </div>
                  </details>
                )}
                {project?.url && project.linkLabel && (
                  <a
                    class="text-link mt-3 max-w-full border-b border-paper/50 text-xs leading-relaxed"
                    href={project.url}
                  >
                    {project.linkLabel}
                    <span class="ml-2" aria-hidden="true">
                      ↗
                    </span>
                  </a>
                )}
              </article>
            );
          })}
        <section
          class="journey-entry min-w-0 border border-dashed border-[#8fc6ee]/60 bg-[#102637]/40 px-5 py-5"
          style={`--start: ${positions[invitation.start]}; --end: ${positions[invitation.end]}`}
          aria-labelledby="journey-invitation-title"
        >
          <h3
            id="journey-invitation-title"
            class="subsection-title text-[#abd1ed]"
          >
            {invitation.title}
          </h3>
          <p class="body-copy mt-3 max-w-[32ch] text-muted">
            {invitation.description}
          </p>
          <a
            class="text-link mt-4 max-w-full border-b border-paper/50 text-xs leading-relaxed sm:text-sm"
            href={`#${content.navigation.sections.contact.id}`}
          >
            {invitation.linkLabel}
            <span class="ml-2 shrink-0" aria-hidden="true">
              ↗
            </span>
          </a>
        </section>
      </div>
    </div>
  </div>
</section>

<script>
  const bands = document.querySelectorAll("[data-journey-band]");
  if (bands.length) {
    const active = new Map();
    const io = new IntersectionObserver(
      (changes) => {
        for (const change of changes) {
          const band = change.target.closest("[data-journey-band]");
          if (!band) continue;
          if (change.isIntersecting) active.set(band, change.target);
          else if (active.get(band) === change.target) active.delete(band);
        }
        for (const [band, card] of active) {
          const pill = band.querySelector("[data-journey-pill]");
          const period = card instanceof HTMLElement ? card.dataset.period : undefined;
          if (pill && period && pill.textContent !== period) {
            pill.textContent = period;
          }
        }
      },
      { rootMargin: "-45% 0px -45% 0px" },
    );
    document.querySelectorAll("[data-journey-entry]").forEach((el) => io.observe(el));
  }
</script>

<style>
  .journey-grid {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: none;
  }

  .journey-entry {
    grid-column: auto;
    grid-row: auto;
  }

  @media (min-width: 64rem) {
    .journey-grid {
      grid-template-columns: repeat(var(--steps), minmax(0, 1fr));
    }

    .journey-entry {
      grid-column: var(--start) / var(--end);
      grid-row: 1;
    }
  }
</style>
