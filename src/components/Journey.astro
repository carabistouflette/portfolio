---
import type { JourneyEntry, PortfolioContent } from "../data/portfolio";

interface Props {
  content: PortfolioContent;
}

const { content } = Astro.props;
const section = content.navigation.sections.journey;
const axis = content.journey.axis;
const invitation = content.journey.invitation;
const positions = Object.fromEntries(
  axis.map((marker, index) => [marker.id, index + 1]),
) as Record<JourneyEntry["start"], number>;
const entries = content.journey.entries.toSorted(
  (a, b) => positions[a.start] - positions[b.start],
);

const projectForEntry = (entry: JourneyEntry) =>
  entry.projectId
    ? content.projects.entries.find((project) => project.id === entry.projectId)
    : undefined;

const tracks = [
  {
    kind: "education",
    label: content.journey.labels.education,
    entries: entries.filter((entry) => entry.kind === "education"),
  },
  {
    kind: "experience",
    label: content.journey.labels.experience,
    entries: entries.filter((entry) => entry.kind !== "education"),
  },
];
---

<section
  id={section.id}
  class="section-shell content-shell"
  aria-labelledby="journey-title"
>
  <header class="mb-8 md:mb-10">
    <h2 id="journey-title" class="section-title text-balance">
      {content.journey.heading}
    </h2>
  </header>

  <div class="grid gap-6 md:gap-8">
    {tracks.map((track) => {
      const first = track.entries[0];
      if (!first) return null;
      const offset = positions[first.start] - 1;
      const trackAxis = axis.slice(offset);
      const steps = trackAxis.length - 1;
      return (
        <section
          aria-labelledby={`journey-${track.kind}-title`}
          style={`--journey-accent: ${track.kind === "education" ? "#a5b9c4" : "#8fc6ee"}; --steps: ${steps}`}
        >
          <h3
            id={`journey-${track.kind}-title`}
            class="mb-3 font-display text-2xl text-paper"
          >
            {track.label}
          </h3>
          <div class="relative lg:pt-10">
            <div
              class="journey-axis pointer-events-none absolute inset-0 hidden lg:block"
              aria-hidden="true"
            >
              {trackAxis.map((marker, index) => (
                <div
                  class="absolute inset-y-0 border-l border-rule/25"
                  style={`left: ${(index / steps) * 100}%`}
                >
                  {(index === 0 ||
                    marker.label !== trackAxis[index - 1].label) && (
                    <span
                      class="absolute top-0 whitespace-nowrap text-sm text-muted"
                      style={`transform: translateX(${index === 0 ? "0" : "-50%"})`}
                    >
                      {marker.label}
                    </span>
                  )}
                  {marker.detail && (
                    <span class="absolute top-5 -translate-x-1/2 whitespace-nowrap text-[0.65rem] text-muted">
                      {marker.detail}
                    </span>
                  )}
                </div>
              ))}
            </div>
            <div class="journey-grid grid gap-4 lg:gap-0">
              {track.entries.map((entry) => {
                const project = projectForEntry(entry);
                const start = positions[entry.start] - offset;
                const end = entry.end
                  ? positions[entry.end] - offset
                  : start + 1;
                return (
                  <article
                    class="journey-entry min-w-0 border-0 px-4 py-3 max-lg:border-l max-lg:border-rule/40 lg:bg-[#102637]/20"
                    style={`--start: ${start}; --end: ${end}`}
                  >
                    <p class="mb-2 text-base font-medium tabular-nums text-[var(--journey-accent)]">
                      {entry.period}
                    </p>
                    <h4 class="card-title [overflow-wrap:anywhere]">
                      {project?.url && project.linkLabel ? (
                        <a
                          class="hover:underline underline-offset-4"
                          href={project.url}
                          aria-label={`${project.linkLabel} — ${entry.title}`}
                        >
                          {entry.title}
                          <span class="ml-1 text-muted" aria-hidden="true">
                            ↗
                          </span>
                        </a>
                      ) : (
                        entry.title
                      )}
                    </h4>
                    <p class="body-copy mt-1 text-muted">{entry.subtitle}</p>
                    {entry.logos && (
                      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
                        {entry.logos.map((src) => (
                          <img
                            class="h-7 w-auto max-w-full object-contain object-left sm:h-14"
                            src={src}
                            alt=""
                            loading="lazy"
                            decoding="async"
                          />
                        ))}
                      </div>
                    )}
                    {entry.detail && (
                      <details class="reading-disclosure mt-2 border-0">
                        <summary>
                          {content.journey.detailLabel}
                          <span class="sr-only"> — {entry.title}</span>
                        </summary>
                        <div class="reading-disclosure-body">
                          <p class="body-copy max-w-[46ch] text-muted">
                            {entry.detail}
                          </p>
                        </div>
                      </details>
                    )}
                  </article>
                );
              })}
              {track.kind === "experience" && (
                <aside
                  class="journey-entry min-w-0 px-4 py-3"
                  style={`--start: ${positions[invitation.start] - offset}; --end: ${positions[invitation.end] - offset}`}
                  aria-labelledby="journey-invitation-title"
                >
                  <h4
                    id="journey-invitation-title"
                    class="card-title text-[#abd1ed]"
                  >
                    {invitation.title}
                  </h4>
                  <p class="body-copy mt-2 text-muted">
                    {invitation.description}
                  </p>
                  <a
                    class="text-link mt-2 w-fit text-sm text-[#abd1ed] hover:underline underline-offset-4"
                    href={`#${content.navigation.sections.contact.id}`}
                  >
                    {invitation.linkLabel}
                    <span class="ml-2 shrink-0" aria-hidden="true">
                      ↗
                    </span>
                  </a>
                </aside>
              )}
            </div>
          </div>
        </section>
      );
    })}
  </div>
</section>

<style>
  .journey-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 64rem) {
    .journey-grid {
      grid-template-columns: repeat(var(--steps), minmax(0, 1fr));
    }

    .journey-entry {
      grid-column: var(--start) / var(--end);
      grid-row: 1;
    }
  }
</style>
