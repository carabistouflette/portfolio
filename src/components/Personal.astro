---
import type { PortfolioContent } from "../data/portfolio";
interface Props {
  content: PortfolioContent["personal"];
}
const { content } = Astro.props;
---

<section
  id="personal"
  class="section-shell content-shell"
  aria-labelledby="personal-title"
>
  <div class="grid items-center gap-12 border-t border-rule/60 pt-12 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:gap-12 lg:gap-24 lg:pt-20">
    <figure
      data-parallax-photo
      class="personal-photo m-0 min-w-0 overflow-hidden rounded-sm border border-rule/40 bg-ink"
    >
      <img
        src="/images/forest-stream-1180.webp"
        srcset="/images/forest-stream-590.webp 590w, /images/forest-stream-1180.webp 1180w"
        sizes="(min-width: 1440px) 640px, (min-width: 768px) 44vw, calc(100vw - 48px)"
        width="1180"
        height="1568"
        alt={content.photoAlt}
        loading="lazy"
        decoding="async"
        class="personal-photo-image block h-auto w-full"
      />
    </figure>
    <div class="min-w-0">
      <header>
        <p class="eyebrow text-[#9dc7df]">{content.eyebrow}</p>
        <h2 id="personal-title" class="mt-6 max-w-[14ch] section-title">
          {content.heading}
        </h2>
        <p class="mt-8 max-w-[40ch] lead-copy text-paper/90">{content.intro}</p>
      </header>
      <div class="mt-10 grid gap-8 border-t border-rule/60 pt-8 lg:mt-12">
        {content.interests.map((interest) => (
          <div>
            <h3 class="card-title text-[#9dc7df]">{interest.title}</h3>
            <p class="mt-3 max-w-[48ch] body-copy text-muted">
              {interest.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
