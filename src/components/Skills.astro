---
import type { PortfolioContent } from "../data/portfolio";
import SkillsCatalog from "./SkillsCatalog.vue";
interface Props {
  content: PortfolioContent;
}
const { content } = Astro.props;
const copy = content.skills;
const projects = new Map(
  content.projects.entries.map((project) => [project.id, project]),
);
const projectLinks = content.projects.entries.map(({ id, title, url }) => ({
  id,
  title,
  url,
}));
---

<section
  id={content.navigation.sections.skills.id}
  class="section-shell content-shell pb-12"
  aria-labelledby="skills-title"
>
  <header>
    <h2 id="skills-title" class="section-title">
      {copy.heading}
    </h2>
  </header>

  <ul class="mt-12 grid gap-10 lg:grid-cols-3 lg:gap-12">
    {copy.capabilities.map((capability) => (
      <li class="capability-toggle group min-w-0 border-t border-rule pt-6">
        <details>
          <summary class="cursor-pointer list-none rounded-sm focus-visible:outline-2 focus-visible:outline-[#9dc7df] focus-visible:outline-offset-4 [&::-webkit-details-marker]:hidden">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <h3 class="card-title">{capability.title}</h3>
                <p class="body-copy mt-3 max-w-[40ch] text-muted">
                  {capability.claim}
                </p>
              </div>
              <span
                class="disclosure-mark mt-1 grid size-10 shrink-0 place-items-center rounded-full border border-[#9dc7df]/40 text-xl leading-none text-[#9dc7df] transition-colors group-hover:border-[#9dc7df]/90 group-hover:bg-[#9dc7df]/10 motion-reduce:transition-none"
                aria-hidden="true"
              >
                +
              </span>
            </div>
          </summary>
          <ul class="mt-5 flex flex-wrap gap-2">
            {capability.technologies.map((technology) => {
              const project = technology.projectId
                ? projects.get(technology.projectId)
                : undefined;
              return (
                <li>
                  {project ? (
                    <a
                      class="inline-flex min-h-9 items-center rounded-full border border-rule/60 px-3 font-mono text-xs text-paper/90 hover:border-[#9dc7df] hover:text-paper"
                      href={project.url || `#project-${project.id}`}
                    >
                      <span class="sr-only">{copy.projectLabel} </span>
                      {technology.name}
                      <span class="ml-2 text-[#9dc7df]" aria-hidden="true">
                        ↗
                      </span>
                    </a>
                  ) : (
                    <span class="inline-flex min-h-9 items-center rounded-full border border-rule/60 px-3 font-mono text-xs text-paper/90">
                      {technology.name}
                    </span>
                  )}
                </li>
              );
            })}
          </ul>
        </details>
      </li>
    ))}
  </ul>

  {copy.groups.length > 0 && (
    <details class="catalog-invitation mt-6 md:mt-8" data-disclosure-reveal>
      <summary
        id="skills-catalog-summary"
        aria-controls="skills-catalog-body"
        class="relative block cursor-pointer border-t border-rule/60 py-3 focus-visible:outline-2 focus-visible:outline-paper focus-visible:outline-offset-4"
      >
        <span class="relative z-10 flex items-center justify-between gap-6">
          <span class="font-mono text-sm uppercase tracking-[0.12em] text-[#a8c8be]">
            <span class="catalog-more-label">
              {copy.catalogMoreLabel}
              <span class="sr-only"> — {copy.heading}</span>
            </span>
            <span class="catalog-close-label">
              {copy.catalogCloseLabel}
              <span class="sr-only"> — {copy.heading}</span>
            </span>
          </span>
          <span
            class="catalog-invitation-arrow shrink-0 text-xl leading-none text-[#a8c8be]"
            aria-hidden="true"
          >
            ↘
          </span>
        </span>
      </summary>
      <div
        id="skills-catalog-body"
        class="reading-disclosure-body pb-6"
        role="region"
        aria-labelledby="skills-catalog-summary"
      >
        <SkillsCatalog
          client:load
          groups={copy.groups}
          projects={projectLinks}
          projectLabel={copy.projectLabel}
        />
        <div
          data-catalog-close-row
          class="mt-6 justify-end border-t border-rule/50 pt-2"
        >
          <button
            type="button"
            data-catalog-close
            class="inline-flex min-h-11 items-center gap-2 font-mono text-sm text-muted hover:text-paper focus-visible:outline-2 focus-visible:outline-paper focus-visible:outline-offset-4"
          >
            <span aria-hidden="true">↑</span>
            {copy.catalogCloseLabel}
          </button>
        </div>
      </div>
    </details>
  )}
</section>
