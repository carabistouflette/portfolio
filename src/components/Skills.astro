---
import DisclosureSummary from "./DisclosureSummary.astro";
import type { PortfolioContent } from "../data/portfolio";
import SkillsCatalog from "./SkillsCatalog.astro";
interface Props {
  content: PortfolioContent;
}
const { content } = Astro.props;
const copy = content.skills;
const projectById = new Map(
  content.projects.entries.map((project) => [project.id, project]),
);
const projectLinks = content.projects.entries.map(({ id, title, url }) => ({
  id,
  title,
  url,
}));
---

<section
  id={content.navigation.sections.skills.id}
  class="section-shell content-shell"
  aria-labelledby="skills-title"
>
  <header>
    <h2 id="skills-title" class="section-title">
      {copy.heading}
    </h2>
  </header>

  <ul class="skill-statements">
    {copy.highlights.map((skill) => (
      <li>
        <article class="skill-statement">
          <h3 class="card-title">{skill.name}</h3>
          <p class="skill-description body-copy mt-3 text-muted">
            {skill.description}
          </p>
          <ul class="skill-evidence mt-3">
            {skill.projectIds.map((id) => {
              const project = projectById.get(id);
              return (
                project && (
                  <li>
                    <a
                      class="skill-project text-link text-sm underline"
                      href={project.url || `#project-${id}`}
                    >
                      {copy.projectLabel} : {project.title}
                      <span class="ml-2" aria-hidden="true">
                        {project.url?.startsWith("https:") ? "↗" : "→"}
                      </span>
                    </a>
                  </li>
                )
              );
            })}
          </ul>
        </article>
      </li>
    ))}
  </ul>

  {copy.groups.length > 0 && (
    <details class="skills-details reading-disclosure content-disclosure mt-8">
      <DisclosureSummary
        id="skills-catalog-summary"
        aria-controls="skills-catalog-body"
      >
        <span class="skills-catalog-invitation">
          <span class="skills-catalog-icon" aria-hidden="true">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linejoin="round"
            >
              <path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z" />
            </svg>
          </span>
          <span>
            <span class="skills-catalog-label">{copy.catalogMoreLabel}</span>
            <span class="skills-catalog-description">
              {copy.catalogPreview}
            </span>
          </span>
        </span>
      </DisclosureSummary>
      <div
        id="skills-catalog-body"
        class="reading-disclosure-body pb-6"
        role="region"
        aria-labelledby="skills-catalog-summary"
      >
        <SkillsCatalog
          groups={copy.groups}
          projects={projectLinks}
          projectLabel={copy.projectLabel}
        />
        <div
          data-catalog-close-row
          class="mt-6 justify-center border-t border-rule/50 pt-4"
        >
          <button
            type="button"
            data-catalog-close
            class="inline-flex min-h-11 cursor-pointer items-center gap-3 rounded-lg border border-rule px-4 text-sm text-[#abd1ed] hover:border-[#9dc7df] hover:text-paper focus-visible:outline-2 focus-visible:outline-paper focus-visible:outline-offset-4"
          >
            {copy.catalogCloseLabel}
            <span aria-hidden="true">↑</span>
          </button>
        </div>
      </div>
    </details>
  )}
</section>

<style>
  .skill-statements {
    margin-top: 2rem;
    display: grid;
    gap: 1.5rem;
    padding: 0;
    list-style: none;
  }
  .skill-statement {
    display: flex;
    height: 100%;
    flex-direction: column;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .skill-description {
    max-width: 60ch;
    text-wrap: pretty;
  }
  .skill-evidence {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    gap: 0.25rem 1.5rem;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 64rem) {
    .skill-statements {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
    .skill-evidence {
      margin-top: auto;
      padding-top: 0.75rem;
    }
  }
  .skill-project {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
  }
  .skills-details > :global(summary) {
    width: 100%;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.25rem;
    border: 1px solid var(--color-rule);
    border-radius: 0.75rem;
    background: #10263780;
    text-decoration: none;
  }
  .skills-details > :global(summary:is(:hover, :focus-visible)) {
    border-color: #9dc7df;
    background: #18374b;
  }
  .skills-details[open] > :global(summary) {
    border-color: #9dc7df;
  }
  .skills-details > :global(summary .disclosure-copy) {
    flex: 1;
  }
  .skills-details
    > :global(summary:is(:hover, :focus-visible) .disclosure-copy) {
    text-decoration: none;
  }
  .skills-catalog-invitation {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .skills-catalog-icon {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    place-items: center;
    border-radius: 0.5rem;
    background: #9dc7df1a;
    color: #abd1ed;
  }
  .skills-catalog-label {
    display: block;
    color: var(--color-paper);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
  }
  .skills-catalog-description {
    display: block;
    margin-top: 0.25rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.6;
    text-wrap: pretty;
  }
  @media (max-width: 39.999rem) {
    .skills-details > :global(summary) {
      gap: 0.75rem;
      padding: 1rem;
    }
    .skills-catalog-invitation {
      gap: 0.75rem;
    }
    .skills-catalog-icon {
      width: 2.25rem;
      height: 2.25rem;
    }
    .skills-details > :global(summary .disclosure-cue-closed),
    .skills-details > :global(summary .disclosure-cue-open) {
      display: none;
    }
  }
  .skills-details[data-disclosure-ready] [data-catalog-close-row] {
    display: flex;
    justify-content: center;
  }
</style>
