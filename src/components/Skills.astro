---
import type { PortfolioContent } from "../data/portfolio";
import ToolIcon from "./ToolIcon.astro";
interface Props { content: PortfolioContent; }
const { content } = Astro.props;
const copy = content.skills;
const projects = new Map(content.projects.entries.map((project) => [project.id, project]));
---
<section id={content.navigation.sections.skills.id} class="section-shell content-shell" aria-labelledby="skills-title">
  <header class="grid gap-6 lg:grid-cols-2 lg:items-end lg:gap-16">
    <h2 id="skills-title" class="section-title">{copy.heading}</h2>
    <p class="max-w-[56ch] text-base leading-loose text-muted">{copy.instruction}</p>
  </header>

  <ul class="mt-12 grid gap-10 md:grid-cols-3 md:gap-6">
    {copy.capabilities.map((capability) => (
      <li class="min-w-0 border-t border-rule pt-6">
        <h3 class="text-xl font-medium tracking-tight">{capability.title}</h3>
        <p class="mt-3 max-w-[40ch] text-sm leading-relaxed text-muted">{capability.claim}</p>
        <ul class="mt-5 flex flex-wrap gap-2">
          {capability.technologies.map((technology) => {
            const project = technology.projectId ? projects.get(technology.projectId) : undefined;
            return (
              <li>
                {project ? (
                  <a class="inline-flex min-h-9 items-center rounded-full border border-rule/60 px-3 font-mono text-xs text-paper/90 hover:border-[#9dc7df] hover:text-paper" href={project.url || `#project-${project.id}`}>
                    <span class="sr-only">{copy.projectLabel} </span>{technology.name}<span class="ml-2 text-[#9dc7df]" aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <span class="inline-flex min-h-9 items-center rounded-full border border-rule/60 px-3 font-mono text-xs text-paper/90">{technology.name}</span>
                )}
              </li>
            );
          })}
        </ul>
      </li>
    ))}
  </ul>

  <h3 class="mt-20 text-xl font-medium tracking-tight">{copy.catalogHeading}</h3>
  <div class="mt-6 grid items-start gap-6 lg:grid-cols-2">
    {copy.groups.map((group) => (
      <details class="group min-w-0 rounded-xl border border-rule/60 bg-[#07121b]/45 open:border-[#9dc7df]/60">
        <summary class="cursor-pointer list-none rounded-xl p-6 focus-visible:outline-2 focus-visible:outline-[#9dc7df] focus-visible:outline-offset-4 sm:p-8 [&::-webkit-details-marker]:hidden">
          <div class="flex items-start justify-between gap-6">
            <div class="min-w-0">
              <h4 class="text-xl font-medium tracking-tight sm:text-2xl">{group.label}</h4>
              <p class="mt-3 max-w-[48ch] text-sm leading-relaxed text-muted">{group.description}</p>
            </div>
            <span class="mt-1 flex shrink-0 items-center gap-4 text-[#9dc7df]" aria-hidden="true"><span class="font-mono text-xs">{group.items.length}</span><span class="text-2xl leading-none group-open:rotate-45">+</span></span>
          </div>
          <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-4 text-sm text-paper/90 group-open:hidden" aria-hidden="true">{group.items.slice(0, 3).map((skill) => <span class="inline-flex items-center gap-3"><ToolIcon name={skill.name} />{skill.name}</span>)}<span class="font-mono text-xs text-muted">+{group.items.length - 3}</span></div>
        </summary>
        <ul class="mx-6 grid gap-3 border-t border-rule/50 pb-6 pt-6 sm:mx-8 sm:grid-cols-2 sm:pb-8">
          {group.items.map((skill) => {
            const related = skill.projectIds.map((id) => projects.get(id)!);
            return (
              <li class="flex min-w-0 flex-col justify-center rounded-md border border-rule/40 bg-[#050d14]/65 px-4 py-3">
                <div class="flex items-center gap-3"><ToolIcon name={skill.name} /><span class="break-words font-mono text-sm">{skill.name}</span></div>
                {related.map((project) => <a class="mt-1 inline-flex min-h-11 items-center gap-2 text-xs text-[#9dc7df] underline hover:text-paper" href={project.url || `#project-${project.id}`}><span class="sr-only">{copy.projectLabel} </span>{project.title}<span aria-hidden="true">↗</span></a>)}
              </li>
            );
          })}
        </ul>
      </details>
    ))}
  </div>

</section>
