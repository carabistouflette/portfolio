---
import type { PortfolioContent } from "../data/portfolio";
import { destinations } from "../data/portfolio";
interface Props {
  content: PortfolioContent;
}
const { content } = Astro.props;
const nameLines = content.hero.title.split(" ");
// Same glyph outlines as the former RobinTrace.vue; `M`-separated subpaths
// become individual stroked paths so each letter draws via `robin-stroke`.
const robinGlyphs = [
  {
    transform: undefined,
    d: "M719 772l20 2v26h-105c-159 0 -203 -146 -297 -319h-67v251c0 48 46 39 102 41v27h-347v-27c60 -2 102 7 102 -41v-559c0 -53 -4 -51 -102 -51v-27h347c161 0 268 56 268 174c0 84 -59 161 -169 194h2c42 85 148 298 246 309zM338 449c96 0 162 -75 162 -155c0 -109 -66 -165 -172 -165h-58v320h68z",
  },
  {
    transform: "translate(674 0)",
    d: "M320 811c-155 0 -276 -108 -276 -267c0 -158 131 -262 276 -262s276 104 276 262c0 159 -121 267 -276 267zM320 319c-91 0 -133 87 -133 222s40 233 133 233c92 0 133 -98 133 -233s-41 -222 -133 -222z",
  },
  {
    transform: "translate(1249 0)",
    d: "M219 403c58 -42 104 -64 129 -64c70 0 140 68 140 195c0 151 -70 236 -160 236c-52 0 -85 -25 -109 -49v-318zM-8 109c23 -6 42 -10 56 -10c24 0 35 12 35 47v608c42 20 138 57 235 57c201 0 308 -115 308 -290c0 -170 -127 -239 -244 -239c-60 0 -136 56 -163 75v-328l-227 51v29z",
  },
  {
    transform: "translate(1854 0)",
    d: "M30 360v-28l223 -50v446c0 48 32 43 87 45v27h-310v-27c45 -2 87 3 87 -45v-325c0 -57 -2 -60 -87 -43zM184 193c43 0 85 -33 85 -82s-42 -82 -85 -82s-85 33 -85 82s42 82 85 82z",
  },
  {
    transform: "translate(2142 0)",
    d: "M465 455c0 -70 -24 -104 -79 -104c-49 0 -99 46 -133 68v309c0 48 37 43 87 45v27h-310v-27c45 -2 87 3 87 -45v-324c0 -38 -1 -51 -26 -51c-13 0 -32 3 -61 9v-27l223 -51v90c57 -35 132 -92 194 -92c107 0 154 61 154 154v292c0 48 32 43 87 45v27h-310v-27c45 -2 87 3 87 -45v-273z",
  },
].map((glyph) => ({
  transform: glyph.transform,
  paths: glyph.d.split(/(?=M)/),
}));
---

<section
  class="hero content-shell relative isolate grid gap-14 pb-16 pt-8 md:grid-cols-[minmax(0,1.35fr)_minmax(0,0.85fr)] md:items-start md:gap-x-12 md:gap-y-8 md:pb-16 md:pt-10 lg:min-h-[calc(100vh-3.75rem)] lg:min-h-[calc(100svh-3.75rem)] lg:min-h-[calc(100dvh-3.75rem)] lg:items-end xl:gap-x-16 min-[100rem]:gap-x-[min(8rem,calc(4rem+(100vw-100rem)*0.2))] [@media(min-height:1600px)]:lg:items-center!"
  aria-labelledby="hero-title"
>
  <div
    class="pointer-events-none absolute inset-0 -z-10 overflow-clip"
    aria-hidden="true"
  >
    <div class="absolute -right-24 top-0 h-[32rem] w-[38rem] bg-[radial-gradient(ellipse,rgba(23,75,105,0.32),transparent_68%)] md:right-0 md:h-[46rem] md:w-[56rem]"></div>
  </div>
  <div
    class="hero-cat-layer pointer-events-none absolute inset-0 z-0 overflow-clip"
    aria-hidden="true"
  >
    <div class="hero-cat absolute top-4 left-[45%] w-[55%] max-w-none opacity-100 md:top-10 md:left-[56%] md:w-[30%] lg:top-8 lg:left-[60%] lg:w-[28%]">
      <img
        src="/images/hero-cat-640.webp"
        srcset="/images/hero-cat-640.webp 640w, /images/hero-cat.webp 981w"
        sizes="(min-width: 64rem) 28vw, (min-width: 48rem) 30vw, 55vw"
        alt=""
        width="640"
        height="785"
        fetchpriority="high"
        decoding="async"
        class="hero-cat-image absolute inset-0 size-full object-contain"
      />
      <span class="hero-cat-eye hero-cat-eye-left" aria-hidden="true"></span>
      <span class="hero-cat-eye hero-cat-eye-right" aria-hidden="true"></span>
      <div class="hero-cat-bubble hidden lg:block">
        <svg
          class="hero-cat-bubble-frame"
          viewBox="0 0 210 132"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path
            class="hero-cat-bubble-outline"
            d="M 9 46 C 8 60 8 74 8 86 C 8 96 9 106 13 114 C 18 122 28 127 42 127 C 74 130 128 130 170 127 C 190 126 200 116 201 100 C 204 80 201 55 202 32 C 203 16 194 8 178 6 C 140 2 72 2 30 6 C 20 7 13 12 10 18 C 9 20 9 23 9 26"
          ></path>
          <path
            class="hero-cat-bubble-beak"
            d="M 9 26 C -25 15 -68 13 -95 24 C -65 20 -35 38 9 46 Z"
          ></path>
        </svg>
        <p class="hero-cat-bubble-label">{content.hero.availability.label}</p>
        <p class="hero-cat-bubble-detail">{content.hero.availability.detail}</p>
        <p class="hero-cat-bubble-note">{content.hero.availability.note}</p>
      </div>
    </div>
  </div>
  <div class="hero-copy @container relative z-10 min-w-0">
    <p class="eyebrow mb-0 max-w-[24ch]">{content.hero.eyebrow}</p>
    <h1
      id="hero-title"
      aria-label={content.hero.title}
      class="hero-name-size mt-2 font-display leading-[0.82] tracking-[-0.065em]"
    >
      {nameLines.map((line, index) =>
        index === 0 ? (
          <span aria-hidden="true" class="hero-name-first block">
            {line}
          </span>
        ) : (
          <span
            aria-hidden="true"
            data-robin-trace
            class="hero-name-last block relative ml-[0.12em] mt-3 text-transparent [-webkit-text-stroke:1px_#a9c8db] md:[-webkit-text-stroke:1.5px_#a9c8db] forced-colors:text-[CanvasText]"
          >
            <span class="hero-name-fallback">Robin</span>
            <svg
              class="hero-robin-trace"
              viewBox="0 0 2890 1000"
              preserveAspectRatio="xMinYMid meet"
              aria-hidden="true"
              focusable="false"
            >
              {robinGlyphs.map((glyph) => (
                <g transform={glyph.transform}>
                  {glyph.paths.map((path) => (
                    <path pathLength="1" d={path} />
                  ))}
                </g>
              ))}
            </svg>
          </span>
        ),
      )}
    </h1>
    <p class="hero-headline-size mt-8 max-w-[30ch] font-medium leading-snug tracking-tight text-balance">
      {content.hero.headline}
    </p>
    <p class="hero-summary-size mt-3 max-w-[42ch] text-muted">
      {content.hero.affiliation}
    </p>
    <details class="hero-availability group mt-6 max-w-xl rounded-[1.75rem_1.25rem_1.9rem_1.5rem] border border-[#8fc6ee]/60 bg-linear-to-r from-[#102637]/60 to-transparent px-6 py-5 transition-colors hover:border-paper open:border-paper lg:hidden">
      <summary class="flex cursor-pointer items-start justify-between gap-4 rounded-xl focus-visible:outline-2 focus-visible:outline-paper focus-visible:outline-offset-4 [&::-webkit-details-marker]:hidden">
        <span class="min-w-0 text-lg font-medium leading-snug text-paper sm:text-xl">
          <span class="block text-[#abd1ed]">{content.hero.availability.label}</span>
          {content.hero.availability.detail.split("·").map((part) => (
            <span class="block">{part.trim()}</span>
          ))}
        </span>
        <span
          aria-hidden="true"
          class="disclosure-mark mt-1 shrink-0 text-2xl leading-none text-[#9dc7df] transition-transform group-open:rotate-45"
        >
          +
        </span>
      </summary>
      <p class="hero-availability-note mt-3 body-copy text-muted">
        {content.hero.availability.note}
      </p>
    </details>
    <p class="sr-only hidden lg:block">
      {content.hero.availability.label}. {content.hero.availability.detail}.
      {content.hero.availability.note}
    </p>
    <div class="hero-actions relative z-10 mt-10 flex flex-wrap items-center gap-x-8 gap-y-5">
      <a
        class="inline-flex min-h-12 items-center border border-rule px-5 text-sm uppercase tracking-[0.14em] text-[#9dc7df] hover:border-paper hover:text-paper"
        href={destinations.cv}
        download
      >
        {content.hero.cvCta}
      </a>
      <a
        class="text-link text-base text-muted"
        href={`#${content.navigation.sections.contact.id}`}
      >
        {content.hero.contactCta}
      </a>
    </div>
  </div>
  <section
    class="hero-summary relative z-10 min-w-0 md:pt-[24rem] lg:self-end lg:pt-0 [@media(min-height:1600px)]:lg:self-center!"
    aria-label={content.hero.summaryTitle}
  >
    <div class="ml-auto max-w-xl lg:rounded-[1.75rem_1.25rem_1.9rem_1.5rem] lg:border lg:border-[#8fc6ee]/60 lg:bg-linear-to-r lg:from-[#102637]/60 lg:to-transparent lg:px-8 lg:py-6">
      <span
        aria-hidden="true"
        class="mb-3 block select-none font-display text-5xl leading-none text-[#8fc6ee]/70 lg:hidden"
      >
        «
      </span>
      <p class="hero-summary-size max-w-[42ch] leading-[1.42] text-pretty text-muted lg:text-paper">
        {content.hero.description}
      </p>
    </div>
  </section>

  <script>
    import "../scripts/robin-trace";
  </script>
</section>
