---
import type { Locale, PortfolioContent } from "../data/portfolio";
import { destinations } from "../data/portfolio";
interface Props {
  content: PortfolioContent;
  locale: Locale;
}
const { content, locale } = Astro.props;
const nameLines = content.hero.title.split(" ");
// The absolute cat uses the shell's padding-box width, not the content width.
// Match global.css: 88rem shell, widening above 100rem up to 122rem;
// The short-desktop 22% override takes precedence; the cat is hidden on mobile.
const catSizes = [
  "(min-width: 100rem) and (max-height: 820px) min(calc(13.2vw + 6.16rem), 26.84rem)",
  "(min-width: 64rem) and (max-height: 820px) min(22vw, 19.36rem)",
  "(min-width: 100rem) min(calc(16.8vw + 7.84rem), 34.16rem)",
  "(min-width: 64rem) min(28vw, 24.64rem)",
  "30vw",
].join(", ");
// Same glyph outlines as the former RobinTrace.vue; `M`-separated subpaths
// become individual stroked paths so each letter draws via `robin-stroke`.
const robinGlyphs = [
  {
    transform: undefined,
    d: "M719 772l20 2v26h-105c-159 0 -203 -146 -297 -319h-67v251c0 48 46 39 102 41v27h-347v-27c60 -2 102 7 102 -41v-559c0 -53 -4 -51 -102 -51v-27h347c161 0 268 56 268 174c0 84 -59 161 -169 194h2c42 85 148 298 246 309zM338 449c96 0 162 -75 162 -155c0 -109 -66 -165 -172 -165h-58v320h68z",
  },
  {
    transform: "translate(674 0)",
    d: "M320 811c-155 0 -276 -108 -276 -267c0 -158 131 -262 276 -262s276 104 276 262c0 159 -121 267 -276 267zM320 319c-91 0 -133 87 -133 222s40 233 133 233c92 0 133 -98 133 -233s-41 -222 -133 -222z",
  },
  {
    transform: "translate(1249 0)",
    d: "M219 403c58 -42 104 -64 129 -64c70 0 140 68 140 195c0 151 -70 236 -160 236c-52 0 -85 -25 -109 -49v-318zM-8 109c23 -6 42 -10 56 -10c24 0 35 12 35 47v608c42 20 138 57 235 57c201 0 308 -115 308 -290c0 -170 -127 -239 -244 -239c-60 0 -136 56 -163 75v-328l-227 51v29z",
  },
  {
    transform: "translate(1854 0)",
    d: "M30 360v-28l223 -50v446c0 48 32 43 87 45v27h-310v-27c45 -2 87 3 87 -45v-325c0 -57 -2 -60 -87 -43zM184 193c43 0 85 -33 85 -82s-42 -82 -85 -82s-85 33 -85 82s42 82 85 82z",
  },
  {
    transform: "translate(2142 0)",
    d: "M465 455c0 -70 -24 -104 -79 -104c-49 0 -99 46 -133 68v309c0 48 37 43 87 45v27h-310v-27c45 -2 87 3 87 -45v-324c0 -38 -1 -51 -26 -51c-13 0 -32 3 -61 9v-27l223 -51v90c57 -35 132 -92 194 -92c107 0 154 61 154 154v292c0 48 32 43 87 45v27h-310v-27c45 -2 87 3 87 -45v-273z",
  },
].map((glyph) => ({
  transform: glyph.transform,
  paths: glyph.d.split(/(?=M)/),
}));
---

<section
  id="accueil"
  class="hero content-shell relative isolate grid py-12 md:grid-cols-[minmax(0,1.35fr)_minmax(0,0.85fr)] md:items-center md:gap-x-12 md:py-16 lg:min-h-[calc(100svh-4rem)] xl:gap-x-16"
  aria-labelledby="hero-title"
>
  <div
    class="hero-cat-layer pointer-events-none absolute inset-0 z-0 hidden overflow-clip md:block"
    aria-hidden="true"
  >
    <div class="hero-cat absolute top-1/2 left-[62%] w-[30%] max-w-none -translate-y-1/2 opacity-100 lg:w-[28%]">
      <img
        src="/images/hero-cat-640.webp"
        srcset="/images/hero-cat-320.webp 320w, /images/hero-cat-480.webp 480w, /images/hero-cat-640.webp 640w, /images/hero-cat.webp 981w"
        sizes={catSizes}
        alt=""
        width="640"
        height="785"
        fetchpriority="high"
        decoding="async"
        class="hero-cat-image absolute inset-0 size-full object-contain"
      />
      <span class="hero-cat-eye hero-cat-eye-left" aria-hidden="true"></span>
      <span class="hero-cat-eye hero-cat-eye-right" aria-hidden="true"></span>
    </div>
  </div>
  <div class="hero-copy @container relative z-10 min-w-0">
    <a
      class="hero-availability"
      href={`#${content.navigation.sections.contact.id}`}
    >
      <span class="hero-availability-dot" aria-hidden="true"></span>
      <span>{content.hero.availability.label}</span>
      <span aria-hidden="true">↗</span>
    </a>
    <h1
      id="hero-title"
      aria-label={content.hero.title}
      class="hero-name-size mt-6 font-display leading-[0.82] tracking-[-0.065em]"
    >
      {nameLines.map((line, index) =>
        index === 0 ? (
          <span aria-hidden="true" class="hero-name-first block">
            {line}
          </span>
        ) : (
          <span
            aria-hidden="true"
            data-robin-trace
            class="hero-name-last block relative ml-[0.12em] mt-3 text-transparent [-webkit-text-stroke:1px_#a9c8db] md:[-webkit-text-stroke:1.5px_#a9c8db] forced-colors:text-[CanvasText]"
          >
            <span class="hero-name-fallback">Robin</span>
            <svg
              class="hero-robin-trace"
              viewBox="0 0 2890 1000"
              preserveAspectRatio="xMinYMid meet"
              aria-hidden="true"
              focusable="false"
            >
              {robinGlyphs.map((glyph) => (
                <g transform={glyph.transform}>
                  {glyph.paths.map((path) => (
                    <path pathLength="1" d={path} />
                  ))}
                </g>
              ))}
            </svg>
          </span>
        ),
      )}
    </h1>
    <p class="hero-role">
      {locale === "fr"
        ? "Étudiant en master IA · MIAS"
        : "AI master’s student · MIAS"}
    </p>
    <p class="hero-headline-size mt-3 max-w-[30ch] font-medium leading-snug tracking-tight text-balance">
      {content.hero.headline}
    </p>
    <p class="mt-5 max-w-xl text-base leading-relaxed text-muted">
      {content.hero.availability.detail}
      <span class="block">{content.contact.location}</span>
    </p>
    <div class="hero-actions relative z-10 mt-7 flex flex-wrap items-center gap-3">
      <a
        class="hero-button hero-button-primary"
        href={`#${content.navigation.sections.projects.id}`}
      >
        {content.hero.projectsCta}
        <span aria-hidden="true">↓</span>
      </a>
      <a
        class="hero-button hero-button-secondary"
        href={destinations.cv[locale]}
        download={`Alexis-Robin-CV-${locale.toUpperCase()}.pdf`}
      >
        {content.hero.cvCta}
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M8 2v8m-3-3 3 3 3-3M3 11v3h10v-3"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    </div>
  </div>

  <script>
    import "../scripts/robin-trace";
  </script>
</section>
