---
import type { PortfolioContent } from "../data/portfolio";
import { destinations } from "../data/portfolio";
import RobinTrace from "./RobinTrace.vue";
interface Props {
  content: PortfolioContent;
}
const { content } = Astro.props;
const nameLines = content.hero.title.split(" ");
---

<section
  class="hero content-shell relative isolate grid min-h-[calc(100vh-3.75rem)] min-h-[calc(100svh-3.75rem)] min-h-[calc(100dvh-3.75rem)] gap-14 pb-16 pt-8 md:grid-cols-[minmax(0,1.35fr)_minmax(0,0.85fr)] md:items-start md:gap-x-12 md:gap-y-8 md:pb-16 md:pt-10 lg:items-end xl:gap-x-16"
  aria-labelledby="hero-title"
>
  <div
    class="pointer-events-none absolute inset-0 -z-10 overflow-clip"
    aria-hidden="true"
  >
    <div class="absolute -right-24 top-0 h-[32rem] w-[38rem] bg-[radial-gradient(ellipse,rgba(23,75,105,0.32),transparent_68%)] md:right-0 md:h-[46rem] md:w-[56rem]"></div>
  </div>
  <div
    class="hero-cat-layer pointer-events-none absolute inset-0 z-0 overflow-clip"
    aria-hidden="true"
  >
    <div class="hero-cat absolute top-4 left-[45%] w-[55%] max-w-none opacity-100 md:top-10 md:left-[56%] md:w-[30%] lg:top-8 lg:left-[60%] lg:w-[28%]">
      <img
        src="/images/hero-cat-640.webp"
        srcset="/images/hero-cat-640.webp 640w, /images/hero-cat.webp 981w"
        sizes="(min-width: 64rem) 28vw, (min-width: 48rem) 30vw, 55vw"
        alt=""
        width="640"
        height="785"
        fetchpriority="high"
        decoding="async"
        class="hero-cat-image absolute inset-0 size-full object-contain"
      />
      <span class="hero-cat-eye hero-cat-eye-left" aria-hidden="true"></span>
      <span class="hero-cat-eye hero-cat-eye-right" aria-hidden="true"></span>
      <div class="hero-cat-bubble hidden lg:block">
        <svg
          class="hero-cat-bubble-frame"
          viewBox="0 0 210 132"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path
            class="hero-cat-bubble-outline"
            d="M 9 46 C 8 60 8 74 8 86 C 8 96 9 106 13 114 C 18 122 28 127 42 127 C 74 130 128 130 170 127 C 190 126 200 116 201 100 C 204 80 201 55 202 32 C 203 16 194 8 178 6 C 140 2 72 2 30 6 C 20 7 13 12 10 18 C 9 20 9 23 9 26"
          ></path>
          <path
            class="hero-cat-bubble-beak"
            d="M 9 26 C -25 15 -68 13 -95 24 C -65 20 -35 38 9 46 Z"
          ></path>
        </svg>
        <p class="hero-cat-bubble-label">{content.hero.availability.label}</p>
        <p class="hero-cat-bubble-detail">{content.hero.availability.detail}</p>
        <p class="hero-cat-bubble-note">{content.hero.availability.note}</p>
      </div>
    </div>
  </div>
  <div class="hero-copy relative z-10 min-w-0">
    <p class="eyebrow mb-0 max-w-[24ch]">{content.hero.eyebrow}</p>
    <h1
      id="hero-title"
      aria-label={content.hero.title}
      class="mt-2 font-display text-[clamp(5.25rem,18vw,17rem)] leading-[0.82] tracking-[-0.065em]"
    >
      {nameLines.map((line, index) =>
        index === 0 ? (
          <span aria-hidden="true" class="hero-name-first block">
            {line}
          </span>
        ) : (
          <RobinTrace client:load />
        ),
      )}
    </h1>
    <p class="mt-8 max-w-[30ch] text-[clamp(1.5rem,2.5vw,2.25rem)] font-medium leading-snug tracking-tight text-balance">
      {content.hero.headline}
    </p>
    <div class="hero-availability mt-6 max-w-xl rounded-[1.75rem_1.25rem_1.9rem_1.5rem] border border-[#8fc6ee]/60 bg-linear-to-r from-[#102637]/60 to-transparent px-6 py-5 lg:hidden">
      <p class="text-lg font-medium leading-snug text-paper sm:text-xl">
        <span class="text-[#abd1ed]">{content.hero.availability.label}</span>
        <span class="text-rule/80 mx-2" aria-hidden="true">
          ·
        </span>
        <span>{content.hero.availability.detail}</span>
      </p>
      <p class="hero-availability-note mt-1.5 text-base leading-relaxed text-muted">
        {content.hero.availability.note}
      </p>
    </div>
    <p class="sr-only hidden lg:block">
      {content.hero.availability.label}. {content.hero.availability.detail}.
      {content.hero.availability.note}
    </p>
    <p class="hero-academic academic-line mt-5 max-w-[32ch] text-lg font-medium leading-relaxed text-muted sm:text-xl">
      {content.hero.academic}
    </p>
    <div class="hero-actions relative z-10 mt-10 flex flex-wrap items-center gap-x-8 gap-y-5">
      <a
        class="group inline-flex min-h-16 items-center gap-8 border-b-2 border-paper text-lg font-medium"
        href={`#${content.navigation.sections.projects.id}`}
      >
        {content.hero.projectsCta}
        <span
          class="text-2xl motion-safe:transition-transform motion-safe:group-hover:translate-y-1"
          aria-hidden="true"
        >
          ↓
        </span>
      </a>
      <a
        class="inline-flex min-h-12 items-center border border-rule px-5 font-mono text-sm uppercase tracking-[0.14em] text-[#9dc7df] hover:border-paper hover:text-paper"
        href={destinations.cv}
        download
      >
        {content.hero.cvCta}
      </a>
      <a
        class="text-link text-base text-muted"
        href={`#${content.navigation.sections.contact.id}`}
      >
        {content.hero.contactCta}
      </a>
    </div>
  </div>
  <aside
    class="hero-summary relative z-10 min-w-0 md:pt-[24rem] lg:pt-[28rem] [@media(max-height:820px)]:lg:pt-48"
    aria-label={content.hero.summaryTitle}
  >
    <p class="max-w-[38ch] text-[clamp(1.5rem,2.4vw,2.15rem)] leading-snug tracking-tight text-pretty">
      {content.hero.description}
    </p>
    <p class="hero-personal mt-8 max-w-[40ch] text-base leading-relaxed text-muted sm:text-lg">
      {content.openSource.personal}
    </p>
  </aside>
</section>
