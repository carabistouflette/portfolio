---
import type { PortfolioContent } from "../data/portfolio";
import { destinations } from "../data/portfolio";
import RobinTrace from "./RobinTrace.vue";
interface Props { content: PortfolioContent; }
const { content } = Astro.props;
const nameLines = content.hero.title.split(" ");
---
<section class="hero content-shell relative isolate grid gap-14 pb-20 pt-12 md:min-h-[min(58rem,90svh)] md:grid-cols-[minmax(0,1.35fr)_minmax(0,0.85fr)] md:items-start lg:items-end md:gap-x-12 md:gap-y-8 md:pb-20 xl:gap-x-16" aria-labelledby="hero-title">
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-clip" aria-hidden="true">
    <div class="absolute -right-24 top-0 h-[32rem] w-[38rem] bg-[radial-gradient(ellipse,rgba(23,75,105,0.32),transparent_68%)] md:right-0 md:h-[46rem] md:w-[56rem]"></div>
  </div>
  <div class="hero-cat-layer pointer-events-none absolute inset-0 z-0 overflow-clip" aria-hidden="true">
    <img src="/images/hero-cat.webp" alt="" width="981" height="1204" fetchpriority="high" decoding="async" class="hero-cat absolute top-4 left-[45%] w-[55%] max-w-none opacity-90 md:top-10 md:left-[56%] md:w-[30%] lg:top-8 lg:left-[60%] lg:w-[28%] [@media(max-height:820px)]:lg:top-6 [@media(max-height:820px)]:lg:w-[22%]" />
  </div>
  <div class="hero-copy relative z-10 min-w-0">
    <p class="eyebrow mb-0 max-w-[24ch]">{content.hero.eyebrow}</p>
    <h1 id="hero-title" aria-label={content.hero.title} class="mt-2 font-display text-[clamp(5.25rem,18vw,17rem)] leading-[0.82] tracking-[-0.065em]">
      {nameLines.map((line, index) => index === 0 ? (
        <span aria-hidden="true" class="block">{line}</span>
      ) : (
        <RobinTrace client:load />
      ))}
    </h1>
    <p class="mt-6 max-w-[30ch] text-[clamp(1.35rem,2.2vw,1.9rem)] font-medium leading-snug tracking-tight text-balance">{content.hero.headline}</p>
    <p class="mt-4 text-base font-medium leading-snug">{content.hero.availability.label} · {content.hero.availability.detail}</p>
    <p class="hero-availability-note mt-1 text-sm leading-relaxed text-muted">{content.hero.availability.note}</p>
    <p class="hero-academic academic-line mt-4 max-w-[32ch] text-base font-medium leading-relaxed text-muted sm:text-lg">{content.hero.academic}</p>
  </div>
  <aside class="hero-summary relative z-10 min-w-0 md:pt-[26rem] lg:pt-[32rem] [@media(max-height:820px)]:lg:pt-56" aria-label={content.hero.summaryTitle}>
    <p class="max-w-[40ch] text-[clamp(1.35rem,2.2vw,1.75rem)] leading-snug tracking-tight text-pretty">{content.hero.description}</p>
    <p class="hero-personal mt-6 max-w-[40ch] text-sm leading-relaxed text-muted sm:text-base">{content.openSource.personal}</p>
  </aside>
  <div class="hero-actions relative z-10 flex flex-wrap items-center gap-x-8 gap-y-5 md:col-span-2">
    <a class="group inline-flex min-h-14 items-center gap-8 border-b border-paper text-base" href={`#${content.navigation.sections.projects.id}`}>
      {content.hero.projectsCta}<span class="text-2xl motion-safe:transition-transform motion-safe:group-hover:translate-y-1" aria-hidden="true">↓</span>
    </a>
    <a class="inline-flex min-h-11 items-center border border-rule px-4 font-mono text-xs uppercase tracking-[0.14em] text-[#9dc7df] hover:border-paper hover:text-paper" href={destinations.cv} download>{content.hero.cvCta}</a>
    <a class="text-link text-sm text-muted" href={`#${content.navigation.sections.contact.id}`}>{content.hero.contactCta}</a>
  </div>
</section>
