---
import type { PortfolioContent } from "../data/portfolio";
import { destinations } from "../data/portfolio";
import RobinTrace from "./RobinTrace.vue";
interface Props { content: PortfolioContent; }
const { content } = Astro.props;
const nameLines = content.hero.title.split(" ");
---
<section class="hero content-shell relative isolate grid min-h-[calc(100vh-3.75rem)] min-h-[calc(100svh-3.75rem)] min-h-[calc(100dvh-3.75rem)] gap-14 pb-16 pt-8 md:grid-cols-[minmax(0,1.35fr)_minmax(0,0.85fr)] md:items-start md:gap-x-12 md:gap-y-8 md:pb-16 md:pt-10 lg:items-end xl:gap-x-16" aria-labelledby="hero-title">
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-clip" aria-hidden="true">
    <div class="absolute -right-24 top-0 h-[32rem] w-[38rem] bg-[radial-gradient(ellipse,rgba(23,75,105,0.32),transparent_68%)] md:right-0 md:h-[46rem] md:w-[56rem]"></div>
  </div>
  <div class="hero-cat-layer pointer-events-none absolute inset-0 z-0 overflow-clip" aria-hidden="true">
    <div class="hero-cat absolute top-4 left-[45%] w-[55%] max-w-none opacity-100 md:top-10 md:left-[56%] md:w-[30%] lg:top-8 lg:left-[60%] lg:w-[28%]">
      <img src="/images/hero-cat-640.webp" srcset="/images/hero-cat-640.webp 640w, /images/hero-cat.webp 981w" sizes="(min-width: 64rem) 28vw, (min-width: 48rem) 30vw, 55vw" alt="" width="640" height="785" fetchpriority="high" decoding="async" class="hero-cat-image absolute inset-0 size-full object-contain" />
      <span class="hero-cat-eye hero-cat-eye-left" aria-hidden="true"></span>
      <span class="hero-cat-eye hero-cat-eye-right" aria-hidden="true"></span>
    </div>
  </div>
  <div class="hero-copy relative z-10 min-w-0">
    <p class="eyebrow mb-0 max-w-[24ch]">{content.hero.eyebrow}</p>
    <h1 id="hero-title" aria-label={content.hero.title} class="mt-2 font-display text-[clamp(5.25rem,18vw,17rem)] leading-[0.82] tracking-[-0.065em]">
      {nameLines.map((line, index) => index === 0 ? (
        <span aria-hidden="true" class="hero-name-first block">{line}</span>
      ) : (
        <RobinTrace client:load />
      ))}
    </h1>
    <p class="mt-8 max-w-[30ch] text-[clamp(1.5rem,2.5vw,2.25rem)] font-medium leading-snug tracking-tight text-balance">{content.hero.headline}</p>
    <p class="mt-5 text-lg font-medium leading-snug sm:text-xl">{content.hero.availability.label} · {content.hero.availability.detail}</p>
    <p class="hero-availability-note mt-2 text-base leading-relaxed text-muted">{content.hero.availability.note}</p>
    <p class="hero-academic academic-line mt-5 max-w-[32ch] text-lg font-medium leading-relaxed text-muted sm:text-xl">{content.hero.academic}</p>
    <div class="hero-actions relative z-10 mt-10 flex flex-wrap items-center gap-x-8 gap-y-5">
      <a class="group inline-flex min-h-16 items-center gap-8 border-b-2 border-paper text-lg font-medium" href={`#${content.navigation.sections.projects.id}`}>
        {content.hero.projectsCta}<span class="text-2xl motion-safe:transition-transform motion-safe:group-hover:translate-y-1" aria-hidden="true">↓</span>
      </a>
      <a class="inline-flex min-h-12 items-center border border-rule px-5 font-mono text-sm uppercase tracking-[0.14em] text-[#9dc7df] hover:border-paper hover:text-paper" href={destinations.cv} download>{content.hero.cvCta}</a>
      <a class="text-link text-base text-muted" href={`#${content.navigation.sections.contact.id}`}>{content.hero.contactCta}</a>
    </div>
  </div>
  <aside class="hero-summary relative z-10 min-w-0 md:pt-[24rem] lg:pt-[28rem] [@media(max-height:820px)]:lg:pt-48" aria-label={content.hero.summaryTitle}>
    <p class="max-w-[38ch] text-[clamp(1.5rem,2.4vw,2.15rem)] leading-snug tracking-tight text-pretty">{content.hero.description}</p>
    <p class="hero-personal mt-8 max-w-[40ch] text-base leading-relaxed text-muted sm:text-lg">{content.openSource.personal}</p>
  </aside>
</section>
