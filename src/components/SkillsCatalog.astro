---
import ToolIcon from "./ToolIcon.astro";

interface SkillItem {
  name: string;
  projectIds: string[];
}

interface SkillGroup {
  label: string;
  description: string;
  items: SkillItem[];
}

interface Project {
  id: string;
  title: string;
  url?: string;
}

interface Props {
  groups: SkillGroup[];
  projects: Project[];
  projectLabel: string;
}

const { groups, projects, projectLabel } = Astro.props;
const projectById = new Map(projects.map((project) => [project.id, project]));
const relatedProjects = (skill: SkillItem): Project[] =>
  skill.projectIds
    .map((projectId) => projectById.get(projectId))
    .filter((project): project is Project => Boolean(project));
---

<script>
  import "../scripts/skills-catalog";
</script>
<div
  data-motion-reveal
  data-skills-catalog
  class="mt-6 grid items-start gap-6 lg:grid-cols-2"
>
  {groups.map((group, index) => (
    <details
      data-motion-catalog
      class="group min-w-0 rounded-xl border border-rule/60 bg-[#07121b]/45"
    >
      <summary
        id={`skills-summary-${index}`}
        aria-controls={`skills-panel-${index}`}
        class="cursor-pointer list-none rounded-xl p-6 focus-visible:outline-2 focus-visible:outline-[#9dc7df] focus-visible:outline-offset-4 sm:p-8 [&::-webkit-details-marker]:hidden"
      >
        <div class="flex items-start justify-between gap-6">
          <div class="min-w-0">
            <h4 class="card-title">{group.label}</h4>
            <p class="mt-3 max-w-[48ch] body-copy text-muted">
              {group.description}
            </p>
          </div>
          <span
            class="mt-1 flex shrink-0 items-center gap-4 text-[#9dc7df]"
            aria-hidden="true"
          >
            <span class="font-mono text-xs">{group.items.length}</span>
            <span class="disclosure-mark text-2xl leading-none">+</span>
          </span>
        </div>
        <div
          class="skill-preview mt-6 flex flex-wrap items-center gap-x-6 gap-y-4 text-sm text-paper/90"
          aria-hidden="false"
        >
          {group.items.slice(0, 3).map((skill) => (
            <span class="inline-flex items-center gap-3">
              <span
                data-preview-icon
                class="skills-icon-anchor inline-flex shrink-0"
              >
                <ToolIcon name={skill.name} />
              </span>
              {skill.name}
            </span>
          ))}
          {group.items.length > 3 && (
            <span class="font-mono text-xs text-muted">
              +{group.items.length - 3}
            </span>
          )}
        </div>
      </summary>

      <div
        id={`skills-panel-${index}`}
        role="region"
        class="skills-panel overflow-hidden"
      >
        <div class="skills-panel-inner">
          <ul class="mx-6 grid gap-3 border-t border-rule/50 pb-6 pt-6 sm:mx-8 sm:grid-cols-2 sm:pb-8">
            {group.items.map((skill, skillIndex) => (
              <li class="skills-card flex min-w-0 flex-col justify-center rounded-md border border-rule/40 bg-[#050d14]/65 px-4 py-3">
                <div class="flex items-center gap-3">
                  <span
                    {...(skillIndex < 3 ? { "data-panel-icon": "" } : {})}
                    class="skills-icon-anchor inline-flex shrink-0"
                  >
                    <ToolIcon name={skill.name} />
                  </span>
                  <span class="break-words font-mono text-sm">
                    {skill.name}
                  </span>
                </div>
                {relatedProjects(skill).map((project) => (
                  <a
                    class="mt-1 inline-flex min-h-11 items-center gap-2 text-xs text-[#9dc7df] underline hover:text-paper"
                    href={project.url || `#project-${project.id}`}
                  >
                    <span class="sr-only">{projectLabel} </span>
                    {project.title}
                    <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </details>
  ))}
</div>

<style>
  /* Replaces @vueuse/motion hover binding on skill cards. */
  .skills-card {
    transition:
      translate 160ms ease,
      border-color 160ms ease;
  }

  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .skills-card:hover {
      translate: 0 -2px;
      border-color: rgb(157 199 223 / 0.6);
    }
  }
</style>
