---
import type { PortfolioContent } from "../data/portfolio";

interface Props {
  content: PortfolioContent["openSource"]["security"];
  headingLevel?: "h2" | "h3";
}

const { content, headingLevel: Heading = "h3" } = Astro.props;
const EntryHeading = Heading === "h2" ? "h3" : "h4";
---

<section id="security" aria-labelledby="security-title">
  <Heading id="security-title" class="subsection-title">
    {content.heading}
  </Heading>
  <p class="body-copy mt-4 max-w-[72ch] text-muted">{content.intro}</p>
  <ul class="mt-8 grid gap-6 lg:grid-cols-2">
    {content.entries.map((entry) => (
      <li class="flex min-w-0 flex-col rounded-2xl border border-rule/70 bg-linear-to-br from-[#102637]/50 to-transparent p-6 sm:p-8">
        <p class="eyebrow text-[#a8c8be]">{entry.focus}</p>
        <EntryHeading class="card-title mt-3">{entry.name}</EntryHeading>
        <p class="mt-2 text-sm leading-relaxed text-[#abd1ed]">{entry.role}</p>
        <p class="body-copy mt-5 text-muted">{entry.description}</p>
        <p class="body-copy mt-4 text-muted">{entry.detail}</p>
        <div class="mt-auto pt-6">
          <p class="break-words text-xs text-muted">{entry.reference}</p>
          <a
            class="text-link mt-2 inline-flex min-h-11 items-center gap-2 text-sm underline decoration-[#9dc7df]/40 hover:decoration-[#9dc7df]"
            href={entry.link.url}
            target="_blank"
            rel="noreferrer"
          >
            {entry.link.label}
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </li>
    ))}
  </ul>
</section>
