---
import { resolveToolIcon } from "../lib/tool-icons";

interface Props {
  name: string;
  className?: string;
}

const { name, className = "h-6 w-6 shrink-0" } = Astro.props;
// Separate assets let native lazy loading skip offscreen and closed skill groups.
const { image, glyph } = resolveToolIcon(name);
---

{image ? (
  <img
    src={image}
    alt=""
    width="24"
    height="24"
    loading="lazy"
    decoding="async"
    fetchpriority="low"
    class={`${className} object-contain`}
    aria-hidden="true"
    data-tool-icon
  />
) : (
  <svg
    class={className}
    style="color: #9dc7df"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    data-tool-icon
  >
    <path d={glyph} />
  </svg>
)}
