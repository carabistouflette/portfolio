---
import { resolveToolIcon } from "../lib/tool-icons";

interface Props {
  name: string;
  className?: string;
}

const { name, className = "h-6 w-6 shrink-0" } = Astro.props;
const { spriteId, image, glyph, color } = resolveToolIcon(name);
---

{image ? (
  <img
    src={`/tool-icons/${image}.webp`}
    alt=""
    width="24"
    height="24"
    class={`${className} object-contain`}
    aria-hidden="true"
    data-tool-icon
  />
) : spriteId ? (
  <svg
    class={className}
    style={`color: ${color}`}
    viewBox="0 0 24 24"
    fill="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    data-tool-icon
  >
    <use href={`/icons.svg#${spriteId}`} />
  </svg>
) : (
  <svg
    class={className}
    style={`color: ${color}`}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    data-tool-icon
  >
    <path d={glyph} />
  </svg>
)}
