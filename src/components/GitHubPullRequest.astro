---
import type { PortfolioContent } from "../data/portfolio";
import type { GitHubPullRequest } from "../lib/github";
interface Props {
  request?: GitHubPullRequest;
  copy: PortfolioContent["openSource"]["github"];
  dateFormat: Intl.DateTimeFormat;
}
const { request, copy, dateFormat } = Astro.props;
const eventDate = request?.mergedAt ?? request?.updatedAt;
---
<li class="border-t border-rule/60 py-8 md:py-10">
  <article>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-3 text-xs leading-relaxed">
      <a data-pr-repository class="inline-flex min-h-11 items-center font-mono text-[#9dc7df] underline" href={request ? `https://github.com/${request.repository}` : undefined}>{request?.repository}</a>
      <span data-pr-number class="font-mono text-muted">{request ? `#${request.number}` : ""}</span>
      <span data-pr-state={request?.state ?? ""} class="border-l border-rule pl-4 text-muted data-[pr-state=merged]:text-[#bbadec] data-[pr-state=open]:text-[#a4d4c4] data-[pr-state=draft]:text-[#d6c695]">{request ? copy.states[request.state] : ""}</span>
      <span data-pr-relationship class="text-muted">{request ? copy.relationships[request.relationship] : ""}</span>
    </div>
    <h4 class="mt-4 max-w-[60ch] text-xl leading-relaxed tracking-tight md:text-2xl"><a data-pr-title href={request?.url}>{request?.title}</a></h4>
    <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-xs leading-relaxed text-muted">
      <p>{copy.createdLabel} <time data-pr-created datetime={request?.createdAt}>{request ? dateFormat.format(new Date(request.createdAt)) : ""}</time></p>
      <p><span data-pr-event-label>{request?.mergedAt ? copy.mergedLabel : copy.updatedLabel}</span> <time data-pr-event datetime={eventDate}>{eventDate ? dateFormat.format(new Date(eventDate)) : ""}</time></p>
    </div>
    <div class="mt-5 flex flex-wrap gap-x-7 gap-y-2 text-sm">
      <a data-pr-discussion class="text-link underline" href={request?.url}>{copy.discussionLabel}</a>
      <a data-pr-files class="text-link underline" href={request ? `${request.url}/files` : undefined}>{copy.filesLabel}</a>
      <a data-pr-commits class="text-link underline" href={request ? `${request.url}/commits` : undefined}>{copy.commitsLabel}</a>
    </div>
  </article>
</li>
