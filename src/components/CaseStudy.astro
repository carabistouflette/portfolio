---
import CaseStudyDemo from "./CaseStudyDemo.astro";
import EvidenceFigure from "./EvidenceFigure.astro";
import PaginationEvidence from "./PaginationEvidence.astro";
import { destinations } from "../data/portfolio";
import type {
  CaseStudy as CaseStudyData,
  CaseStudyId,
  Locale,
} from "../data/portfolio";

interface Props {
  locale: Locale;
  projectId: CaseStudyId;
  study: CaseStudyData;
}

const { locale, projectId, study } = Astro.props;
const hasRole = Boolean(study.role && study.roleLabel);
const fr = locale === "fr";
const contactHref = `${destinations.email}?subject=${encodeURIComponent(fr ? `Échange à propos de ${study.title}` : `Discussing ${study.title}`)}`;
const screenshots = study.screenshots;
const media = screenshots?.items ?? [study.figure];
// Match global.css's capped shell and gutters, plus this gallery's 1.5rem
// column gap and each image link's 2px border. Reserve the full hover scale
// (1.02) in every source selection, including browsers without sizes="auto".
const gallerySlot = (shell: string, gutters: string, columns: number) =>
  `calc(((${shell} - ${gutters}${columns === 2 ? " - 1.5rem" : ""}) / ${columns} - 2px) * 1.02)`;
const galleryColumns = media.length > 1 ? 2 : 1;
const evidenceSizes = [
  `(min-width: 100rem) ${gallerySlot("min(calc(60vw + 28rem), 122rem)", "6rem", galleryColumns)}`,
  `(min-width: 48rem) ${gallerySlot("min(100vw, 88rem)", "6rem", galleryColumns)}`,
  gallerySlot("100vw", "3rem", 1),
].join(", ");
const homePath = locale === "fr" ? "/" : "/en/";
const counterpartPath =
  locale === "fr" ? `/en/projects/${projectId}/` : `/projets/${projectId}/`;
---

<main id="main">
  <article class="content-shell pb-20 pt-10 sm:pb-28 sm:pt-16">
    <header class="@container max-w-5xl">
      <a class="text-link text-sm text-muted underline" href={homePath}>
        <span class="mr-2" aria-hidden="true">
          ←
        </span>
        {study.homeLabel}
      </a>
      <p class="eyebrow mt-12 mb-4">{study.kicker}</p>
      {study.relatedProject && (
        <a
          class="text-link mb-6 text-sm text-[#abd1ed] underline underline-offset-4"
          href={study.relatedProject.href}
        >
          {study.relatedProject.label}
          <span class="ml-2" aria-hidden="true">
            ↗
          </span>
        </a>
      )}
      <h1
        id="case-study-title"
        class:list={[
          "page-title max-w-4xl text-balance",
          {
            "case-title-long": study.title
              .split(/\s+/)
              .some((word) => word.length > 10),
          },
        ]}
      >
        {study.title}
      </h1>
      <h2 class="subsection-title mt-8 max-w-4xl text-balance">
        {study.question}
      </h2>
      <p class="lead-copy mt-7 max-w-3xl text-muted text-pretty">
        {study.summary}
      </p>
      {hasRole && (
        <section
          class="mt-7 max-w-3xl border-l border-rule pl-5"
          aria-labelledby="case-role-label"
        >
          <h2 id="case-role-label" class="eyebrow">
            {study.roleLabel}
          </h2>
          <p class="body-copy mt-2">{study.role}</p>
        </section>
      )}
      <details class="mt-7 max-w-3xl border-y border-rule py-3">
        <summary class="text-link cursor-pointer text-sm">
          {study.atGlance.label}
        </summary>
        <dl class="mt-4 grid gap-x-8 gap-y-4 pb-2 sm:grid-cols-2">
          {study.atGlance.entries.map((entry) => (
            <div class="min-w-0">
              <dt class="eyebrow">{entry.label}</dt>
              <dd class="mt-1 text-sm leading-relaxed">{entry.value}</dd>
            </div>
          ))}
        </dl>
      </details>
      <nav
        class="mt-6 flex flex-wrap gap-x-8 gap-y-3"
        aria-label={fr ? "Dans ce dossier" : "On this page"}
      >
        <a
          class="text-link text-sm underline"
          href={study.demonstration ? "#case-demo-title" : "#case-media-title"}
        >
          {study.demonstration
            ? fr
              ? "Voir la démonstration"
              : "See the demonstration"
            : fr
              ? "Voir le projet"
              : "See the project"}{" "}
          <span aria-hidden="true">↓</span>
        </a>
        <a class="text-link text-sm underline" href="#case-sections">
          {study.technicalLabel} <span aria-hidden="true">↓</span>
        </a>
      </nav>
    </header>

    {study.demonstration && (
      <CaseStudyDemo demonstration={study.demonstration} locale={locale} />
    )}

    <section
      data-motion-reveal
      class="mt-14 sm:mt-20"
      aria-labelledby="case-media-title"
    >
      <h2 id="case-media-title" class="subsection-title mb-6">
        {study.mediaLabel}
      </h2>
      <div
        class:list={[
          "grid gap-8",
          { "md:grid-cols-2 md:gap-x-6 md:gap-y-10": media.length > 1 },
        ]}
      >
        {media.map((item) => (
          <EvidenceFigure
            locale={locale}
            projectId={projectId}
            sizes={evidenceSizes}
            compact={"preview" in item}
            image={"preview" in item ? item : undefined}
            openLabel={screenshots?.openLabel}
          />
        ))}
      </div>
    </section>

    <section
      id="case-sections"
      class="mt-16 sm:mt-24"
      aria-labelledby="case-decisions-title"
    >
      <h2 id="case-decisions-title" class="subsection-title mb-6">
        {study.technicalLabel}
      </h2>
      <ol class="m-0 list-none p-0">
        {study.sections.map((section, index) => (
          <li
            data-motion-reveal
            class="grid gap-7 border-t border-rule py-9 md:grid-cols-[minmax(10rem,0.55fr)_minmax(0,1.45fr)] md:gap-12 md:py-12"
            id={`decision-${index + 1}`}
          >
            <h3 class="card-title text-muted">{section.heading}</h3>
            <div class="max-w-3xl">
              {section.paragraphs.map((paragraph) => (
                <p class="body-copy mb-5 text-pretty last:mb-0">{paragraph}</p>
              ))}
              {section.points && (
                <dl class="mt-8 grid gap-5 border-l border-rule pl-5 sm:grid-cols-2 sm:gap-x-8">
                  {section.points.map((point) => (
                    <div>
                      <dt class="text-sm font-medium">{point.label}</dt>
                      <dd class="body-copy mt-1 text-muted">{point.detail}</dd>
                    </div>
                  ))}
                </dl>
              )}
              {index === 1 && study.pagination && (
                <PaginationEvidence content={study.pagination} />
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>

    {study.sources && (
      <div
        data-motion-reveal
        class="mt-10 max-w-3xl border-t border-rule pt-10"
      >
        <section aria-labelledby="case-sources-title">
          <h2 id="case-sources-title" class="subsection-title">
            {study.sources.label}
          </h2>
          <ul class="mt-5 m-0 grid list-none gap-4">
            {study.sources.entries.map((source) => (
              <li class="border-b border-rule/60 pb-4 last:border-0">
                {source.href ? (
                  <a
                    class="text-link min-h-0 text-sm underline"
                    href={source.href}
                    target="_blank"
                    rel="noreferrer"
                  >
                    {source.label}
                    <span class="ml-2 text-muted" aria-hidden="true">
                      ↗
                    </span>
                  </a>
                ) : (
                  <span class="text-sm">{source.label}</span>
                )}
                {source.detail && (
                  <p class="body-copy mt-1 text-muted">{source.detail}</p>
                )}
              </li>
            ))}
          </ul>
        </section>
      </div>
    )}

    <section
      class="mt-16 border-t border-rule pt-8 sm:mt-20"
      aria-labelledby="case-contact-title"
    >
      <h2 id="case-contact-title" class="subsection-title">
        {fr ? "Ce projet vous intéresse ?" : "Interested in this project?"}
      </h2>
      <p class="body-copy mt-3 max-w-2xl text-muted">
        {fr
          ? "Une question sur ce travail ou une proposition de stage ? Écrivez-moi."
          : "Have a question about this work or an internship opportunity? Get in touch."}
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a
          class="inline-flex min-h-12 items-center bg-paper px-5 text-sm font-medium text-ink hover:bg-[#abd1ed] focus-visible:outline-2 focus-visible:outline-paper focus-visible:outline-offset-4"
          href={contactHref}
        >
          {fr ? "Discuter de ce projet" : "Discuss this project"}
        </a>
        <a class="text-link text-sm underline" href={destinations.cv} download>
          {fr ? "Télécharger mon CV" : "Download my CV"}
        </a>
      </div>
    </section>

    <footer
      data-motion-reveal
      class="mt-16 flex flex-wrap items-center justify-between gap-x-8 gap-y-4 border-t border-rule pt-6 text-sm"
    >
      <a class="text-link min-h-0 underline" href={homePath}>
        <span class="mr-2" aria-hidden="true">
          ←
        </span>
        {study.homeLabel}
      </a>
      <a class="text-link min-h-0 underline" href={counterpartPath}>
        {study.counterpartLabel}
        <span class="ml-2" aria-hidden="true">
          →
        </span>
      </a>
    </footer>
  </article>
</main>

<style>
  .case-title-long {
    font-size: min(clamp(3rem, 6vw, 5rem), 12cqi);
  }
</style>
