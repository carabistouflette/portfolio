---
import type { Locale } from "../data/portfolio";

interface Props {
  kind: "meddatatrace" | "encrypted-voting" | "justsyncit";
  locale: Locale;
}
const { kind, locale } = Astro.props;
const fr = locale === "fr";
---

<!-- Métaphores illustrées, sans données ni résultats réels. -->
<div class:list={["project-scene", `scene-${kind}`]} aria-hidden="true">
  {kind === "meddatatrace" && (
    <div class="research-desk">
      <div class="paper-underlay"></div>
      <div class="research-paper">
        <div class="paper-running-head">
          HealthGraphBench <span>01</span>
        </div>
        <p class="paper-title">
          {fr ? "Évaluer les graphes." : "Evaluate the graphs."}
        </p>
        <div class="paper-columns">
          <div>
            <span class="printed-line long"></span>
            <span class="printed-line"></span>
            <span class="annotated-passage">data · models · time</span>
            <span class="printed-line long"></span>
            <span class="printed-line short"></span>
            <span class="printed-line"></span>
          </div>
          <div>
            <span class="printed-line"></span>
            <span class="printed-line long"></span>
            <span class="printed-line short"></span>
            <span class="printed-line long"></span>
            <span class="printed-line"></span>
            <span class="printed-line short"></span>
          </div>
        </div>
        <div class="paper-footnote">
          [1] {fr ? "Un graphe, quel gain ?" : "What does a graph add?"}
        </div>
      </div>
      <div class="margin-note">
        {fr ? "gain ?" : "gain?"}
        <svg viewBox="0 0 95 65" fill="none">
          <path d="M86 6C77 38 44 49 8 44m0 0 12-8M8 44l12 9" />
        </svg>
      </div>
      <div class="paper-clip"></div>
      <div class="pencil">
        <span></span>
      </div>
    </div>
  )}
  {kind === "justsyncit" && (
    <div class="archive-room">
      <div class="archive-cabinet">
        <div class="cabinet-top">
          <span>JUSTSYNCIT</span>
          <span>J / 03</span>
        </div>
        {["003", "002", "001"].map((version, i) => (
          <div class="archive-drawer" style={`--drawer: ${i}`}>
            <div class="drawer-interior">
              <span class="archive-folder folder-back"></span>
              <span class="archive-folder folder-front">
                <span>{["notes/", "src/", "photos/"][i]}</span>
              </span>
            </div>
            <div class="drawer-front">
              <span class="drawer-number">{version}</span>
              <span class="drawer-label">
                {fr ? "instantané" : "snapshot"}
                <small>{["18:42", "12:08", "09:31"][i]}</small>
              </span>
              <span class="drawer-handle"></span>
            </div>
          </div>
        ))}
        <div class="cabinet-base"></div>
      </div>
      <span class="archive-shadow"></span>
    </div>
  )}
  {kind === "encrypted-voting" && (
    <div class="polling-booth">
      <div class="booth-back">
        <div class="ballot-receipt">
          <span class="receipt-heading">EL GAMAL</span>
          <span class="receipt-rule"></span>
          <span class="receipt-formula">
            g<sup>r</sup>
          </span>
          <span class="receipt-formula">
            m · h<sup>r</sup>
          </span>
          <span class="receipt-rule"></span>
        </div>
      </div>
      <div class="curtain-rail"></div>
      <div class="curtain curtain-left"></div>
      <div class="curtain curtain-right"></div>
      <span class="booth-foot foot-left"></span>
      <span class="booth-foot foot-right"></span>
    </div>
  )}
</div>

<style>
  .project-scene {
    position: relative;
    flex-shrink: 0;
    height: 15rem;
    margin: -0.25rem -0.5rem 1.5rem;
    isolation: isolate;
  }

  /* Une feuille relue, avec son annotation en marge. */
  .research-desk {
    position: relative;
    width: min(100%, 23rem);
    height: 100%;
    margin-inline: auto;
    perspective: 800px;
  }
  .research-paper,
  .paper-underlay {
    position: absolute;
    top: 1.5rem;
    left: 9%;
    width: 77%;
    height: 11.5rem;
    background: #d8d5c6;
    box-shadow:
      1px 2px 2px #0005,
      5px 12px 18px #0003;
  }
  .paper-underlay {
    transform: rotate(-8deg) translate(-4px, 6px);
    background: #a4b5b2;
  }
  .research-paper {
    padding: 1rem 1.15rem;
    color: #293837;
    transform: rotate(-3deg);
    background-image: repeating-linear-gradient(
      0deg,
      #404f4210 0 1px,
      transparent 1px 3px
    );
  }
  .paper-running-head {
    display: flex;
    justify-content: space-between;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid #59635b6b;
    font: 0.5rem monospace;
    letter-spacing: 0.05em;
  }
  .paper-title {
    margin-block: 0.65rem 0.75rem;
    font:
      italic 1.2rem Georgia,
      serif;
    letter-spacing: -0.04em;
  }
  .paper-columns {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 0.7rem;
  }
  .printed-line {
    display: block;
    width: 87%;
    height: 2px;
    margin-block: 5px;
    background: repeating-linear-gradient(
      90deg,
      #4a565b8c 0 9px,
      transparent 9px 11px,
      #4a565b8c 11px 17px
    );
  }
  .printed-line.long {
    width: 100%;
  }
  .printed-line.short {
    width: 62%;
  }
  .annotated-passage {
    position: relative;
    display: inline-block;
    white-space: nowrap;
    font:
      0.45rem Georgia,
      serif;
    z-index: 0;
  }
  .annotated-passage::before {
    content: "";
    position: absolute;
    inset: -2px -3px;
    z-index: -1;
    background: #b7bf7466;
    transform: rotate(-1deg) scaleX(0.12);
    transform-origin: left;
  }
  .paper-footnote {
    margin-top: 0.8rem;
    padding-top: 0.4rem;
    border-top: 1px solid #59635b4a;
    font:
      italic 0.48rem Georgia,
      serif;
  }
  .margin-note {
    position: absolute;
    top: 3.8rem;
    right: 0;
    width: 5rem;
    color: #9fb9b5;
    font:
      italic 1.1rem "Comic Sans MS",
      "Bradley Hand",
      cursive;
    transform: rotate(8deg);
  }
  .margin-note svg {
    display: block;
    width: 4rem;
    height: 3rem;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
  }
  .paper-clip {
    position: absolute;
    top: 1.1rem;
    left: 24%;
    width: 0.7rem;
    height: 2rem;
    border: 2px solid #9eaba4;
    border-radius: 0.5rem;
    transform: rotate(-3deg);
    box-shadow: 1px 1px #182a2d;
  }
  .paper-clip::after {
    content: "";
    position: absolute;
    inset: 3px 2px -3px;
    border: 1px solid #6d827e;
    border-top: none;
    border-radius: 0 0 5px 5px;
  }
  .pencil {
    position: absolute;
    bottom: 0.5rem;
    left: 15%;
    width: 75%;
    height: 0.4rem;
    background: linear-gradient(#979b6e 30%, #5b6247 30% 65%, #b6b48a 65%);
    transform: rotate(-13deg);
    box-shadow: 1px 3px 3px #0006;
  }
  .pencil::before {
    content: "";
    position: absolute;
    left: -1.1rem;
    border-right: 1.1rem solid #bfa783;
    border-block: 0.2rem solid transparent;
  }
  .pencil::after {
    content: "";
    position: absolute;
    left: -1.1rem;
    border-right: 0.3rem solid #273337;
    border-block: 0.2rem solid transparent;
  }

  /* Un meuble à archives : chaque tiroir conserve un état. */
  .archive-room {
    position: relative;
    height: 100%;
    perspective: 850px;
  }
  .archive-cabinet {
    position: relative;
    top: 0.3rem;
    width: 72%;
    max-width: 17rem;
    margin-inline: auto;
    transform: rotateY(-12deg) rotateX(5deg) rotate(-3deg);
    transform-style: preserve-3d;
    z-index: 1;
  }
  .cabinet-top {
    display: flex;
    justify-content: space-between;
    padding: 0.65rem 0.7rem;
    background: #4b6565;
    border: 1px solid #78908b;
    border-bottom: 3px solid #172c2e;
    color: #b4c6ba;
    font: 0.5rem monospace;
    letter-spacing: 0.12em;
  }
  .archive-drawer {
    position: relative;
    height: 3.5rem;
    background: #0e1b1d;
    border-inline: 5px solid #4e6665;
    border-bottom: 4px solid #4e6665;
    transform-style: preserve-3d;
  }
  .drawer-front {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-start;
    padding: 0.45rem 0.6rem;
    background: linear-gradient(105deg, #56726f, #3a5555 72%);
    border: 1px solid #7b939066;
    box-shadow:
      inset 0 -4px 5px #142b2b66,
      0 3px 3px #0007;
  }
  .drawer-number {
    color: #9cb2a8;
    font: 0.55rem monospace;
  }
  .drawer-label {
    margin-inline: auto;
    padding: 0.12rem 0.7rem;
    background: #c7c7ae;
    color: #46514a;
    box-shadow:
      0 0 0 2px #283d3c,
      0 0 0 3px #75918a;
    font: 0.5rem monospace;
  }
  .drawer-label small {
    margin-left: 0.5rem;
    font-size: 0.4rem;
  }
  .drawer-handle {
    position: absolute;
    bottom: 0.5rem;
    left: 37%;
    width: 26%;
    height: 0.35rem;
    border: 1px solid #b0bcb0;
    border-top-width: 2px;
    background: #314746;
    box-shadow: 0 2px 1px #122629;
  }
  .drawer-interior {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .archive-folder {
    position: absolute;
    inset: 0.9rem 9% -1rem;
    background: #a8956c;
    border: 1px solid #c6b78d;
    border-radius: 1px;
  }
  .archive-folder::before {
    content: "";
    position: absolute;
    top: -0.35rem;
    left: 5%;
    width: 35%;
    height: 0.35rem;
    background: inherit;
    border-radius: 2px 2px 0 0;
  }
  .folder-back {
    transform: rotate(2deg);
    background: #777f68;
  }
  .folder-front {
    transform: translateY(0.55rem) rotate(-2deg);
  }
  .folder-front span {
    display: block;
    padding: 0.3rem 0.5rem;
    color: #4b4c3d;
    font: 0.5rem monospace;
  }
  .cabinet-base {
    height: 0.6rem;
    background: #253d3e;
    border-top: 1px solid #78918b;
    box-shadow: 0 5px #122628;
  }
  .archive-shadow {
    position: absolute;
    bottom: 0.4rem;
    left: 9%;
    width: 80%;
    height: 1.3rem;
    background: radial-gradient(ellipse, #0008, transparent 70%);
    transform: rotate(-3deg);
  }

  /* Un isoloir en tissu, plutôt qu'un cadenas ou un badge. */
  .polling-booth {
    position: relative;
    width: 82%;
    max-width: 19rem;
    height: 14rem;
    margin: 0.5rem auto 0;
    perspective: 700px;
  }
  .booth-back {
    position: absolute;
    inset: 0.7rem 3% 1.5rem;
    background: #171711;
    box-shadow: inset 0 5px 15px #0009;
  }
  .curtain-rail {
    position: absolute;
    top: 0;
    left: -3%;
    width: 106%;
    height: 0.3rem;
    background: linear-gradient(#b5b3a0, #656957 60%, #393d34);
    box-shadow: 0 2px 3px #0007;
    z-index: 3;
  }
  .curtain {
    position: absolute;
    top: 0.3rem;
    bottom: 1.2rem;
    width: 50%;
    background: repeating-linear-gradient(
      90deg,
      #665b42 0%,
      #827153 7%,
      #4b4434 14%,
      #978262 21%,
      #6d5d43 27%,
      #3e3b2e 34%
    );
    box-shadow: 3px 3px 8px #0007;
    transform-origin: top;
    z-index: 2;
    clip-path: polygon(
      0 0,
      100% 0,
      100% 98%,
      85% 100%,
      67% 98%,
      50% 100%,
      33% 98%,
      17% 100%,
      0 98%
    );
  }
  .curtain::after {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      #eee3b00c 0 1px,
      transparent 1px 3px
    );
  }
  .curtain-left {
    left: 0;
    transform: scaleX(0.88) rotate(1deg);
    transform-origin: left top;
  }
  .curtain-right {
    right: 0;
    transform: scaleX(0.88) rotate(-1deg);
    transform-origin: right top;
    background-position: 13px 0;
  }
  .booth-foot {
    position: absolute;
    top: -0.2rem;
    bottom: 0;
    width: 0.3rem;
    background: linear-gradient(90deg, #535b50, #a0a58e, #52584c);
  }
  .foot-left {
    left: -1%;
  }
  .foot-right {
    right: -1%;
  }
  .ballot-receipt {
    position: absolute;
    top: 1.2rem;
    left: 28%;
    width: 44%;
    padding: 0.8rem 0.65rem;
    color: #3b3e31;
    background: #d6d0b9;
    transform: rotate(-7deg);
    box-shadow: 1px 5px 8px #0008;
    clip-path: polygon(
      0 0,
      100% 0,
      100% 100%,
      90% 97%,
      80% 100%,
      70% 97%,
      60% 100%,
      50% 97%,
      40% 100%,
      30% 97%,
      20% 100%,
      10% 97%,
      0 100%
    );
  }
  .receipt-heading {
    display: block;
    font: 0.55rem monospace;
    text-align: center;
    letter-spacing: 0.12em;
  }
  .receipt-rule {
    display: block;
    margin-block: 0.45rem;
    border-top: 1px dashed #6d715d;
  }
  .receipt-formula {
    display: block;
    text-align: center;
    font:
      italic 1.5rem Georgia,
      serif;
    line-height: 1.5;
  }
  .receipt-formula sup {
    font-size: 0.7rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .research-paper,
    .paper-underlay,
    .pencil,
    .archive-cabinet,
    .drawer-front,
    .archive-folder,
    .curtain,
    .ballot-receipt {
      transition: transform 500ms cubic-bezier(0.2, 0.7, 0.25, 1);
    }
    .annotated-passage::before {
      transition: transform 600ms ease;
    }
    :global(.tile-surface:is(:hover, :focus-visible)) .research-paper {
      transform: translateY(-5px) rotate(0deg);
    }
    :global(.tile-surface:is(:hover, :focus-visible)) .paper-underlay {
      transform: rotate(-11deg) translate(-7px, 7px);
    }
    :global(.tile-surface:is(:hover, :focus-visible))
      .annotated-passage::before {
      transform: rotate(-1deg) scaleX(1);
    }
    :global(.tile-surface:is(:hover, :focus-visible)) .pencil {
      transform: translate(5px, 4px) rotate(-10deg);
    }
    :global(.tile-surface:is(:hover, :focus-visible)) .archive-cabinet {
      transform: rotateY(-5deg) rotateX(2deg) rotate(-1deg);
    }
    .archive-drawer:hover .drawer-front,
    :global(.tile-surface:focus-visible)
      .archive-drawer:nth-child(2)
      .drawer-front {
      transform: translateY(1.15rem) translateZ(18px);
    }
    .archive-drawer:hover .archive-folder,
    :global(.tile-surface:focus-visible)
      .archive-drawer:nth-child(2)
      .archive-folder {
      transform: translateY(-0.4rem) rotate(-1deg);
    }
    :global(.tile-surface:is(:hover, :focus-visible)) .curtain-left {
      transform: scaleX(0.36) rotate(2deg);
    }
    :global(.tile-surface:is(:hover, :focus-visible)) .curtain-right {
      transform: scaleX(0.36) rotate(-2deg);
    }
    :global(.tile-surface:is(:hover, :focus-visible)) .ballot-receipt {
      transform: translateY(-3px) rotate(2deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .annotated-passage::before {
      transform: none;
    }
    .curtain-left,
    .curtain-right {
      transform: scaleX(0.5);
    }
  }
  @media (max-width: 24rem) {
    .research-paper {
      padding-inline: 0.8rem;
    }
    .paper-title {
      font-size: 1rem;
    }
    .margin-note {
      font-size: 0.9rem;
    }
    .drawer-label {
      padding-inline: 0.35rem;
    }
  }
</style>
