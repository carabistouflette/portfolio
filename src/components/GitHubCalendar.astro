---
import type { Locale, PortfolioContent } from "../data/portfolio";
import type { GitHubDay, GitHubSnapshot } from "../lib/github";
import { getCalendarStats } from "../lib/github";

interface Props {
  calendar: GitHubSnapshot["calendar"];
  locale: Locale;
  copy: PortfolioContent["openSource"]["github"]["calendar"];
  preview?: boolean;
}

const { calendar, locale, copy, preview = false } = Astro.props;
const DayTag = preview ? "span" : "a";
const profileUrl = "https://github.com/carabistouflette";
const dateFormat = new Intl.DateTimeFormat(locale, {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
const monthFormat = new Intl.DateTimeFormat(locale, {
  month: "short",
  timeZone: "UTC",
});
const weekdayFormat = new Intl.DateTimeFormat(locale, {
  weekday: "short",
  timeZone: "UTC",
});

const toDate = (date: string): Date => new Date(`${date}T00:00:00Z`);
const toKey = (date: Date): string => date.toISOString().slice(0, 10);
const addDays = (date: Date, amount: number): Date => {
  const next = new Date(date);
  next.setUTCDate(next.getUTCDate() + amount);
  return next;
};
const startOfWeek = (date: Date): Date => addDays(date, -date.getUTCDay());
const dayMap = new Map(calendar.days.map((day) => [day.date, day]));
const fromDate = toDate(calendar.from);
const toDateValue = toDate(calendar.to);
const weekStart = startOfWeek(fromDate);
const weekCount =
  Math.floor((toDateValue.getTime() - weekStart.getTime()) / 86_400_000 / 7) +
  1;
const weeks = Array.from({ length: Math.max(1, weekCount) }, (_, weekIndex) =>
  Array.from({ length: 7 }, (_, weekdayIndex) => {
    const date = addDays(weekStart, weekIndex * 7 + weekdayIndex);
    const key = toKey(date);
    const day =
      date >= fromDate && date <= toDateValue ? dayMap.get(key) : undefined;
    return { date, key, day };
  }),
);
const weekdayLabels = Array.from({ length: 7 }, (_, index) =>
  weekdayFormat.format(new Date(Date.UTC(2023, 0, 1 + index))),
);
const monthMarkers = Array.from(
  { length: Math.max(1, weekCount) },
  (_, weekIndex) => {
    const date = addDays(weekStart, weekIndex * 7);
    const month = monthFormat.format(date);
    const previous =
      weekIndex === 0
        ? ""
        : monthFormat.format(addDays(weekStart, (weekIndex - 1) * 7));
    return month !== previous ? { label: month, column: weekIndex + 2 } : null;
  },
).filter(
  (marker): marker is { label: string; column: number } => marker !== null,
);
const stats = getCalendarStats(calendar);
const dayHref = (date: string): string =>
  `${profileUrl}?tab=overview&from=${date}&to=${date}`;
const dayLabel = (day: GitHubDay): string => {
  const date = dateFormat.format(toDate(day.date));
  const template =
    day.count === 0
      ? copy.zeroDayLabel
      : day.count === 1
        ? copy.daySingular
        : copy.dayPlural;
  return template
    .replaceAll("{date}", date)
    .replaceAll("{count}", String(day.count));
};
const levelClasses: Record<GitHubDay["level"], string> = {
  0: "bg-sky-950/70",
  1: "bg-sky-800/80",
  2: "bg-sky-600/90",
  3: "bg-sky-400",
  4: "bg-sky-200",
};
const gridTemplate = `grid-template-columns: 2.75rem repeat(${Math.max(1, weekCount)}, minmax(1.15rem, 1fr));`;
---

<section class="min-w-0" aria-labelledby="github-calendar-title">
  <header class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2 border-t border-rule/60 pt-8">
    <h2 id="github-calendar-title" class="subsection-title">
      {copy.heading}
    </h2>
    <p class="text-xs text-muted">
      <span class="font-display text-xl text-paper">
        {stats.totalContributions.toLocaleString(locale)}
      </span>{" "}
      {copy.totalLabel}
    </p>
  </header>

  <div
    class:list={[
      "mt-6 min-w-0 pb-3",
      preview ? "overflow-x-clip" : "overflow-x-auto",
    ]}
  >
    <div class="min-w-[52rem]">
      <div class="grid gap-x-1" aria-hidden="true" style={gridTemplate}>
        <div></div>
        {monthMarkers.map((marker) => (
          <span
            class="truncate pb-1 text-[0.68rem] text-muted"
            style={`grid-row: 1; grid-column: ${marker.column} / span ${Math.min(4, weekCount - marker.column + 2)};`}
          >
            {marker.label}
          </span>
        ))}
      </div>
      <div class="grid gap-x-1 gap-y-1" style={gridTemplate}>
        {weekdayLabels.map((weekday, weekdayIndex) => (
          <div class="contents">
            <span
              class="flex items-center text-[0.68rem] text-muted"
              aria-hidden="true"
            >
              {weekday}
            </span>
            {weeks.map((week) => {
              const cell = week[weekdayIndex];
              return cell.day ? (
                <DayTag
                  class:list={[
                    "github-calendar-day",
                    "grid",
                    "min-h-5",
                    "min-w-5",
                    "place-items-center",
                    "rounded-sm",
                    "text-[0.6rem]",
                    "text-ink",
                    "transition-colors",
                    "motion-reduce:transition-none",
                    "hover:ring-2",
                    "hover:ring-paper",
                    "focus-visible:z-1",
                    "focus-visible:outline-2",
                    "focus-visible:outline-paper",
                    "focus-visible:outline-offset-3",
                    levelClasses[cell.day.level],
                  ]}
                  {...(preview
                    ? { "aria-hidden": "true" }
                    : {
                        title: dayLabel(cell.day),
                        "aria-label": dayLabel(cell.day),
                      })}
                  href={preview ? undefined : dayHref(cell.day.date)}
                >
                  <span aria-hidden="true"></span>
                </DayTag>
              ) : (
                <span class="min-h-5 min-w-5" aria-hidden="true"></span>
              );
            })}
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-muted">
    <span>{copy.lessLabel}</span>
    <span class="h-3 w-3 rounded-sm bg-sky-950/70" aria-hidden="true"></span>
    <span class="h-3 w-3 rounded-sm bg-sky-800/80" aria-hidden="true"></span>
    <span class="h-3 w-3 rounded-sm bg-sky-600/90" aria-hidden="true"></span>
    <span class="h-3 w-3 rounded-sm bg-sky-400" aria-hidden="true"></span>
    <span class="h-3 w-3 rounded-sm bg-sky-200" aria-hidden="true"></span>
    <span>{copy.moreLabel}</span>
  </div>
</section>
