---
const fr = !Astro.url.pathname.startsWith("/en/");
---

<span class="disclosure-cue" aria-hidden="true">
  <span class="disclosure-cue-closed">{fr ? "Déplier" : "Expand"}</span>
  <span class="disclosure-cue-open">{fr ? "Replier" : "Collapse"}</span>
  <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
    <path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" />
  </svg>
</span>
