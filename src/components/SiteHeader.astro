---
import type { Locale, PortfolioContent } from "../data/portfolio";

interface Props {
  locale: Locale;
  content: PortfolioContent;
  homeHref: string;
  alternatePaths: { fr: string; en: string };
}

const { locale, content, homeHref, alternatePaths } = Astro.props;
---
<header class="site-header sticky top-0 z-40 border-b border-rule/70 bg-ink/90 backdrop-blur-xl" transition:name="site-header" transition:animate="none">
  <div class="header-inner content-shell">
    <a class="header-signature" href={`${homeHref}#main`} aria-label={locale === "fr" ? "Alexis Robin — accueil" : "Alexis Robin — home"}>
      <img class="header-butterfly" src="/butterflies/home.webp" alt="" width="256" height="213" decoding="async" />
    </a>
    <button class="header-menu-toggle" type="button" aria-expanded="false" aria-controls="header-menu" hidden>
      <span>Menu</span>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
        <path class="menu-open-mark" d="M4 6h16M4 12h16M4 18h16" />
        <path class="menu-close-mark" d="m6 6 12 12M6 18 18 6" />
      </svg>
    </button>
    <div id="header-menu" class="header-menu">
    <nav
      class="primary-nav"
      aria-label={content.navigation.primaryLabel}
    >
      <ul class="header-sections">
        {Object.values(content.navigation.sections).map((section) => (
          <li>
            <a
              class="header-section-link"
              href={`${homeHref}#${section.id}`}
              data-nav-link
            >{section.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <nav
      class="locale-nav flex shrink-0 items-center gap-1 text-xs sm:gap-2"
      aria-label={content.localeLabel}
    >
      <a
        class="inline-flex min-h-9 items-center justify-center px-1 text-muted no-underline hover:text-paper hover:underline focus-visible:text-paper focus-visible:underline aria-[current=page]:text-paper aria-[current=page]:underline"
        href={alternatePaths.fr}
        aria-current={locale === "fr" ? "page" : undefined}
      >{content.localeSwitch.fr}</a>
      <span class="text-rule" aria-hidden="true">/</span>
      <a
        class="inline-flex min-h-9 items-center justify-center px-1 text-muted no-underline hover:text-paper hover:underline focus-visible:text-paper focus-visible:underline aria-[current=page]:text-paper aria-[current=page]:underline"
        href={alternatePaths.en}
        aria-current={locale === "en" ? "page" : undefined}
      >{content.localeSwitch.en}</a>
    </nav>
    <button id="motion-toggle" class="motion-toggle header-motion-toggle min-h-9 cursor-pointer text-xs text-muted hover:text-paper" type="button" hidden aria-pressed="false" aria-label={content.hero.motionToggle} data-motion-on={content.hero.motionOnLabel} data-motion-off={content.hero.motionOffLabel}>{content.hero.motionOffLabel}</button>
    </div>
  </div>
</header>
<script>
  import { onPageLoad } from "../scripts/page-lifecycle";
  import "../scripts/motion-control.ts";

  onPageLoad((signal) => {
  const header = document.querySelector<HTMLElement>(".site-header");
  const toggle = header?.querySelector<HTMLButtonElement>(".header-menu-toggle");
  const menu = header?.querySelector<HTMLElement>("#header-menu");
  const mobile = window.matchMedia("(max-width: 47.999rem)");

  if (header && toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      menu.hidden = mobile.matches && !open;
    };
    const syncViewport = () => {
      if (!mobile.matches && document.activeElement === toggle) {
        header.querySelector<HTMLAnchorElement>(".header-signature")?.focus();
      } else if (mobile.matches && menu.contains(document.activeElement)) {
        toggle.focus();
      }
      setOpen(false);
    };
    toggle.hidden = false;
    header.dataset.menuReady = "";
    syncViewport();
    toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
    header.addEventListener("click", (event) => {
      if (mobile.matches && event.target instanceof Element && event.target.closest("a")) {
        const link = event.target.closest("a");
        const href = link?.getAttribute("href");
        setOpen(false);
        if (href?.startsWith("#")) {
          const target = document.getElementById(href.slice(1));
          if (target) {
            target.setAttribute("tabindex", "-1");
            target.focus({ preventScroll: true });
            target.addEventListener("blur", () => target.removeAttribute("tabindex"), { once: true });
          }
        }
      }
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    }, { signal });
    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !header.contains(event.target)) setOpen(false);
    }, { signal });
    header.addEventListener("focusout", (event) => {
      if (event.relatedTarget instanceof Node && !header.contains(event.relatedTarget)) setOpen(false);
    });
    mobile.addEventListener("change", syncViewport, { signal });
  }

  const navLinks = Array.from(document.querySelectorAll("[data-nav-link]"));
  const visibility = new Map();
  const sections = navLinks
    .map((link) => document.getElementById(link.getAttribute("href")?.slice(1) ?? ""))
    .filter((section): section is HTMLElement => section !== null);

  if (sections.length && "IntersectionObserver" in window) {
    const setActive = (id: string) => {
      navLinks.forEach((link) => {
        if (link.getAttribute("href") === `#${id}`) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => visibility.set(entry.target, entry));
        const active = [...visibility.values()]
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (active) setActive(active.target.id);
      },
      { rootMargin: "-35% 0px -55% 0px", threshold: [0, 0.2, 0.5, 1] },
    );
    signal.addEventListener("abort", () => observer.disconnect(), { once: true });

    sections.forEach((section) => observer.observe(section));
  }
  });
</script>
