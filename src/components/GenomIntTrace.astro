---
import DisclosureSummary from "./DisclosureSummary.astro";
import type { Locale } from "../data/portfolio";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const fr = locale === "fr";
const records = [
  { gene: "GBNJ3R2_2_chr13.tRNA3-LeuCAA", pangene: "PG001110" },
  { gene: "RNase_MRP", pangene: "PG000005" },
];
const capturedQuery = `MATCH (o:organism)-[:HAS_ASSEMBLY]->(a:assembly)
MATCH (a)-[:PART_OF_ASSEMBLY]->(s:sequence)
MATCH (g:gene)-[:PART_OF_SEQUENCE]->(s)
MATCH (g)-[:PART_OF_PANGENE]->(p:pangene)
WHERE o.species = $species AND p.pg_partition = 'core'
RETURN DISTINCT g.id AS gene_id, g.name AS gene_name,
  g.uniquename AS uniquename, p.pangene_id AS pangene_id
LIMIT 100`;
const steps = fr
  ? [
      {
        name: "READ_SKILL",
        title: "Lire les instructions",
        detail:
          "Deux appels : syntaxe Cypher et terminologie du graphe génomique.",
      },
      {
        name: "GET_GRAPH_SCHEMA",
        title: "Inspecter le schéma",
        detail:
          "L’agent consulte les types de nœuds et leurs relations avant de construire la requête.",
      },
      {
        name: "QUERY_NEO4J",
        title: "Obtenir les données",
        detail:
          "La capture montre la requête paramétrée et les enregistrements renvoyés par Neo4j.",
      },
    ]
  : [
      {
        name: "READ_SKILL",
        title: "Read the instructions",
        detail: "Two calls: Cypher syntax and genomic graph terminology.",
      },
      {
        name: "GET_GRAPH_SCHEMA",
        title: "Inspect the schema",
        detail:
          "The agent checks node types and relationships before constructing the query.",
      },
      {
        name: "QUERY_NEO4J",
        title: "Retrieve the records",
        detail:
          "The capture shows the parameterized query and the records returned by Neo4j.",
      },
    ];
---

<section
  id="agent-trace"
  class="agent-trace scroll-mt-24"
  tabindex="-1"
  aria-labelledby="agent-trace-title"
>
  <h3 id="agent-trace-title">
    {fr
      ? "D’une question aux données du graphe"
      : "From a question to graph records"}
  </h3>
  <p class="trace-question" lang="en">
    “What genes are in the core genome of G. boninense?”
  </p>
  <p class="trace-outcome">
    {fr
      ? "L’agent consulte le schéma, construit une requête Cypher et récupère des gènes associés à un pangène du core genome. Deux enregistrements sont visibles dans la capture."
      : "The agent inspects the schema, builds a Cypher query and retrieves genes associated with a core-genome pangene. Two records are visible in the capture."}
  </p>
  <a class="trace-source" href="#genomint-trace">
    {fr ? "Voir la capture originale" : "View the original capture"}
    <span aria-hidden="true">↗</span>
  </a>
  <details class="reading-disclosure content-disclosure trace-details">
    <DisclosureSummary>
      {fr ? "Données et requête de la session" : "Session records and query"}
    </DisclosureSummary>
    <div class="reading-disclosure-body">
      <table>
        <caption>
          {fr ? "Les deux enregistrements visibles" : "The two visible records"}
        </caption>
        <thead>
          <tr>
            <th scope="col">
              <code>gene_name</code>
            </th>
            <th scope="col">
              <code>pangene_id</code>
            </th>
          </tr>
        </thead>
        <tbody>
          {records.map((record) => (
            <tr>
              <td>
                <code>{record.gene}</code>
              </td>
              <td>
                <code>{record.pangene}</code>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <ol
        aria-label={
          fr ? "Appels d’outils de cette session" : "Tool calls in this session"
        }
      >
        {steps.map((step) => (
          <li>
            <code>{step.name}</code>
            <p>{step.detail}</p>
          </li>
        ))}
      </ol>
      <p class="trace-parameter">
        {fr ? "Requête capturée · paramètre" : "Captured query · parameter"} :
        <code>species = G. boninense</code>
      </p>
      <pre><code>{capturedQuery}</code></pre>
      <p class="trace-boundary">
        {fr
          ? "Extrait de session : ces enregistrements ne constituent pas une liste exhaustive ni une validation biologique."
          : "Session excerpt: these records are not an exhaustive list or a biological validation."}
      </p>
    </div>
  </details>
</section>
<style>
  .agent-trace {
    max-width: 72ch;
    margin-block: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }
  h3 {
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .trace-question {
    margin-block: 0.75rem;
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .trace-outcome {
    color: var(--secondary);
    font-size: 0.9375rem;
    line-height: 1.7;
  }
  .trace-source {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    margin-top: 0.5rem;
    font-size: 0.875rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .trace-details {
    margin: 0;
  }
  code {
    overflow-wrap: anywhere;
    font-size: 0.8125rem;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  caption {
    text-align: left;
    color: var(--secondary);
    font-size: 0.8125rem;
    margin-bottom: 0.5rem;
  }
  th,
  td {
    text-align: left;
    padding: 0.5rem;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }
  th {
    font-weight: 500;
  }
  th:first-child {
    width: 65%;
  }
  ol {
    display: grid;
    gap: 0.75rem;
    padding-left: 1.25rem;
    margin-block: 1.25rem;
    list-style: decimal;
  }
  ol p,
  .trace-parameter,
  .trace-boundary {
    color: var(--secondary);
    font-size: 0.8125rem;
    line-height: 1.7;
  }
  .trace-parameter {
    margin-bottom: 0.5rem;
  }
  pre {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    padding: 0.75rem;
    border: 1px solid var(--rule);
    line-height: 1.7;
  }
  .trace-boundary {
    margin-top: 0.75rem;
  }
</style>
