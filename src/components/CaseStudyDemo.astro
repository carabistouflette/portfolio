---
import type { CaseStudy, Locale } from "../data/portfolio";
interface Props {
  demonstration: NonNullable<CaseStudy["demonstration"]>;
  locale: Locale;
}
const { demonstration: demo, locale } = Astro.props;
---

<section class="mt-14 sm:mt-20" aria-labelledby="case-demo-title">
  <h2 id="case-demo-title" class="subsection-title">
    {demo.heading}
  </h2>
  <p class="body-copy mt-4 max-w-3xl text-muted">{demo.description}</p>
  {demo.video && (
    <figure class="mt-7">
      <video
        class="block h-auto w-full border border-rule bg-black"
        controls
        playsinline
        preload="none"
        poster={demo.video.poster}
        width="1108"
        height="594"
        aria-label={demo.heading}
      >
        <source src={demo.video.src} type="video/webm" />
        <track
          kind="captions"
          src={demo.video.captions}
          srclang={locale}
          label={locale === "fr" ? "Français" : "English"}
        />
        <a href={demo.video.src}>
          {locale === "fr" ? "Télécharger la vidéo" : "Download the video"}
        </a>
      </video>
      <figcaption class="mt-3 text-sm leading-relaxed text-muted">
        {demo.video.caption}
      </figcaption>
    </figure>
  )}
  {demo.output && <pre
    tabindex="0"
    aria-label={locale === "fr" ? "Sortie de l’exécution" : "Execution output"}
    class="mt-7 overflow-x-auto border-y border-rule bg-[#07121b]/60 p-5 text-sm leading-relaxed text-[#c4d8d0] sm:p-7"
  ><code>{demo.output}</code></pre>}
  <ol class="mt-7 grid list-none gap-6 p-0 md:grid-cols-3">
    {demo.steps.map((step) => (
      <li class="border-t border-rule/60 pt-4">
        <h3 class="card-title">{step.heading}</h3>
        <p class="body-copy mt-3 text-muted">{step.description}</p>
      </li>
    ))}
  </ol>
  {demo.transcript && (
    <details class="mt-6 border-t border-rule/60 pt-4">
      <summary class="text-link cursor-pointer text-sm">
        {demo.transcript.label}
      </summary>
      <p class="body-copy mt-4 max-w-3xl text-muted">{demo.transcript.text}</p>
    </details>
  )}
  {demo.download && (
    <a
      class="text-link mt-6 text-sm underline"
      href={demo.download.href}
      download
    >
      {demo.download.label}
    </a>
  )}
</section>
