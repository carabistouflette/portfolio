---
import type { CaseStudy } from "../data/portfolio";
interface Props { content: NonNullable<CaseStudy["pagination"]>; }
const { content } = Astro.props;
---
<section class="my-10 border-y border-rule py-7" aria-labelledby="pagination-heading" data-pagination>
  <h3 id="pagination-heading" class="text-xl font-medium tracking-tight">{content.heading}</h3>
  <p class="mt-3 max-w-[65ch] text-sm leading-relaxed text-muted">{content.intro}</p>
  <div class="mt-6 grid items-center gap-6 sm:grid-cols-[1fr_2fr]">
    <label class="grid gap-2 text-sm" for="segment-count">
      {content.inputLabel}
      <input id="segment-count" name="segments" type="number" min="1" max="1000000000" step="1" value="15615" disabled class="min-h-11 w-full max-w-48 border border-rule bg-ink px-3 py-2 font-mono text-paper disabled:opacity-70 focus-visible:outline-2 focus-visible:outline-paper" aria-describedby="pagination-notice" />
    </label>
    <dl class="grid grid-cols-2 gap-6" aria-live="polite" aria-atomic="true">
      <div>
        <dt class="text-xs text-muted">{content.beforeLabel}</dt>
        <dd class="mt-2"><output for="segment-count" data-before class="font-mono text-5xl tracking-tight">16</output><span class="ml-2 text-xs text-muted">{content.unit}</span></dd>
      </div>
      <div>
        <dt class="text-xs text-muted">{content.afterLabel}</dt>
        <dd class="mt-2"><output for="segment-count" data-after class="font-mono text-5xl tracking-tight">2</output><span class="ml-2 text-xs text-muted">{content.unit}</span></dd>
      </div>
    </dl>
  </div>
  <p id="pagination-notice" class="mt-5 max-w-[75ch] text-xs leading-relaxed text-muted">{content.notice}</p>
</section>
<script>
  const illustration = document.querySelector<HTMLElement>("[data-pagination]");
  const input = illustration?.querySelector<HTMLInputElement>("input");
  const before = illustration?.querySelector<HTMLOutputElement>("[data-before]");
  const after = illustration?.querySelector<HTMLOutputElement>("[data-after]");
  if (input && before && after) {
    input.disabled = false;
    const update = () => {
      const count = input.valueAsNumber;
      const valid = input.validity.valid && Number.isSafeInteger(count);
      before.value = valid ? String(Math.ceil(count / 1000)) : "—";
      after.value = valid ? String(Math.ceil(count / 10000)) : "—";
    };
    input.addEventListener("input", update);
    update();
  }
</script>
