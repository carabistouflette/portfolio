---
import { caseStudies, type CaseStudyId, type Locale } from "../data/portfolio";
interface Props { locale: Locale; projectId: CaseStudyId; compact?: boolean; }
const { locale, projectId, compact = false } = Astro.props;
const figure = caseStudies[locale][projectId].figure;
const labelId = `${projectId}-evidence-label`;
---
<figure class="evidence-figure min-w-0" aria-labelledby={labelId}>
  <p id={labelId} class="mb-4 font-mono text-xs leading-relaxed">{figure.title}</p>
  {figure.kind === "screenshot" && figure.src ? (
    <a class="block focus-visible:outline-offset-4" href={figure.src} aria-label={figure.alt}>
      <img class="block h-auto w-full bg-paper" src={figure.src} alt={figure.alt} width="1600" height="1352" loading="eager" decoding="async" />
    </a>
  ) : (
    <div class="border-y border-[#87b7dc]/30 bg-[#07121b]/70 px-5 py-7 sm:px-7 sm:py-9">
      <ol class:list={["relative grid gap-8", { "md:grid-cols-3 md:gap-10": !compact }]}>
        {(figure.nodes ?? []).map((node, index) => (
          <li class="relative flex gap-4">
            <span class="flex size-9 shrink-0 items-center justify-center rounded-full border border-[#87b7dc]/40 bg-[#102637] font-mono text-xs text-[#abd1ed]" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <div class="min-w-0 pt-1">
              <p class="text-base font-medium leading-snug text-paper">{node.title}</p>
              <p class="mt-2 text-sm leading-relaxed text-muted">{node.detail}</p>
            </div>
            {compact && index < (figure.nodes?.length ?? 0) - 1 && <span class="absolute top-11 bottom-[-1.5rem] left-[1.1rem] w-px bg-linear-to-b from-[#87b7dc]/40 to-[#87b7dc]/10" aria-hidden="true"></span>}
          </li>
        ))}
      </ol>
      {figure.optional && <p class="mt-8 border-t border-[#87b7dc]/20 pt-5 text-xs leading-relaxed text-muted"><strong class="font-medium text-[#abd1ed]">{figure.optional.title}.</strong> {figure.optional.detail}</p>}
    </div>
  )}
  <figcaption class="mt-3 text-xs leading-relaxed text-muted">
    {!compact && <span class="block">{figure.caption}</span>}
    <span class="mt-2 block">{figure.source}</span>
    {figure.src && figure.openLabel && <a class="mt-1 inline-flex min-h-11 items-center text-inherit underline" href={figure.src}>{figure.openLabel}</a>}
  </figcaption>
</figure>
