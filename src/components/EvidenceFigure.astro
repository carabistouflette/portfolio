---
import {
  caseStudies,
  type CaseStudyScreenshots,
  type CaseStudyId,
  type Locale,
} from "../data/portfolio";
interface Props {
  locale: Locale;
  projectId: CaseStudyId;
  compact?: boolean;
  image?: CaseStudyScreenshots["items"][number];
  openLabel?: string;
}
const { locale, projectId, compact = false, image, openLabel } = Astro.props;
const figure = image
  ? {
      kind: "screenshot" as const,
      title: image.title,
      alt: image.alt,
      src: image.src,
      srcset: `${image.preview} 1100w, ${image.src} ${image.width}w`,
      width: image.width,
      height: image.height,
      openLabel: `${openLabel} : ${image.title}`,
      source: "",
    }
  : caseStudies[locale][projectId].figure;
const labelId = `${projectId}-evidence-label`;
const showContext = !image && (!compact || figure.kind !== "screenshot");
const closeLabel = locale === "fr" ? "Fermer" : "Close";
const zoomAction =
  locale === "fr" ? "Zoomer dans la capture" : "Zoom into image";
const fitAction = locale === "fr" ? "Voir toute la capture" : "Fit whole image";
---

<figure
  class="evidence-figure min-w-0"
  aria-labelledby={showContext ? labelId : undefined}
>
  {showContext && (
    <p id={labelId} class="mb-4 font-mono text-xs leading-relaxed">
      {figure.title}
    </p>
  )}
  {figure.kind === "screenshot" && figure.src ? (
    <a
      class:list={[
        "block cursor-zoom-in focus-visible:outline-offset-4",
        { "group overflow-hidden border border-rule bg-paper": !!image },
      ]}
      href={figure.src}
      aria-label={figure.openLabel ?? figure.alt}
      data-evidence-open
    >
      <img
        class:list={[
          "block h-auto w-full bg-paper",
          {
            "transition-transform duration-300 group-hover:scale-[1.02] motion-reduce:transition-none":
              !!image,
          },
        ]}
        src={image?.preview ?? figure.src}
        srcset={compact ? figure.srcset : undefined}
        sizes={
          compact
            ? "(min-width: 64rem) 42vw, (min-width: 48rem) 50vw, 100vw"
            : undefined
        }
        alt={figure.alt}
        width={figure.width ?? 1600}
        height={figure.height ?? 1352}
        loading={compact ? "lazy" : "eager"}
        decoding="async"
      />
    </a>
  ) : (
    <div class="border-y border-[#87b7dc]/30 bg-[#07121b]/70 px-5 py-7 sm:px-7 sm:py-9">
      <ol
        class:list={[
          "relative grid gap-8",
          { "md:grid-cols-3 md:gap-10": !compact },
        ]}
      >
        {(figure.nodes ?? []).map((node, index) => (
          <li class="relative flex gap-4">
            <span
              class="flex size-9 shrink-0 items-center justify-center rounded-full border border-[#87b7dc]/40 bg-[#102637] font-mono text-xs text-[#abd1ed]"
              aria-hidden="true"
            >
              {String(index + 1).padStart(2, "0")}
            </span>
            <div class="min-w-0 pt-1">
              <p class="text-base font-medium leading-snug text-paper">
                {node.title}
              </p>
              <p class="mt-2 text-sm leading-relaxed text-muted">
                {node.detail}
              </p>
            </div>
            {compact && index < (figure.nodes?.length ?? 0) - 1 && (
              <span
                class="absolute top-11 bottom-[-1.5rem] left-[1.1rem] w-px bg-linear-to-b from-[#87b7dc]/40 to-[#87b7dc]/10"
                aria-hidden="true"
              ></span>
            )}
          </li>
        ))}
      </ol>
      {figure.optional && (
        <p class="mt-8 border-t border-[#87b7dc]/20 pt-5 text-xs leading-relaxed text-muted">
          <strong class="font-medium text-[#abd1ed]">
            {figure.optional.title}.
          </strong>{" "}
          {figure.optional.detail}
        </p>
      )}
    </div>
  )}
  {image && (
    <figcaption class="mt-3">
      <span class="card-title">{image.title}</span>
      <span class="mt-1 block text-sm leading-relaxed text-muted">
        {image.caption}
      </span>
    </figcaption>
  )}
  {showContext && (
    <figcaption class="mt-3 text-sm leading-relaxed text-muted">
      {!compact && figure.caption && (
        <span class="block">{figure.caption}</span>
      )}
      {figure.sourceHref ? (
        <a
          class="mt-2 inline-flex min-h-11 items-center text-inherit underline"
          href={figure.sourceHref}
        >
          {figure.source}
        </a>
      ) : (
        <span class="mt-2 block">{figure.source}</span>
      )}
      {figure.src && figure.openLabel && (
        <a
          class="mt-1 inline-flex min-h-11 items-center text-inherit underline"
          href={figure.src}
          data-evidence-open
        >
          {figure.openLabel}
        </a>
      )}
    </figcaption>
  )}
  {figure.kind === "screenshot" && figure.src && (
    <dialog
      class="evidence-lightbox"
      data-evidence-dialog
      aria-label={figure.title}
    >
      <div class="evidence-lightbox-stage">
        <button
          class="evidence-lightbox-image-target"
          type="button"
          data-evidence-image-target
          aria-label={zoomAction}
          data-zoom-label={zoomAction}
          data-fit-label={fitAction}
        >
          <img
            class="evidence-lightbox-image"
            alt={figure.alt}
            width={figure.width ?? 1600}
            height={figure.height ?? 1352}
            decoding="async"
            draggable="false"
          />
        </button>
        <button
          class="evidence-lightbox-close"
          type="button"
          data-evidence-close
          aria-label={closeLabel}
          autofocus
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M5 5 19 19 M19 5 5 19" />
          </svg>
        </button>
      </div>
    </dialog>
  )}
</figure>

<script>
  import { onPageLoad } from "../scripts/page-lifecycle";

  onPageLoad((signal) => {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    for (const figure of document.querySelectorAll<HTMLElement>(
      ".evidence-figure",
    )) {
      const dialog = figure.querySelector<HTMLDialogElement>(
        "[data-evidence-dialog]",
      );
      const target = dialog?.querySelector<HTMLButtonElement>(
        "[data-evidence-image-target]",
      );
      const image = target?.querySelector("img");
      const closeButton = dialog?.querySelector<HTMLButtonElement>(
        "[data-evidence-close]",
      );
      if (!dialog || !target || !image || !closeButton || !dialog.showModal)
        continue;

      let opener: HTMLAnchorElement | null = null;
      let closeTimer: number | undefined;
      let scale = 1;
      let originX = 0.5;
      let originY = 0.5;
      let panX = 0;
      let panY = 0;
      let pointerId: number | null = null;
      let startX = 0;
      let startY = 0;
      let startPanX = 0;
      let startPanY = 0;
      let dragged = false;

      const resetZoom = () => {
        dialog.removeAttribute("data-zoomed");
        dialog.removeAttribute("data-panning");
        if (pointerId !== null && target.hasPointerCapture(pointerId))
          target.releasePointerCapture(pointerId);
        pointerId = null;
        scale = 1;
        panX = 0;
        panY = 0;
        image.style.removeProperty("--evidence-zoom-scale");
        if (!dialog.open) {
          image.style.removeProperty("--evidence-zoom-x");
          image.style.removeProperty("--evidence-zoom-y");
        }
        image.style.removeProperty("--evidence-pan-x");
        image.style.removeProperty("--evidence-pan-y");
        target.setAttribute("aria-label", target.dataset.zoomLabel ?? "");
      };

      const setPan = (x: number, y: number) => {
        const width = target.clientWidth;
        const height = target.clientHeight;
        panX = Math.max(
          -(scale - 1) * (1 - originX) * width,
          Math.min((scale - 1) * originX * width, x),
        );
        panY = Math.max(
          -(scale - 1) * (1 - originY) * height,
          Math.min((scale - 1) * originY * height, y),
        );
        image.style.setProperty("--evidence-pan-x", `${panX}px`);
        image.style.setProperty("--evidence-pan-y", `${panY}px`);
      };

      const dismiss = () => {
        if (!dialog.open || dialog.hasAttribute("data-closing")) return;
        if (reducedMotion.matches) {
          dialog.close();
          return;
        }
        dialog.dataset.closing = "";
        closeTimer = window.setTimeout(() => dialog.close(), 280);
      };

      for (const link of figure.querySelectorAll<HTMLAnchorElement>(
        "[data-evidence-open]",
      )) {
        link.setAttribute("aria-haspopup", "dialog");
        link.addEventListener(
          "click",
          (event) => {
            if (
              event.defaultPrevented ||
              event.button !== 0 ||
              event.metaKey ||
              event.ctrlKey ||
              event.shiftKey ||
              event.altKey
            )
              return;
            event.preventDefault();
            opener = link;
            if (!image.hasAttribute("src")) image.src = link.href;
            dialog.showModal();
          },
          { signal },
        );
      }

      target.addEventListener(
        "click",
        (event) => {
          if (dragged) {
            dragged = false;
            return;
          }
          if (dialog.hasAttribute("data-closing")) return;
          if (dialog.hasAttribute("data-zoomed")) {
            resetZoom();
            return;
          }

          const bounds = target.getBoundingClientRect();
          originX =
            event.detail === 0
              ? 0.5
              : Math.max(
                  0,
                  Math.min(1, (event.clientX - bounds.left) / bounds.width),
                );
          originY =
            event.detail === 0
              ? 0.5
              : Math.max(
                  0,
                  Math.min(1, (event.clientY - bounds.top) / bounds.height),
                );
          scale = Math.max(
            1,
            (image.naturalWidth || Number(image.getAttribute("width"))) /
              target.clientWidth,
          );
          if (scale <= 1) return;
          image.style.setProperty("--evidence-zoom-x", `${originX * 100}%`);
          image.style.setProperty("--evidence-zoom-y", `${originY * 100}%`);
          image.style.setProperty("--evidence-zoom-scale", String(scale));
          dialog.dataset.zoomed = "";
          target.setAttribute("aria-label", target.dataset.fitLabel ?? "");
        },
        { signal },
      );

      target.addEventListener(
        "pointerdown",
        (event) => {
          if (!dialog.hasAttribute("data-zoomed") || event.button !== 0) return;
          pointerId = event.pointerId;
          startX = event.clientX;
          startY = event.clientY;
          startPanX = panX;
          startPanY = panY;
          dragged = false;
          target.setPointerCapture(event.pointerId);
        },
        { signal },
      );
      target.addEventListener(
        "pointermove",
        (event) => {
          if (pointerId !== event.pointerId) return;
          const dx = event.clientX - startX;
          const dy = event.clientY - startY;
          if (Math.hypot(dx, dy) > 4) dragged = true;
          if (!dragged) return;
          dialog.dataset.panning = "";
          setPan(startPanX + dx, startPanY + dy);
        },
        { signal },
      );
      const finishPan = (event: PointerEvent) => {
        if (pointerId !== event.pointerId) return;
        if (target.hasPointerCapture(event.pointerId))
          target.releasePointerCapture(event.pointerId);
        pointerId = null;
        dialog.removeAttribute("data-panning");
      };
      target.addEventListener("pointerup", finishPan, { signal });
      target.addEventListener("pointercancel", finishPan, { signal });

      closeButton.addEventListener("click", dismiss, { signal });
      dialog.addEventListener(
        "cancel",
        (event) => {
          event.preventDefault();
          dismiss();
        },
        { signal },
      );
      dialog.addEventListener(
        "click",
        (event) => {
          if (event.target !== dialog) return;
          const bounds = dialog.getBoundingClientRect();
          if (
            event.clientX < bounds.left ||
            event.clientX > bounds.right ||
            event.clientY < bounds.top ||
            event.clientY > bounds.bottom
          )
            dismiss();
        },
        { signal },
      );
      dialog.addEventListener(
        "close",
        () => {
          window.clearTimeout(closeTimer);
          dialog.removeAttribute("data-closing");
          resetZoom();
          opener?.focus({ preventScroll: true });
          opener = null;
        },
        { signal },
      );
      window.addEventListener(
        "resize",
        () => {
          if (dialog.open) resetZoom();
        },
        { signal },
      );
      signal.addEventListener("abort", () => window.clearTimeout(closeTimer), {
        once: true,
      });
    }
  });
</script>

<style>
  .evidence-lightbox {
    position: fixed;
    inset: 0;
    width: max-content;
    max-width: calc(100vw - 1rem);
    max-height: calc(100dvh - 1rem);
    margin: auto;
    overflow: visible;
    padding: 0;
    border: 0;
    background: transparent;
    color: #edf2f5;
  }

  .evidence-lightbox::backdrop {
    background: rgb(1 7 9 / 0.3);
    backdrop-filter: blur(16px) saturate(70%);
  }

  .evidence-lightbox-stage {
    position: relative;
    max-width: calc(100vw - 1rem);
    max-height: calc(100dvh - 1rem);
    overflow: hidden;
  }

  .evidence-lightbox-image-target {
    display: block;
    min-height: 0;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    line-height: 0;
    cursor: zoom-in;
  }

  .evidence-lightbox[data-zoomed] .evidence-lightbox-image-target {
    cursor: zoom-out;
    touch-action: none;
  }

  .evidence-lightbox[data-panning] .evidence-lightbox-image-target {
    cursor: grabbing;
  }

  .evidence-lightbox-image {
    display: block;
    width: auto;
    max-width: calc(100vw - 1rem);
    height: auto;
    max-height: calc(100dvh - 1rem);
    transform-origin: var(--evidence-zoom-x, 50%) var(--evidence-zoom-y, 50%);
    transform: translate3d(
        var(--evidence-pan-x, 0px),
        var(--evidence-pan-y, 0px),
        0
      )
      scale(var(--evidence-zoom-scale, 1));
    transition: transform 460ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .evidence-lightbox[data-panning] .evidence-lightbox-image {
    transition: none;
  }

  .evidence-lightbox-close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 1;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: rgb(2 10 12 / 0.45);
    color: #fff;
    opacity: 0.7;
    cursor: pointer;
    transition: opacity 160ms ease;
  }

  .evidence-lightbox-close:is(:hover, :focus-visible) {
    opacity: 1;
  }

  .evidence-lightbox-close svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  @keyframes evidence-enter {
    from {
      opacity: 0;
      scale: 0.94;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }

  @keyframes evidence-leave {
    from {
      opacity: 1;
      scale: 1;
    }
    to {
      opacity: 0;
      scale: 0.96;
    }
  }

  @keyframes evidence-backdrop-enter {
    from {
      opacity: 0;
      backdrop-filter: blur(0);
    }
    to {
      opacity: 1;
      backdrop-filter: blur(16px) saturate(70%);
    }
  }

  @keyframes evidence-backdrop-leave {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  .evidence-lightbox[open] {
    animation: evidence-enter 340ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .evidence-lightbox[open]::backdrop {
    animation: evidence-backdrop-enter 340ms ease both;
  }

  .evidence-lightbox[data-closing] {
    animation: evidence-leave 260ms ease both;
  }

  .evidence-lightbox[data-closing]::backdrop {
    animation: evidence-backdrop-leave 260ms ease both;
  }

  @media (prefers-reduced-motion: reduce) {
    .evidence-lightbox[open],
    .evidence-lightbox[data-closing],
    .evidence-lightbox[open]::backdrop,
    .evidence-lightbox[data-closing]::backdrop {
      animation: none;
    }

    .evidence-lightbox-image,
    .evidence-lightbox-close {
      transition: none;
    }
  }
</style>
