---
import { caseStudies, type CaseStudyId, type Locale } from "../data/portfolio";
interface Props {
  locale: Locale;
  projectId: CaseStudyId;
  compact?: boolean;
}
const { locale, projectId, compact = false } = Astro.props;
const figure = caseStudies[locale][projectId].figure;
const labelId = `${projectId}-evidence-label`;
const showContext = !compact || figure.kind !== "screenshot";
const closeLabel = locale === "fr" ? "Fermer" : "Close";
const zoomLabel = locale === "fr" ? "Zoomer" : "Zoom in";
const fitLabel = locale === "fr" ? "Ajuster" : "Fit image";
---

<figure
  class="evidence-figure min-w-0"
  aria-labelledby={showContext ? labelId : undefined}
>
  {showContext && (
    <p id={labelId} class="mb-4 font-mono text-xs leading-relaxed">
      {figure.title}
    </p>
  )}
  {figure.kind === "screenshot" && figure.src ? (
    <a
      class="block cursor-zoom-in focus-visible:outline-offset-4"
      href={figure.src}
      aria-label={figure.openLabel ?? figure.alt}
      data-evidence-open
    >
      <img
        class="block h-auto w-full bg-paper"
        src={figure.src}
        srcset={compact ? figure.srcset : undefined}
        sizes={
          compact
            ? "(min-width: 64rem) 42vw, (min-width: 48rem) 50vw, 100vw"
            : undefined
        }
        alt={figure.alt}
        width="1600"
        height="1352"
        loading={compact ? "lazy" : "eager"}
        decoding="async"
      />
    </a>
  ) : (
    <div class="border-y border-[#87b7dc]/30 bg-[#07121b]/70 px-5 py-7 sm:px-7 sm:py-9">
      <ol
        class:list={[
          "relative grid gap-8",
          { "md:grid-cols-3 md:gap-10": !compact },
        ]}
      >
        {(figure.nodes ?? []).map((node, index) => (
          <li class="relative flex gap-4">
            <span
              class="flex size-9 shrink-0 items-center justify-center rounded-full border border-[#87b7dc]/40 bg-[#102637] font-mono text-xs text-[#abd1ed]"
              aria-hidden="true"
            >
              {String(index + 1).padStart(2, "0")}
            </span>
            <div class="min-w-0 pt-1">
              <p class="text-base font-medium leading-snug text-paper">
                {node.title}
              </p>
              <p class="mt-2 text-sm leading-relaxed text-muted">
                {node.detail}
              </p>
            </div>
            {compact && index < (figure.nodes?.length ?? 0) - 1 && (
              <span
                class="absolute top-11 bottom-[-1.5rem] left-[1.1rem] w-px bg-linear-to-b from-[#87b7dc]/40 to-[#87b7dc]/10"
                aria-hidden="true"
              ></span>
            )}
          </li>
        ))}
      </ol>
      {figure.optional && (
        <p class="mt-8 border-t border-[#87b7dc]/20 pt-5 text-xs leading-relaxed text-muted">
          <strong class="font-medium text-[#abd1ed]">
            {figure.optional.title}.
          </strong>{" "}
          {figure.optional.detail}
        </p>
      )}
    </div>
  )}
  {showContext && (
    <figcaption class="mt-3 text-sm leading-relaxed text-muted">
      {!compact && figure.caption && (
        <span class="block">{figure.caption}</span>
      )}
      <span class="mt-2 block">{figure.source}</span>
      {figure.src && figure.openLabel && (
        <a
          class="mt-1 inline-flex min-h-11 items-center text-inherit underline"
          href={figure.src}
          data-evidence-open
        >
          {figure.openLabel}
        </a>
      )}
    </figcaption>
  )}
  {figure.kind === "screenshot" && figure.src && (
    <dialog
      class="evidence-lightbox"
      data-evidence-dialog
      aria-label={figure.title}
    >
      <div class="evidence-lightbox-toolbar">
        <button type="button" data-evidence-zoom aria-pressed="false">
          <span data-evidence-zoom-in>{zoomLabel}</span>
          <span data-evidence-zoom-out hidden>
            {fitLabel}
          </span>
        </button>
        <form method="dialog">
          <button type="submit" autofocus>
            {closeLabel} <span aria-hidden="true">×</span>
          </button>
        </form>
      </div>
      <img
        class="evidence-lightbox-image"
        src={figure.src}
        alt={figure.alt}
        width="1600"
        height="1352"
        loading="lazy"
        decoding="async"
      />
    </dialog>
  )}
</figure>

<script>
  import { onPageLoad } from "../scripts/page-lifecycle";

  onPageLoad((signal) => {
    for (const figure of document.querySelectorAll<HTMLElement>(
      ".evidence-figure",
    )) {
      const dialog = figure.querySelector<HTMLDialogElement>(
        "[data-evidence-dialog]",
      );
      if (!dialog || typeof dialog.showModal !== "function") continue;

      let opener: HTMLAnchorElement | null = null;
      const zoom = dialog.querySelector<HTMLButtonElement>(
        "[data-evidence-zoom]",
      );
      const zoomIn = dialog.querySelector<HTMLElement>(
        "[data-evidence-zoom-in]",
      );
      const zoomOut = dialog.querySelector<HTMLElement>(
        "[data-evidence-zoom-out]",
      );

      for (const link of figure.querySelectorAll<HTMLAnchorElement>(
        "[data-evidence-open]",
      )) {
        link.setAttribute("aria-haspopup", "dialog");
        link.addEventListener(
          "click",
          (event) => {
            if (
              event.defaultPrevented ||
              event.button !== 0 ||
              event.metaKey ||
              event.ctrlKey ||
              event.shiftKey ||
              event.altKey
            )
              return;

            event.preventDefault();
            opener = link;
            dialog.showModal();
          },
          { signal },
        );
      }

      zoom?.addEventListener(
        "click",
        () => {
          const zoomed = dialog.toggleAttribute("data-zoomed");
          zoom.setAttribute("aria-pressed", String(zoomed));
          if (zoomIn) zoomIn.hidden = zoomed;
          if (zoomOut) zoomOut.hidden = !zoomed;
        },
        { signal },
      );

      dialog.addEventListener(
        "click",
        (event) => {
          if (event.target !== dialog) return;
          const bounds = dialog.getBoundingClientRect();
          if (
            event.clientX < bounds.left ||
            event.clientX > bounds.right ||
            event.clientY < bounds.top ||
            event.clientY > bounds.bottom
          )
            dialog.close();
        },
        { signal },
      );

      dialog.addEventListener(
        "close",
        () => {
          dialog.removeAttribute("data-zoomed");
          dialog.scrollTo(0, 0);
          zoom?.setAttribute("aria-pressed", "false");
          if (zoomIn) zoomIn.hidden = false;
          if (zoomOut) zoomOut.hidden = true;
          opener?.focus({ preventScroll: true });
          opener = null;
        },
        { signal },
      );
    }
  });
</script>

<style>
  .evidence-lightbox {
    position: fixed;
    inset: 0;
    width: min(75rem, calc(100vw - 2rem));
    max-width: none;
    max-height: calc(100dvh - 2rem);
    margin: auto;
    overflow: auto;
    padding: 1rem;
    border: 1px solid rgb(168 200 190 / 0.55);
    background: #071214;
    color: #edf2f5;
    box-shadow: 0 1.5rem 5rem rgb(0 0 0 / 0.5);
  }

  .evidence-lightbox::backdrop {
    background: rgb(0 0 0 / 0.85);
  }

  .evidence-lightbox-toolbar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    background: #071214;
  }

  .evidence-lightbox-toolbar button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid rgb(168 200 190 / 0.5);
    background: #0b191b;
    color: inherit;
    cursor: pointer;
  }

  .evidence-lightbox-image {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: calc(100dvh - 8rem);
    margin-inline: auto;
  }

  .evidence-lightbox[data-zoomed] .evidence-lightbox-image {
    max-width: none;
    max-height: none;
  }

  @media (max-width: 47.999rem) {
    .evidence-lightbox {
      width: calc(100vw - 1rem);
      max-height: calc(100dvh - 1rem);
      padding: 0.5rem;
    }
  }
</style>
