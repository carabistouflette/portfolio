---
import {
  type Locale,
  type PortfolioContent,
  type ProjectId,
} from "../data/portfolio";
import ToolIcon from "./ToolIcon.astro";
import ProjectScene from "./ProjectScene.astro";
import HealthGraphBenchmark from "./HealthGraphBenchmark.astro";

interface Props {
  content: PortfolioContent;
  locale: Locale;
}
const { content, locale } = Astro.props;
const fr = locale === "fr";
const projectTools: Record<ProjectId, string[]> = {
  genomint: ["Python", "FastAPI", "Neo4j", "PostgreSQL", "Docker"],
  meddatatrace: ["Python", "NumPy", "Scikit-learn", "Numba", "Matplotlib"],
  sillage: ["Rust", "Slint", "Tantivy", "SQLite", "Tokio"],
  nacre: ["Rust", "C", "Linux"],
  "encrypted-voting": ["Java", "Spring Boot"],
  justsyncit: ["Java", "SQLite", "Jackson", "Kwik", "Bouncy Castle"],
};
const projectConcepts: Record<ProjectId, string[]> = fr
  ? {
      genomint: ["Pangénomie", "Graphes", "Agent IA"],
      meddatatrace: ["Données de santé", "Graphes", "Évaluation temporelle"],
      sillage: ["Lanceur Linux", "Recherche locale", "Extraits sourcés"],
      nacre: ["Compilateur", "Ownership", "Sans GC"],
      "encrypted-voting": ["El Gamal", "Preuves à connaissance zéro"],
      justsyncit: ["Sauvegardes", "Snapshots", "BLAKE3"],
    }
  : {
      genomint: ["Pangenomics", "Graphs", "AI agent"],
      meddatatrace: ["Health data", "Graphs", "Temporal evaluation"],
      sillage: ["Linux launcher", "Local search", "Cited excerpts"],
      nacre: ["Compiler", "Ownership", "No GC"],
      "encrypted-voting": ["El Gamal", "Zero-knowledge proofs"],
      justsyncit: ["Backups", "Snapshots", "BLAKE3"],
    };
---

<section
  id="projects"
  class="content-shell section-shell projects-section"
  aria-labelledby="projects-title"
>
  <header class="projects-heading">
    <h2 id="projects-title" class="section-title">
      {content.projects.heading}
    </h2>
    <p class="projects-intro">{content.projects.intro}</p>
  </header>
  <div class="projects-grid">
    {content.projects.entries.map((project, index) => {
      const Surface = project.url ? "a" : "div";
      const Heading = index < 3 ? "h3" : "h4";
      return (
        <Fragment>
          {index === 3 && (
            <h3 class="complementary-heading">
              {content.projects.otherHeading}
            </h3>
          )}
          <article
            id={`project-${project.id}`}
            class:list={[
              "project-tile",
              `tile-${project.id}`,
              { "project-featured": index < 3 },
            ]}
            tabindex="-1"
          >
            <Surface
              class="tile-surface"
              href={project.url}
              aria-label={project.url ? project.title : undefined}
              aria-describedby={`project-${project.id}-description project-${project.id}-tools project-${project.id}-concepts${project.status ? ` project-${project.id}-status` : ""}`}
            >
              <span class="tile-mark" aria-hidden="true">
                {project.url ? "↗" : "◇"}
              </span>
              {project.id === "genomint" && (
                <figure class="genomint-preview">
                  <img
                    src="/images/genomint-explorer-1100.webp"
                    srcset="/images/genomint-explorer-1100.webp 1100w, /images/genomint-explorer.webp 2877w"
                    sizes="(min-width: 100rem) 60vw, (min-width: 64rem) 55vw, calc(100vw - 5rem)"
                    width="2877"
                    height="1743"
                    alt={
                      fr
                        ? "GKG Explorer : filtres, graphe génomique et table de gènes dans l’interface GenomInt."
                        : "GKG Explorer: filters, genomic graph and gene table in the GenomInt interface."
                    }
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>
                    GKG Explorer <span aria-hidden="true">—</span>{" "}
                    {fr ? "interface GenomInt" : "GenomInt interface"}
                  </figcaption>
                </figure>
              )}
              {project.id === "sillage" && (
                <figure class="sillage-preview">
                  <img
                    src="/evidence/sillage-search-poster.webp"
                    width="1108"
                    height="594"
                    alt={
                      fr
                        ? "Sillage : recherche du mot « provenance », extrait trouvé et passage source dans le lanceur Linux."
                        : "Sillage: search for “provenance”, matching excerpt and source passage in the Linux launcher."
                    }
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>
                    <span aria-hidden="true">▷</span>{" "}
                    {fr
                      ? "Capture du lanceur · démonstration de 12 s"
                      : "Launcher capture · 12-second demonstration"}
                  </figcaption>
                </figure>
              )}
              {project.id === "nacre" && (
                <div class="tile-art compiler-art" aria-hidden="true">
                  <div class="compiler-source">
                    <span class="compiler-file">hello.ncr</span>
                    <code>
                      <span>void</span>
                      {' main() {\n  println("Hello, native.");\n}'}
                    </code>
                  </div>
                  <div class="compiler-path">
                    <span>Nacre</span>
                    <i>↓</i>
                    <span>C11</span>
                    <i>↓</i>
                    <span class="compiler-native">
                      1010<span>native</span>0110
                    </span>
                  </div>
                </div>
              )}
              {(project.id === "encrypted-voting" ||
                project.id === "justsyncit") && (
                <div class="tile-scene">
                  <ProjectScene kind={project.id} locale={locale} />
                </div>
              )}
              <div class="tile-copy">
                {index < 3 && (
                  <p class="tile-context">
                    {project.id === "genomint"
                      ? fr
                        ? "CIRAD · Génomique"
                        : "CIRAD · Genomics"
                      : project.id === "meddatatrace"
                        ? fr
                          ? "Recherche personnelle"
                          : "Independent research"
                        : fr
                          ? "Brio · Contribution"
                          : "Brio · Contributor"}
                  </p>
                )}
                <Heading>
                  {project.title
                    .split(/(?<=[a-z])(?=[A-Z])/)
                    .map((part, index) => (
                      <Fragment>
                        {index > 0 && <wbr />}
                        {part}
                      </Fragment>
                    ))}
                </Heading>
                {project.id === "meddatatrace" && (
                  <HealthGraphBenchmark locale={locale} />
                )}
                <p
                  id={`project-${project.id}-description`}
                  class="tile-description"
                >
                  {project.description}
                </p>
                <ul id={`project-${project.id}-tools`} class="tile-tools">
                  {projectTools[project.id].map((name) => (
                    <li title={name}>
                      <span class="sr-only">{name}</span>
                      <ToolIcon name={name} />
                    </li>
                  ))}
                </ul>
                {project.status && (
                  <p id={`project-${project.id}-status`} class="tile-status">
                    {project.status}
                  </p>
                )}
                <p id={`project-${project.id}-concepts`} class="tile-concepts">
                  {projectConcepts[project.id].join(" · ")}
                </p>
                {project.linkLabel && (
                  <span class="tile-link" aria-hidden="true">
                    {project.linkLabel} →
                  </span>
                )}
              </div>
            </Surface>
          </article>
        </Fragment>
      );
    })}
  </div>
</section>

<style>
  .projects-heading {
    display: grid;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .projects-intro {
    max-width: 58ch;
    color: var(--color-muted);
    font-size: 1.0625rem;
    line-height: 1.7;
    text-wrap: pretty;
  }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: auto;
    gap: 1.25rem;
    height: auto;
  }
  .complementary-heading {
    grid-column: 1 / -1;
    margin-top: 2rem;
    margin-bottom: 0.25rem;
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-muted);
  }
  .project-featured {
    min-height: 28rem;
  }
  .project-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    grid-column: span 4;
    --tile-padding: clamp(1.15rem, 2vw, 2rem);
    border: 1px solid var(--tile-border);
    background: var(--tile-bg);
    color: #f1eee5;
    border-radius: 1rem;
    scroll-margin-top: 6rem;
    overflow: hidden;
    isolation: isolate;
  }
  .tile-surface {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    width: 100%;
    padding: var(--tile-padding);
    color: inherit;
    text-decoration: none;
  }
  .tile-genomint {
    --tile-bg: #0c1a1b;
    --tile-border: #345451;
    --tile-accent: #b0ded0;
    grid-column: 1 / -1;
    border-inline: 0;
    border-radius: 0;
    background: transparent;
  }
  .tile-genomint .tile-surface {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 4rem);
    padding: 2.5rem 0;
  }
  .tile-genomint .tile-copy {
    grid-column: 1;
    grid-row: 1;
    margin: 0;
  }
  .genomint-preview {
    grid-column: 2;
    min-width: 0;
    margin: 0;
  }
  .genomint-preview img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid #657c76;
    border-radius: 0.25rem;
  }
  .genomint-preview figcaption {
    margin-top: 0.75rem;
    color: var(--color-muted);
    font-size: 0.75rem;
    line-height: 1.5;
  }
  .tile-context {
    margin-bottom: 0.75rem;
    color: var(--tile-accent);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .tile-genomint .tile-copy :is(h3, h4) {
    font-size: clamp(2.5rem, 4vw, 4rem);
  }
  .tile-nacre .tile-surface {
    padding-top: calc(var(--tile-padding) + 10rem);
  }
  .project-tile:is(.tile-meddatatrace, .tile-sillage) {
    align-self: start;
    min-height: 0;
  }
  .tile-meddatatrace .tile-copy {
    margin-top: 0;
  }
  .tile-meddatatrace {
    grid-column: span 5;
    --tile-bg: #15262d;
    --tile-border: #52737c;
    --tile-accent: #b4dce1;
    background-image: radial-gradient(
      ellipse at top right,
      #294e5b80,
      transparent 70%
    );
  }
  .tile-status {
    margin-top: 1rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--tile-accent);
  }
  .tile-link {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.8125rem;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .tile-sillage {
    --tile-bg: #182330;
    --tile-border: #435367;
    --tile-accent: #bdd1ec;
    grid-column: span 7;
  }
  .tile-sillage .tile-surface {
    gap: 1.5rem;
  }
  .sillage-preview {
    min-width: 0;
    margin: 0;
  }
  .sillage-preview img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--tile-border);
    border-radius: 0.4rem;
  }
  .sillage-preview figcaption {
    margin-top: 0.65rem;
    color: var(--tile-accent);
    font-size: 0.8125rem;
    line-height: 1.6;
  }
  .tile-sillage .tile-copy {
    margin-top: 0;
  }
  .tile-nacre {
    --tile-bg: #252733;
    --tile-border: #575b76;
    --tile-accent: #d1cbee;
  }
  .tile-encrypted-voting {
    --tile-bg: #29231e;
    --tile-border: #605043;
    --tile-accent: #dbc09c;
    grid-column: span 4;
  }
  .tile-justsyncit {
    --tile-bg: #202b2d;
    --tile-border: #496366;
    --tile-accent: #b1d9d5;
    grid-column: span 4;
  }
  .tile-mark {
    position: absolute;
    top: var(--tile-padding);
    right: var(--tile-padding);
    z-index: 2;
    color: var(--tile-accent);
    font-size: 1.1rem;
    pointer-events: none;
  }
  .tile-art {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .tile-copy {
    margin-top: auto;
    position: relative;
    z-index: 2;
  }
  .project-tile:not(.tile-genomint) .tile-copy::before {
    content: "";
    position: absolute;
    inset: -2.5rem calc(-1 * var(--tile-padding)) calc(-1 * var(--tile-padding));
    z-index: -1;
    background: linear-gradient(180deg, transparent, var(--tile-bg) 2rem);
    pointer-events: none;
  }
  .tile-sillage .tile-copy::before,
  .tile-meddatatrace .tile-copy::before {
    content: none;
  }
  .tile-nacre .tile-copy::before {
    background: linear-gradient(180deg, transparent, #252733 2rem);
  }
  .tile-copy :is(h3, h4) {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.6vw, 2.8rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }
  .tile-description {
    max-width: 48ch;
    font-size: 1rem;
    line-height: 1.7;
    margin-top: 1rem;
    color: #e0e3df;
  }
  .tile-concepts {
    margin-top: 0.8rem;
    padding-top: 0.65rem;
    border-top: 1px solid var(--tile-border);
    color: var(--tile-accent);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .tile-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    margin-block: 0.8rem;
    color: var(--tile-accent);
  }
  .tile-tools li {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    pointer-events: auto;
  }
  .tile-tools li > svg {
    width: 1.5rem;
    height: 1.5rem;
  }
  .tile-encrypted-voting :is(h3, h4),
  .tile-justsyncit :is(h3, h4) {
    font-size: 1.5rem;
  }
  .tile-encrypted-voting .tile-description,
  .tile-justsyncit .tile-description {
    font-size: 1rem;
    line-height: 1.7;
    margin-top: 0.75rem;
  }
  .compiler-art {
    padding: 3.5rem 1.5rem 0;
    color: var(--tile-accent);
    background: radial-gradient(ellipse at 80% 10%, #55527455, transparent 65%);
    font-family: monospace;
  }
  .compiler-source {
    padding: 1rem;
    border: 1px solid #a6a0c13d;
    border-radius: 0.4rem;
    background: #161923;
    transform: rotate(-4deg);
    font-size: clamp(0.65rem, 0.85vw, 0.85rem);
    box-shadow: 0 8px 0 #16192355;
  }
  .compiler-file {
    display: block;
    padding-bottom: 0.75rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid #a6a0c12b;
    color: #aaa8bb;
  }
  .compiler-source code {
    white-space: pre;
    line-height: 1.8;
  }
  .compiler-source code > span {
    color: #b7a1e8;
  }
  .compiler-path {
    display: flex;
    align-items: center;
    justify-content: space-around;
    margin-top: 1.5rem;
    font-size: 0.8rem;
  }
  .compiler-path i {
    transform: rotate(-90deg);
    opacity: 0.5;
  }
  .compiler-native {
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    color: #9dafa7;
  }
  .compiler-native span {
    display: block;
    font-size: 0.85rem;
    color: #e1e8e0;
    letter-spacing: 0;
  }
  .project-tile:focus-within {
    outline: 2px solid var(--tile-accent);
    outline-offset: 3px;
  }
  .project-tile:has(a):is(:hover, :focus-within) {
    border-color: var(--tile-accent);
  }
  .tile-surface:focus-visible {
    outline: 2px solid var(--tile-accent);
    outline-offset: 4px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .tile-nacre .compiler-source {
      transition: transform 320ms cubic-bezier(0.2, 0.7, 0.25, 1);
    }
    .tile-nacre:is(:hover, :focus-within) .compiler-source {
      transform: translateY(-8px) rotate(-1deg) scale(1.015);
    }
    .tile-nacre:is(:hover, :focus-within) .compiler-path > * {
      animation: compilation-step 2.4s ease-in-out var(--compile-delay, 0ms)
        infinite;
    }
    .compiler-path > :nth-child(2) {
      --compile-delay: 180ms;
    }
    .compiler-path > :nth-child(3) {
      --compile-delay: 360ms;
    }
    .compiler-path > :nth-child(4) {
      --compile-delay: 540ms;
    }
    .compiler-path > :nth-child(5) {
      --compile-delay: 720ms;
    }
    @keyframes compilation-step {
      0%,
      65%,
      100% {
        opacity: 0.35;
      }
      20%,
      40% {
        opacity: 1;
      }
    }
  }
  @media (max-width: 63.999rem) {
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
      grid-auto-rows: auto;
      height: auto;
    }
    .project-tile {
      min-height: 26rem;
      grid-column: auto;
    }
    .tile-genomint {
      grid-column: 1 / -1;
    }
    .tile-genomint .tile-surface {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
    .genomint-preview {
      grid-column: 1;
    }
    .tile-genomint .tile-copy {
      grid-row: 1;
      max-width: 58ch;
    }
    .compiler-art {
      padding: 2rem 2rem 0;
      display: flex;
      gap: 3rem;
      align-items: flex-start;
    }
    .compiler-source {
      width: 55%;
      font-size: 0.9rem;
    }
    .tile-encrypted-voting,
    .tile-justsyncit {
      min-height: 12rem;
    }
  }
  @media (max-width: 39.999rem) {
    .projects-grid {
      gap: 1rem;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-auto-rows: auto;
      height: auto;
    }
    .tile-genomint,
    .tile-sillage,
    .tile-nacre {
      grid-column: auto;
      min-height: 24rem;
    }
    .tile-encrypted-voting,
    .tile-justsyncit {
      min-height: 0;
    }
    .project-tile {
      grid-column: auto;
      --tile-padding: 1.25rem;
    }
    .tile-nacre .tile-surface {
      padding-top: calc(var(--tile-padding) + 8rem);
    }
    .tile-encrypted-voting .tile-scene,
    .tile-justsyncit .tile-scene {
      height: 10.5rem;
      margin-bottom: 1rem;
    }
    .tile-encrypted-voting .tile-scene :global(.project-scene),
    .tile-justsyncit .tile-scene :global(.project-scene) {
      transform: scale(0.7);
      transform-origin: top center;
    }
    .compiler-art {
      display: block;
      padding: 1rem;
    }
    .compiler-source {
      width: 75%;
      margin-left: auto;
      padding: 0.65rem;
      font-size: 0.6rem;
    }
    .compiler-file {
      padding-bottom: 0.35rem;
      margin-bottom: 0.35rem;
    }
    .compiler-path {
      display: none;
    }
    .tile-nacre .tile-copy {
      text-shadow: 0 1px 4px #161923;
    }
    .tile-copy :is(h3, h4) {
      font-size: 1.6rem;
    }
    .tile-tools {
      gap: 0.45rem;
      margin-block: 0.65rem;
    }
    .tile-tools li {
      width: 1.5rem;
      height: 1.5rem;
    }
    .tile-description {
      margin-top: 0.75rem;
    }
    .tile-encrypted-voting :is(h3, h4),
    .tile-justsyncit :is(h3, h4) {
      font-size: 1.25rem;
    }
  }
</style>
