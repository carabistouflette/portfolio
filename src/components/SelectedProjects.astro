---
import ProjectIndex from "./ProjectIndex.astro";
import ProjectPreview from "./ProjectPreview.astro";
import DisclosureSummary from "./DisclosureSummary.astro";
import type { Locale, PortfolioContent } from "../data/portfolio";

interface Props {
  content: PortfolioContent;
  locale: Locale;
}
const { content, locale } = Astro.props;
const fr = locale === "fr";
const hooks = fr
  ? [
      "Interroger un graphe génomique en langage naturel.",
      "Les graphes améliorent-ils les prédictions en santé ?",
      "Retrouver un passage, puis ouvrir sa source.",
    ]
  : [
      "Query a genomic graph in natural language.",
      "Do graphs improve predictions on health data?",
      "Find a passage, then open its source.",
    ];
const actions = fr
  ? ["Voir l’explorateur", "Lire le benchmark", "Voir la recherche"]
  : ["See the explorer", "Read the benchmark", "See the search"];
const contributions = fr
  ? [
      "Agent IA, requêtes Neo4j, API et exports.",
      "Protocole temporel, modèles de référence et évaluation.",
      "Moteur de recherche et traitement des documents pour l’indexation vectorielle.",
    ]
  : [
      "AI agent, Neo4j queries, APIs and exports.",
      "Temporal protocol, baseline models and evaluation.",
      "Search engine and document processing for vector indexing.",
    ];
---

<section
  id="projects"
  class="content-shell section-shell projects-section"
  aria-labelledby="projects-title"
>
  <header class="projects-heading">
    <h2 id="projects-title" class="section-title">
      {content.projects.heading}
    </h2>
    <p class="projects-intro">{content.projects.intro}</p>
  </header>
  <ProjectIndex content={content} locale={locale} />
  <div class="projects-grid">
    {content.projects.entries.slice(0, 3).map((project, index) => {
      const tools =
        project.id === "genomint"
          ? ["Python", "FastAPI", "Neo4j"]
          : project.technologies.split(" · ").slice(0, 3);
      return (
        <article
          id={`project-${project.id}`}
          class:list={["project-tile", `tile-${project.id}`]}
          tabindex="-1"
        >
          <ProjectPreview projectId={project.id} locale={locale} />
          <div class="tile-copy">
            <p class="tile-context">
              {project.id === "genomint"
                ? "CIRAD · 2026"
                : project.id === "meddatatrace"
                  ? fr
                    ? "Recherche personnelle · en cours"
                    : "Independent research · in progress"
                  : fr
                    ? "Brio · contribution"
                    : "Brio · contributor"}
            </p>
            <h3>
              <a
                class="tile-title-link"
                href={project.url}
                aria-describedby={`project-${project.id}-outcome`}
              >
                {project.title
                  .split(/(?<=[a-z])(?=[A-Z])/)
                  .map((part, index) => (
                    <Fragment>
                      {index > 0 && <wbr />}
                      {part}
                    </Fragment>
                  ))}
              </a>
            </h3>
            <p id={`project-${project.id}-outcome`} class="tile-outcome">
              {hooks[index]}
            </p>
            <p class="tile-contribution">
              <span>{content.projects.contributionLabel}</span>{" "}
              {contributions[index]}
            </p>
            <footer class="tile-footer">
              <p
                class="tile-tools"
                aria-label={
                  fr ? "Technologies principales" : "Principal technologies"
                }
              >
                {tools.join(" · ")}
              </p>
              <div class="tile-actions">
                <span class="tile-primary-cta" aria-hidden="true">
                  {actions[index]}
                  <span class="tile-arrow">↗</span>
                </span>
                {project.id === "sillage" && (
                  <a
                    class="tile-secondary-link"
                    href={`${project.url}#case-demo-title`}
                  >
                    {fr ? "Démo · 12 s" : "Demo · 12 s"}
                    <span aria-hidden="true">▷</span>
                  </a>
                )}
                {project.id === "meddatatrace" && (
                  <a
                    class="tile-secondary-link"
                    href={`${project.url}#benchmark-results`}
                  >
                    {fr ? "Résultats" : "Results"}
                    <span aria-hidden="true">→</span>
                  </a>
                )}
              </div>
            </footer>
          </div>
        </article>
      );
    })}
  </div>
  <details class="other-projects button-disclosure reading-disclosure content-disclosure">
    <DisclosureSummary>
      <span id="other-projects-title" class="button-disclosure-label">
        {content.projects.otherHeading}
      </span>
    </DisclosureSummary>
    <div class="reading-disclosure-body">
      <ul class="other-projects-list">
        {content.projects.entries.slice(3).map((project) => (
          <li id={`project-${project.id}`} tabindex="-1" class="other-project">
            <a class="other-project-link" href={project.url}>
              <div class="other-project-copy">
                <h4>{project.title}</h4>
                <p>{project.description}</p>
              </div>
              <span class="other-project-action" aria-hidden="true">
                {project.linkLabel} ↗
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </details>
</section>

<style>
  .projects-heading {
    display: grid;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  .projects-intro {
    max-width: 58ch;
    color: var(--secondary);
    font-size: 1.0625rem;
    line-height: 1.7;
    text-wrap: pretty;
  }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .project-tile {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: 1px solid #819b9b38;
    border-radius: 1rem;
    background: #0b1518;
    --tile-accent: #b2ddca;
    scroll-margin-top: 6rem;
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }
  .project-tile > :global(.project-preview) {
    border-radius: calc(1rem - 1px) calc(1rem - 1px) 0 0;
  }
  .tile-meddatatrace {
    --tile-accent: #bbd5ed;
    background: #0c1720;
  }
  .tile-sillage {
    --tile-accent: #d4c8ed;
    background: #141622;
  }
  .tile-copy {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: clamp(1.25rem, 2vw, 1.75rem);
  }
  .tile-context {
    color: var(--tile-accent);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  h3 {
    margin-top: 0.65rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.2vw, 2.35rem);
    line-height: 1.15;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }
  .tile-title-link {
    color: var(--primary);
    text-decoration: none;
  }
  .tile-title-link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: 1rem;
  }
  .tile-title-link:focus-visible {
    outline: none;
  }
  .tile-title-link:focus-visible::after {
    outline: 2px solid var(--tile-accent);
    outline-offset: 5px;
  }
  .tile-outcome {
    margin-top: 0.85rem;
    color: var(--primary);
    font-size: 1.0625rem;
    line-height: 1.6;
    text-wrap: pretty;
  }
  .tile-contribution {
    margin-top: 1.25rem;
    color: var(--secondary);
    font-size: 0.875rem;
    line-height: 1.7;
    text-wrap: pretty;
  }
  .tile-contribution > span {
    color: var(--tile-accent);
  }
  .tile-footer {
    margin-top: auto;
    padding-top: 1.5rem;
  }
  .tile-tools {
    color: var(--tile-accent);
    font-size: 0.75rem;
    line-height: 1.6;
  }
  .tile-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: 1.1rem;
    padding-top: 1rem;
    border-top: 1px solid #abc7cf24;
  }
  .tile-primary-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--primary);
  }
  .tile-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.8rem;
    height: 1.8rem;
    border: 1px solid #b5d3ce52;
    border-radius: 50%;
    color: var(--tile-accent);
    transition:
      color 180ms ease,
      background 180ms ease,
      transform 180ms ease;
  }
  .tile-secondary-link {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    color: var(--tile-accent);
    font-size: 0.8125rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .project-tile:is(:hover, :focus-within) {
    border-color: color-mix(in srgb, var(--tile-accent) 65%, transparent);
    box-shadow: 0 1rem 2.5rem #0004;
  }
  .project-tile:is(:hover, :focus-within) .tile-arrow {
    background: var(--tile-accent);
    color: #101b18;
    transform: translate(2px, -2px);
  }
  @media (hover: hover) {
    .project-tile:hover {
      transform: translateY(-4px);
    }
  }
  .other-projects {
    margin-top: 2.5rem;
  }
  .other-projects-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--rule);
  }
  .other-project {
    border-top: 1px solid var(--rule);
    scroll-margin-top: 6rem;
  }
  .other-project-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 1.25rem;
    text-decoration: none;
  }
  .other-project-copy {
    min-width: 0;
  }
  .other-project-copy h4 {
    font-size: 1.125rem;
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .other-project-copy p {
    max-width: 68ch;
    margin-top: 0.55rem;
    color: var(--secondary);
    font-size: 0.9375rem;
    line-height: 1.7;
    text-wrap: pretty;
  }
  .other-project-action {
    flex-shrink: 0;
    color: #abd1ed;
    font-size: 0.875rem;
  }
  .other-project-link:is(:hover, :focus-visible) h4 {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  @media (min-width: 48rem) and (max-width: 79.999rem) {
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 47.999rem) {
    .projects-heading {
      margin-bottom: 1.5rem;
    }
    .projects-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
    .other-project-link {
      align-items: start;
      flex-direction: column;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-tile,
    .tile-arrow {
      transition: none;
    }
    .project-tile:hover {
      transform: none;
    }
  }
</style>
