---
import {
  caseStudies,
  type Locale,
  type PortfolioContent,
} from "../data/portfolio";
import EvidenceFigure from "./EvidenceFigure.astro";

interface Props {
  content: PortfolioContent;
  locale: Locale;
}
const { content, locale } = Astro.props;
const genomint = caseStudies[locale].genomint;
const maestria = caseStudies[locale].maestria;
const genomintProject = content.projects.entries.find(
  (project) => project.id === "genomint",
)!;
const maestriaProject = content.projects.entries.find(
  (project) => project.id === "maestria",
)!;
const supplementary = content.projects.entries.filter(
  (project) => project.id !== "genomint" && project.id !== "maestria",
);
---

<section
  id="projects"
  class="content-shell pb-20 md:pb-28"
  aria-labelledby="projects-title"
>
  <h2 id="projects-title" class="section-title mb-12 md:mb-16">
    {content.projects.heading}
  </h2>
  <article
    id="project-genomint"
    class="project-research grid gap-12 bg-[#0b191b] px-6 py-12 text-paper target:scroll-mt-6 md:p-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] lg:items-center lg:gap-20 lg:p-16"
    tabindex="-1"
  >
    <div
      class="project-research-art pointer-events-none absolute inset-0 overflow-hidden"
      aria-hidden="true"
    >
      <svg
        class="project-research-graph"
        viewBox="0 0 680 720"
        focusable="false"
      >
        <path
          d="M360 355 Q307 287 260 235 Q215 174 150 150
             M260 235 Q276 158 320 110
             M360 355 Q397 251 440 190 Q507 158 585 145
             M440 190 Q489 230 505 300 Q578 282 645 325
             M360 355 Q435 328 505 300
             M360 355 Q451 383 515 445 Q570 487 600 560
             M515 445 Q458 491 385 525 Q369 598 340 655
             M385 525 Q293 502 225 440 Q159 483 155 565
             M225 440 Q148 383 75 385
             M360 355 Q293 411 225 440"
          fill="none"
          stroke="currentColor"
          stroke-width="1.25"
          opacity=".48"
        />
        <g fill="#0b191b" stroke="currentColor" stroke-width="1.25">
          <circle cx="360" cy="355" r="10" fill="none" opacity=".5" />
          <circle cx="360" cy="355" r="4" />
          <circle cx="260" cy="235" r="5" />
          <circle cx="440" cy="190" r="5" />
          <circle cx="505" cy="300" r="5" />
          <circle cx="515" cy="445" r="5" />
          <circle cx="385" cy="525" r="5" />
          <circle cx="225" cy="440" r="5" />
          <circle cx="150" cy="150" r="3.5" />
          <circle cx="320" cy="110" r="3.5" />
          <circle cx="585" cy="145" r="3.5" />
          <circle cx="645" cy="325" r="3.5" />
          <circle cx="600" cy="560" r="3.5" />
          <circle cx="340" cy="655" r="3.5" />
          <circle cx="155" cy="565" r="3.5" />
          <circle cx="75" cy="385" r="3.5" />
        </g>
      </svg>
    </div>
    <div class="relative z-10 min-w-0">
      <h3 class="feature-title">
        <a class="text-paper" href={genomint.path}>
          {genomint.title}
        </a>
      </h3>
      <p class="lead-copy mt-6 max-w-[46ch] text-muted">
        {genomintProject.description}
      </p>
      <a
        class="mt-6 inline-flex min-h-11 items-center border-b border-paper/60 text-sm font-medium text-paper"
        href={genomint.path}
      >
        {genomintProject.linkLabel}
      </a>
    </div>
    <div class="relative z-10 min-w-0 border border-[#8eb7ae]/25 bg-[#071214] p-4 sm:p-6">
      <EvidenceFigure locale={locale} projectId="genomint" compact />
    </div>
  </article>
  <article
    id="project-maestria"
    class="relative my-12 grid gap-12 border-y border-[#87b7dc]/30 bg-linear-to-br from-[#102637]/80 to-[#07121b]/40 px-6 py-12 target:scroll-mt-6 md:my-16 md:p-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:items-center lg:gap-16 lg:p-16"
    tabindex="-1"
  >
    <div class="min-w-0">
      {maestria.relatedProject && (
        <a
          class="text-link mb-7 text-xs uppercase tracking-[0.14em] text-[#abd1ed] underline decoration-[#abd1ed]/40 underline-offset-4"
          href={maestria.relatedProject.href}
        >
          {maestria.relatedProject.label}
          <span class="ml-2" aria-hidden="true">
            ↗
          </span>
        </a>
      )}
      <p class="mb-4 font-mono text-xs leading-relaxed text-muted">
        {maestria.kicker}
      </p>
      <h3 class="feature-title">
        <a href={maestria.path}>{maestria.title}</a>
      </h3>
      <p class="lead-copy mt-6 max-w-[46ch] text-muted">
        {maestriaProject.description}
      </p>
      <p class="mt-5 font-mono text-xs leading-relaxed text-[#abd1ed]">
        {maestriaProject.technologies}
      </p>
      <a
        class="text-link mt-6 border-b border-paper text-sm"
        href={maestria.path}
      >
        {maestriaProject.linkLabel}
        <span class="ml-3" aria-hidden="true">
          →
        </span>
      </a>
    </div>
    <div class="min-w-0">
      <EvidenceFigure locale={locale} projectId="maestria" compact />
    </div>
  </article>
  <div class="grid gap-10 pt-8 lg:grid-cols-[1fr_3fr] lg:gap-16">
    <h3 class="card-title text-muted">{content.projects.otherHeading}</h3>
    <div class="grid gap-12 sm:grid-cols-2 lg:gap-20">
      {supplementary.map((project) => (
        <article
          id={`project-${project.id}`}
          class="min-w-0 target:scroll-mt-8"
          tabindex="-1"
        >
          <h4 class="card-title">{project.title}</h4>
          <p class="body-copy mt-4 text-muted">{project.description}</p>
          <p class="mt-3 font-mono text-xs text-muted">
            {project.technologies}
          </p>
          {project.url && (
            <a class="text-link mt-2 text-sm underline" href={project.url}>
              {project.linkLabel}
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
