---
import {
  type Locale,
  type PortfolioContent,
  type ProjectId,
} from "../data/portfolio";
import ToolIcon from "./ToolIcon.astro";
import ProjectScene from "./ProjectScene.astro";

interface Props {
  content: PortfolioContent;
  locale: Locale;
}
const { content, locale } = Astro.props;
const fr = locale === "fr";
const projectTools: Record<ProjectId, string[]> = {
  genomint: [
    "Python",
    "FastAPI",
    "Pi",
    "LangChain",
    "Haystack",
    "Neo4j",
    "PostgreSQL",
    "Docker",
    "Linux",
  ],
  meddatatrace: ["Python", "NumPy", "Scikit-learn", "Numba", "Matplotlib"],
  sillage: ["Rust", "Slint", "Tantivy", "SQLite", "Tokio"],
  nacre: ["Rust", "C", "Linux"],
  "encrypted-voting": ["Java", "Spring Boot"],
  justsyncit: ["Java", "SQLite", "Jackson", "Kwik", "Bouncy Castle"],
};
const projectConcepts: Record<ProjectId, string[]> = fr
  ? {
      genomint: ["Pangénomie", "Graphes", "Agent IA"],
      meddatatrace: ["Données de santé", "Graphes", "Évaluation temporelle"],
      sillage: ["Lanceur Linux", "Recherche locale", "Extraits sourcés"],
      nacre: ["Compilateur", "Ownership", "Sans GC"],
      "encrypted-voting": ["El Gamal", "Preuves à connaissance zéro"],
      justsyncit: ["Sauvegardes", "Snapshots", "BLAKE3"],
    }
  : {
      genomint: ["Pangenomics", "Graphs", "AI agent"],
      meddatatrace: ["Health data", "Graphs", "Temporal evaluation"],
      sillage: ["Linux launcher", "Local search", "Cited excerpts"],
      nacre: ["Compiler", "Ownership", "No GC"],
      "encrypted-voting": ["El Gamal", "Zero-knowledge proofs"],
      justsyncit: ["Backups", "Snapshots", "BLAKE3"],
    };
const bookTitles = fr
  ? [
      "Atlas",
      "Mémoires",
      "Corpus",
      "Les idées",
      "Archives",
      "Systèmes",
      "Notes",
      "Langages",
      "Recherche",
      "Documents",
      "Index",
      "Savoirs",
    ]
  : [
      "Atlas",
      "Memoirs",
      "Corpus",
      "Ideas",
      "Archives",
      "Systems",
      "Notes",
      "Languages",
      "Research",
      "Documents",
      "Index",
      "Knowledge",
    ];
---

<section
  id="projects"
  class="content-shell section-shell projects-section"
  aria-labelledby="projects-title"
>
  <header class="projects-heading">
    <h2 id="projects-title" class="section-title">
      {content.projects.heading}
    </h2>
    <p class="projects-intro">{content.projects.intro}</p>
  </header>
  <div class="projects-grid">
    {content.projects.entries.map((project, index) => {
      const Surface = project.url ? "a" : "div";
      const Heading = index < 3 ? "h3" : "h4";
      return (
        <Fragment>
          {index === 3 && (
            <h3 class="complementary-heading">
              {content.projects.otherHeading}
            </h3>
          )}
          <article
            id={`project-${project.id}`}
            class:list={[
              "project-tile",
              `tile-${project.id}`,
              { "project-featured": index < 3 },
            ]}
            tabindex="-1"
          >
            <Surface
              class="tile-surface"
              href={project.url}
              aria-label={project.url ? project.title : undefined}
              aria-describedby={`project-${project.id}-description project-${project.id}-tools project-${project.id}-concepts${project.status ? ` project-${project.id}-status` : ""}`}
            >
              <span class="tile-mark" aria-hidden="true">
                {project.url ? "↗" : "◇"}
              </span>
              {project.id === "genomint" && (
                <figure class="genomint-preview">
                  <img
                    src="/images/genomint-explorer-1100.webp"
                    srcset="/images/genomint-explorer-1100.webp 1100w, /images/genomint-explorer.webp 2877w"
                    sizes="(min-width: 100rem) 60vw, (min-width: 64rem) 55vw, calc(100vw - 5rem)"
                    width="2877"
                    height="1743"
                    alt={
                      fr
                        ? "GKG Explorer : filtres, graphe génomique et table de gènes dans l’interface GenomInt."
                        : "GKG Explorer: filters, genomic graph and gene table in the GenomInt interface."
                    }
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>
                    GKG Explorer <span aria-hidden="true">—</span>{" "}
                    {fr ? "interface GenomInt" : "GenomInt interface"}
                  </figcaption>
                </figure>
              )}
              {project.id === "sillage" && (
                <div class="tile-art library-art" aria-hidden="true">
                  {[0, 1, 2, 3].map((row) => (
                    <div class="bookshelf">
                      {Array.from({ length: 12 }, (_, column) => {
                        const i = row * 12 + column;
                        return (
                          <span
                            class:list={[
                              "library-book",
                              `binding-${(column * 5 + row * 2 + Math.floor(column / 3)) % 6}`,
                            ]}
                            style={`--book-height: ${72 + ((i * 13) % 27)}%; --book-width: ${7 + ((i * 7) % 9)}`}
                          >
                            <span class="book-volume">
                              <span class="book-spine">
                                <span class="book-title">
                                  {
                                    bookTitles[
                                      (column + row * 3) % bookTitles.length
                                    ]
                                  }
                                </span>
                                <span class="book-imprint">
                                  {fr ? "études" : "essays"}
                                </span>
                              </span>
                              <span class="book-cover">
                                <span class="cover-series">
                                  {fr
                                    ? "Bibliothèque des idées"
                                    : "Library of ideas"}
                                </span>
                                <span class="cover-title">
                                  {
                                    bookTitles[
                                      (column + row * 3) % bookTitles.length
                                    ]
                                  }
                                </span>
                                <span class="cover-rule"></span>
                              </span>
                              <span class="book-pages"></span>
                            </span>
                          </span>
                        );
                      })}
                    </div>
                  ))}
                </div>
              )}
              {project.id === "nacre" && (
                <div class="tile-art compiler-art" aria-hidden="true">
                  <div class="compiler-source">
                    <span class="compiler-file">hello.ncr</span>
                    <code>
                      <span>void</span>
                      {' main() {\n  println("Hello, native.");\n}'}
                    </code>
                  </div>
                  <div class="compiler-path">
                    <span>Nacre</span>
                    <i>↓</i>
                    <span>C11</span>
                    <i>↓</i>
                    <span class="compiler-native">
                      1010<span>native</span>0110
                    </span>
                  </div>
                </div>
              )}
              {(project.id === "meddatatrace" ||
                project.id === "encrypted-voting" ||
                project.id === "justsyncit") && (
                <div class="tile-scene">
                  <ProjectScene kind={project.id} locale={locale} />
                </div>
              )}
              <div class="tile-copy">
                {index < 3 && (
                  <p class="tile-context">
                    {project.id === "genomint"
                      ? fr
                        ? "CIRAD · Génomique"
                        : "CIRAD · Genomics"
                      : project.id === "meddatatrace"
                        ? fr
                          ? "Recherche personnelle"
                          : "Independent research"
                        : fr
                          ? "Brio · Contribution"
                          : "Brio · Contributor"}
                  </p>
                )}
                <Heading>
                  {project.title
                    .split(/(?<=[a-z])(?=[A-Z])/)
                    .map((part, index) => (
                      <Fragment>
                        {index > 0 && <wbr />}
                        {part}
                      </Fragment>
                    ))}
                </Heading>
                <p
                  id={`project-${project.id}-description`}
                  class="tile-description"
                >
                  {project.description}
                </p>
                <ul id={`project-${project.id}-tools`} class="tile-tools">
                  {projectTools[project.id].map((name) => (
                    <li title={name}>
                      <span class="sr-only">{name}</span>
                      <ToolIcon name={name} />
                    </li>
                  ))}
                </ul>
                {project.status && (
                  <p id={`project-${project.id}-status`} class="tile-status">
                    {project.status}
                  </p>
                )}
                <p id={`project-${project.id}-concepts`} class="tile-concepts">
                  {projectConcepts[project.id].join(" · ")}
                </p>
                {project.linkLabel && (
                  <span class="tile-link" aria-hidden="true">
                    {project.linkLabel} →
                  </span>
                )}
              </div>
            </Surface>
          </article>
        </Fragment>
      );
    })}
  </div>
</section>

<script>
  import "../scripts/sillage-library";
</script>

<style>
  .projects-heading {
    display: grid;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .projects-intro {
    max-width: 58ch;
    color: var(--color-muted);
    font-size: 1.0625rem;
    line-height: 1.7;
    text-wrap: pretty;
  }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: auto;
    gap: 1.25rem;
    height: auto;
  }
  .complementary-heading {
    grid-column: 1 / -1;
    margin-top: 2rem;
    margin-bottom: 0.25rem;
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-muted);
  }
  .project-featured {
    min-height: 28rem;
  }
  .project-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    grid-column: span 4;
    --tile-padding: clamp(1.15rem, 2vw, 2rem);
    border: 1px solid var(--tile-border);
    background: var(--tile-bg);
    color: #f1eee5;
    border-radius: 1rem;
    scroll-margin-top: 6rem;
    overflow: hidden;
    isolation: isolate;
  }
  .tile-surface {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    width: 100%;
    padding: var(--tile-padding);
    color: inherit;
    text-decoration: none;
  }
  .tile-genomint {
    --tile-bg: #0c1a1b;
    --tile-border: #345451;
    --tile-accent: #b0ded0;
    grid-column: 1 / -1;
    border-inline: 0;
    border-radius: 0;
    background: transparent;
  }
  .tile-genomint .tile-surface {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 4rem);
    padding: 2.5rem 0;
  }
  .tile-genomint .tile-copy {
    grid-column: 1;
    grid-row: 1;
    margin: 0;
  }
  .genomint-preview {
    grid-column: 2;
    min-width: 0;
    margin: 0;
  }
  .genomint-preview img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid #657c76;
    border-radius: 0.25rem;
  }
  .genomint-preview figcaption {
    margin-top: 0.75rem;
    color: var(--color-muted);
    font-size: 0.75rem;
    line-height: 1.5;
  }
  .tile-context {
    margin-bottom: 0.75rem;
    color: var(--tile-accent);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .tile-genomint .tile-copy :is(h3, h4) {
    font-size: clamp(2.5rem, 4vw, 4rem);
  }
  .tile-nacre .tile-surface {
    padding-top: calc(var(--tile-padding) + 10rem);
  }
  .tile-meddatatrace {
    grid-column: span 5;
    --tile-bg: #15262d;
    --tile-border: #52737c;
    --tile-accent: #b4dce1;
    background-image: radial-gradient(
      ellipse at top right,
      #294e5b80,
      transparent 70%
    );
  }
  .tile-status {
    margin-top: 1rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--tile-accent);
  }
  .tile-link {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.8125rem;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .tile-sillage {
    --tile-bg: #182330;
    --tile-border: #435367;
    --tile-accent: #bdd1ec;
    grid-column: span 7;
  }
  .tile-sillage .tile-surface {
    padding-left: 43%;
    justify-content: center;
  }
  .tile-sillage .library-art {
    inset: 0 auto 0 0;
    width: 36%;
    padding-inline: 0.35rem;
    border-inline-width: 5px;
  }
  .tile-sillage .tile-copy {
    margin-top: 0;
  }
  .tile-nacre {
    --tile-bg: #252733;
    --tile-border: #575b76;
    --tile-accent: #d1cbee;
  }
  .tile-encrypted-voting {
    --tile-bg: #29231e;
    --tile-border: #605043;
    --tile-accent: #dbc09c;
    grid-column: span 4;
  }
  .tile-justsyncit {
    --tile-bg: #202b2d;
    --tile-border: #496366;
    --tile-accent: #b1d9d5;
    grid-column: span 4;
  }
  .tile-mark {
    position: absolute;
    top: var(--tile-padding);
    right: var(--tile-padding);
    z-index: 2;
    color: var(--tile-accent);
    font-size: 1.1rem;
    pointer-events: none;
  }
  .tile-art {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .library-art {
    display: flex;
    flex-direction: column;
    inset: -1.5rem -1.75rem;
    padding: 0 1rem;
    background: #241f1a;
    border-inline: 12px solid #514333;
    box-shadow: inset 0 0 0 3px #1b1713;
  }
  .bookshelf {
    position: relative;
    display: flex;
    flex: 1;
    min-height: 0;
    align-items: flex-end;
    gap: 3px;
    padding: 1rem 0.2rem 0;
    border-bottom: 7px solid #756957;
    box-shadow: 0 3px 0 #171411;
  }
  .library-book {
    --book-depth: clamp(3.5rem, 7vw, 6rem);
    position: relative;
    flex: var(--book-width) 1 0;
    min-width: 0;
    height: var(--book-height);
    color: var(--book-ink, #e6e1d5);
    z-index: 0;
  }
  .book-volume {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transform-origin: 50% 100%;
  }
  .library-book[data-book-active] {
    z-index: 2;
    perspective: 1000px;
    perspective-origin: 50% 100%;
  }
  .library-book[data-book-active] .book-volume {
    transform-style: preserve-3d;
    transform: none;
    will-change: transform;
  }
  .bookshelf:has(.library-book[data-book-active]) {
    z-index: 2;
  }
  .library-book[data-book-active] .book-cover {
    display: flex;
    box-shadow:
      inset 3px 0 5px #0003,
      3px 4px 8px #0004;
  }
  .library-book[data-book-active] .book-pages {
    display: block;
  }
  .library-book[data-book-active] .book-spine {
    backface-visibility: hidden;
  }
  .book-spine::before {
    content: "";
    position: absolute;
    inset: 2px 3px auto;
    height: 2px;
    background: #ddd4bf;
    border-radius: 2px 2px 0 0;
  }
  .book-spine {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.9rem 0.1rem 0.6rem;
    background-color: var(--binding);
    background-image: linear-gradient(
      90deg,
      #00000015,
      transparent 15%,
      #ffffff09 38%,
      transparent 75%,
      #00000020
    );
    border-radius: 3px 2px 2px 3px;
    border-left: 1px solid #ffffff18;
    border-right: 1px solid #00000025;
    box-shadow: 1px 0 2px #00000040;
    backface-visibility: visible;
  }
  .book-cover {
    position: absolute;
    left: 100%;
    top: 0;
    width: var(--book-depth);
    height: 100%;
    display: none;
    flex-direction: column;
    padding: 0.8rem;
    background: var(--binding);
    border: 1px solid #00000030;
    border-radius: 0 3px 3px 0;
    transform-origin: 0 50%;
    transform: rotateY(90deg);
    backface-visibility: hidden;
    pointer-events: none;
  }
  .cover-series {
    font-size: 0.4rem;
    line-height: 1.5;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.7;
  }
  .cover-title {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: 0.85rem;
    line-height: 1.2;
  }
  .cover-rule {
    width: 35%;
    border-top: 1px solid currentColor;
    margin-top: 0.7rem;
    opacity: 0.5;
  }
  .book-pages {
    display: none;
    position: absolute;
    top: 1px;
    left: 2px;
    width: calc(100% - 4px);
    height: calc(var(--book-depth) - 3px);
    background: repeating-linear-gradient(
      90deg,
      #d4cbb8 0 1px,
      #e5dfce 1px 2px
    );
    border: 1px solid #a99f8b;
    transform-origin: 50% 0;
    transform: rotateX(90deg) translateY(-100%);
    backface-visibility: hidden;
    pointer-events: none;
  }
  .book-imprint {
    margin-top: auto;
    padding-top: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.4rem;
    font-style: italic;
    opacity: 0.65;
  }
  .library-book:nth-child(3n) .book-title {
    font-style: italic;
  }
  .binding-0 {
    --binding: #5e6c62;
  }
  .binding-1 {
    --binding: #82786b;
  }
  .binding-2 {
    --binding: #b3a791;
    --book-ink: #413c33;
  }
  .binding-3 {
    --binding: #7c655e;
  }
  .binding-4 {
    --binding: #596572;
  }
  .binding-5 {
    --binding: #96907e;
    --book-ink: #34372f;
  }
  .book-title {
    writing-mode: vertical-rl;
    font-family: var(--font-display);
    font-size: clamp(0.6rem, 0.9vw, 0.75rem);
    letter-spacing: 0.01em;
    opacity: 0.85;
    overflow: hidden;
    white-space: nowrap;
  }
  .tile-copy {
    margin-top: auto;
    position: relative;
    z-index: 2;
  }
  .project-tile:not(.tile-genomint) .tile-copy::before {
    content: "";
    position: absolute;
    inset: -2.5rem calc(-1 * var(--tile-padding)) calc(-1 * var(--tile-padding));
    z-index: -1;
    background: linear-gradient(180deg, transparent, var(--tile-bg) 2rem);
    pointer-events: none;
  }
  .tile-sillage .tile-copy::before {
    background: linear-gradient(180deg, transparent, rgb(18 17 16 / 0.94) 2rem);
  }
  .tile-nacre .tile-copy::before {
    background: linear-gradient(180deg, transparent, #252733 2rem);
  }
  .tile-sillage .tile-copy {
    pointer-events: none;
  }
  .tile-copy :is(h3, h4) {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.6vw, 2.8rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }
  .tile-description {
    max-width: 48ch;
    font-size: 1rem;
    line-height: 1.7;
    margin-top: 1rem;
    color: #e0e3df;
  }
  .tile-concepts {
    margin-top: 0.8rem;
    padding-top: 0.65rem;
    border-top: 1px solid var(--tile-border);
    color: var(--tile-accent);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .tile-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    margin-block: 0.8rem;
    color: var(--tile-accent);
  }
  .tile-tools li {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    pointer-events: auto;
  }
  .tile-tools li > svg {
    width: 1.5rem;
    height: 1.5rem;
  }
  .tile-encrypted-voting :is(h3, h4),
  .tile-justsyncit :is(h3, h4) {
    font-size: 1.5rem;
  }
  .tile-encrypted-voting .tile-description,
  .tile-justsyncit .tile-description {
    font-size: 1rem;
    line-height: 1.7;
    margin-top: 0.75rem;
  }
  .compiler-art {
    padding: 3.5rem 1.5rem 0;
    color: var(--tile-accent);
    background: radial-gradient(ellipse at 80% 10%, #55527455, transparent 65%);
    font-family: monospace;
  }
  .compiler-source {
    padding: 1rem;
    border: 1px solid #a6a0c13d;
    border-radius: 0.4rem;
    background: #161923;
    transform: rotate(-4deg);
    font-size: clamp(0.65rem, 0.85vw, 0.85rem);
    box-shadow: 0 8px 0 #16192355;
  }
  .compiler-file {
    display: block;
    padding-bottom: 0.75rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid #a6a0c12b;
    color: #aaa8bb;
  }
  .compiler-source code {
    white-space: pre;
    line-height: 1.8;
  }
  .compiler-source code > span {
    color: #b7a1e8;
  }
  .compiler-path {
    display: flex;
    align-items: center;
    justify-content: space-around;
    margin-top: 1.5rem;
    font-size: 0.8rem;
  }
  .compiler-path i {
    transform: rotate(-90deg);
    opacity: 0.5;
  }
  .compiler-native {
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    color: #9dafa7;
  }
  .compiler-native span {
    display: block;
    font-size: 0.85rem;
    color: #e1e8e0;
    letter-spacing: 0;
  }
  .project-tile:focus-within {
    outline: 2px solid var(--tile-accent);
    outline-offset: 3px;
  }
  .project-tile:has(a):is(:hover, :focus-within) {
    border-color: var(--tile-accent);
  }
  .tile-surface:focus-visible {
    outline: 2px solid var(--tile-accent);
    outline-offset: 4px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .tile-nacre .compiler-source {
      transition: transform 320ms cubic-bezier(0.2, 0.7, 0.25, 1);
    }
    .tile-nacre:is(:hover, :focus-within) .compiler-source {
      transform: translateY(-8px) rotate(-1deg) scale(1.015);
    }
    .tile-nacre:is(:hover, :focus-within) .compiler-path > * {
