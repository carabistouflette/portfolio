---
import {
  type Locale,
  type PortfolioContent,
  type ProjectId,
} from "../data/portfolio";
import ToolIcon from "./ToolIcon.astro";

interface Props {
  content: PortfolioContent;
  locale: Locale;
}
const { content, locale } = Astro.props;
const fr = locale === "fr";
const descriptions = fr
  ? {
      genomint: "Explorer la pangénomie.",
      sillage: "Lancer des apps, retrouver un passage.",
      nacre: "Une syntaxe familière, un exécutable natif.",
      "encrypted-voting": "Vérifier sans révéler les votes.",
      justsyncit: "Sauvegarder, dédupliquer, restaurer.",
    }
  : {
      genomint: "Explore pangenomics.",
      sillage: "Launch apps, find a passage.",
      nacre: "Familiar syntax, native executables.",
      "encrypted-voting": "Verify without revealing votes.",
      justsyncit: "Back up, deduplicate, restore.",
    };
const projectTools: Record<ProjectId, string[]> = {
  genomint: [
    "Python",
    "FastAPI",
    "Pi",
    "LangChain",
    "Haystack",
    "Neo4j",
    "PostgreSQL",
    "Docker",
    "Linux",
  ],
  sillage: ["Rust", "Slint", "Tantivy", "SQLite", "Tokio"],
  nacre: ["Rust", "C", "Linux"],
  "encrypted-voting": ["Java", "Spring Boot"],
  justsyncit: ["Java"],
};
const projectConcepts: Record<ProjectId, string[]> = fr
  ? {
      genomint: ["Pangénomie", "Graphes", "Agent IA"],
      sillage: ["Lanceur Linux", "Recherche locale", "Extraits sourcés"],
      nacre: ["Compilateur", "Ownership", "Sans GC"],
      "encrypted-voting": ["El Gamal", "Preuves à connaissance zéro"],
      justsyncit: ["Sauvegardes", "Snapshots", "BLAKE3"],
    }
  : {
      genomint: ["Pangenomics", "Graphs", "AI agent"],
      sillage: ["Linux launcher", "Local search", "Cited excerpts"],
      nacre: ["Compiler", "Ownership", "No GC"],
      "encrypted-voting": ["El Gamal", "Zero-knowledge proofs"],
      justsyncit: ["Backups", "Snapshots", "BLAKE3"],
    };
// Stylized category network based on the GenomInt explorer, not live metrics.
const nodes: [number, number, number, string, string][] = [
  [245, 75, 9, "phylotree", "#df6aab"],
  [330, 105, 10, "organism", "#69a8df"],
  [115, 155, 23, "ontologies", "#89979d"],
  [305, 170, 36, "pangene", "#e8b34e"],
  [400, 160, 20, "consensus", "#df6aab"],
  [245, 205, 28, "gene family", "#df6aab"],
  [65, 235, 36, "polypeptide", "#4cc48b"],
  [170, 255, 24, "ncRNA", "#4cc48b"],
  [355, 245, 24, "synteny block", "#df6aab"],
  [470, 220, 26, "TE clique", "#e8b34e"],
  [295, 280, 10, "analysis", "#89979d"],
  [400, 290, 10, "assembly", "#69a8df"],
  [30, 345, 33, "dbxref", "#89979d"],
  [140, 350, 34, "mRNA", "#4cc48b"],
  [255, 365, 33, "gene", "#4cc48b"],
  [355, 360, 43, "variant", "#e8b34e"],
  [450, 335, 30, "TE copy", "#89979d"],
  [70, 420, 11, "RNAseq sample", "#ae81dc"],
  [130, 460, 32, "UTR", "#4cc48b"],
  [295, 445, 21, "source file", "#89979d"],
  [415, 430, 14, "sequence", "#69a8df"],
  [215, 555, 37, "CDS", "#4cc48b"],
  [300, 535, 22, "genomic island", "#df9152"],
  [420, 540, 45, "sequence segment", "#e8b34e"],
  [90, 570, 9, "RNAseq dataset", "#ae81dc"],
  [420, 680, 40, "SNP allele", "#e8b34e"],
];
const edges = [
  [0, 1],
  [0, 5],
  [1, 3],
  [1, 4],
  [2, 6],
  [2, 13],
  [2, 14],
  [3, 5],
  [3, 8],
  [3, 10],
  [3, 15],
  [4, 8],
  [4, 9],
  [5, 7],
  [5, 8],
  [5, 14],
  [6, 7],
  [6, 12],
  [6, 13],
  [7, 13],
  [7, 14],
  [8, 10],
  [8, 11],
  [8, 14],
  [9, 15],
  [9, 16],
  [10, 14],
  [10, 15],
  [11, 16],
  [11, 20],
  [12, 13],
  [13, 14],
  [13, 18],
  [13, 21],
  [14, 15],
  [14, 18],
  [14, 19],
  [14, 21],
  [15, 16],
  [15, 19],
  [15, 20],
  [15, 23],
  [16, 20],
  [17, 18],
  [17, 24],
  [18, 21],
  [19, 22],
  [19, 23],
  [20, 23],
  [21, 22],
  [22, 23],
  [23, 25],
];
const bookTitles = fr
  ? [
      "Atlas",
      "Mémoires",
      "Corpus",
      "Les idées",
      "Archives",
      "Systèmes",
      "Notes",
      "Langages",
      "Recherche",
      "Documents",
      "Index",
      "Savoirs",
    ]
  : [
      "Atlas",
      "Memoirs",
      "Corpus",
      "Ideas",
      "Archives",
      "Systems",
      "Notes",
      "Languages",
      "Research",
      "Documents",
      "Index",
      "Knowledge",
    ];
---

<section
  id="projects"
  class="content-shell section-shell projects-section"
  aria-labelledby="projects-title"
>
  <h2 id="projects-title" class="section-title">
    {content.projects.heading}
  </h2>
  <div class="projects-grid">
    {content.projects.entries.map((project) => {
      const Surface = project.url ? "a" : "div";
      return (
        <article
          id={`project-${project.id}`}
          class:list={["project-tile", `tile-${project.id}`]}
          tabindex="-1"
        >
          <Surface
            class="tile-surface"
            href={project.url}
            aria-label={project.url ? project.title : undefined}
            aria-describedby={`project-${project.id}-description project-${project.id}-tools project-${project.id}-concepts`}
          >
            <span class="tile-mark" aria-hidden="true">
              {project.url ? "↗" : "◇"}
            </span>
            {project.id === "genomint" && (
              <div class="tile-art graph-art" aria-hidden="true">
                <svg
                  data-project-graph
                  viewBox="0 0 510 720"
                  preserveAspectRatio="xMidYMid slice"
                  focusable="false"
                >
                  <defs>
                    <mask
                      id="project-graph-links"
                      maskUnits="userSpaceOnUse"
                      x="0"
                      y="0"
                      width="510"
                      height="720"
                    >
                      <rect width="510" height="720" fill="white" />
                      {nodes.map(([x, y, radius]) => (
                        <circle cx={x} cy={y} r={radius + 4} fill="black" />
                      ))}
                    </mask>
                  </defs>
                  <g class="graph-edges" mask="url(#project-graph-links)">
                    {edges.map(([a, b]) => (
                      <line
                        x1={nodes[a][0]}
                        y1={nodes[a][1]}
                        x2={nodes[b][0]}
                        y2={nodes[b][1]}
                        stroke={nodes[a][4]}
                        vector-effect="non-scaling-stroke"
                      />
                    ))}
                  </g>
                  {nodes.map(([x, y, radius, label, color]) => (
                    <g
                      class="graph-node"
                      data-x={x}
                      data-y={y}
                      style={`--node-color: ${color}`}
                    >
                      <circle class="node-halo" cx={x} cy={y} r={radius + 9} />
                      <circle class="node-core" cx={x} cy={y} r={radius} />
                      <text
                        class="node-label"
                        x={x}
                        y={y + radius + 15}
                        text-anchor="middle"
                      >
                        {label}
                      </text>
                    </g>
                  ))}
                </svg>
              </div>
            )}
            {project.id === "sillage" && (
              <div class="tile-art library-art" aria-hidden="true">
                {[0, 1, 2, 3].map((row) => (
                  <div class="bookshelf">
                    {Array.from({ length: 12 }, (_, column) => {
                      const i = row * 12 + column;
                      return (
                        <span
                          class:list={[
                            "library-book",
                            `binding-${(column * 5 + row * 2 + Math.floor(column / 3)) % 6}`,
                          ]}
                          style={`--book-height: ${72 + ((i * 13) % 27)}%; --book-width: ${7 + ((i * 7) % 9)}`}
                        >
                          <span class="book-volume">
                            <span class="book-spine">
                              <span class="book-title">
                                {
                                  bookTitles[
                                    (column + row * 3) % bookTitles.length
                                  ]
                                }
                              </span>
                              <span class="book-imprint">
                                {fr ? "études" : "essays"}
                              </span>
                            </span>
                            <span class="book-cover">
                              <span class="cover-series">
                                {fr
                                  ? "Bibliothèque des idées"
                                  : "Library of ideas"}
                              </span>
                              <span class="cover-title">
                                {
                                  bookTitles[
                                    (column + row * 3) % bookTitles.length
                                  ]
                                }
                              </span>
                              <span class="cover-rule"></span>
                            </span>
                            <span class="book-pages"></span>
                          </span>
                        </span>
                      );
                    })}
                  </div>
                ))}
              </div>
            )}
            {project.id === "nacre" && (
              <div class="tile-art compiler-art" aria-hidden="true">
                <div class="compiler-source">
                  <span class="compiler-file">hello.ncr</span>
                  <code>
                    <span>void</span>
                    {' main() {\n  println("Hello, native.");\n}'}
                  </code>
                </div>
                <div class="compiler-path">
                  <span>Nacre</span>
                  <i>↓</i>
                  <span>C11</span>
                  <i>↓</i>
                  <span class="compiler-native">
                    1010<span>native</span>0110
                  </span>
                </div>
              </div>
            )}
            {project.id === "encrypted-voting" && (
              <div class="ballot-art" aria-hidden="true">
                <span class="ballot-paper">✓</span>
                <span class="ballot-slot"></span>
                <span class="ballot-proof">∑ / ≠</span>
              </div>
            )}
            {project.id === "justsyncit" && (
              <div class="sync-art" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
                <i>↻</i>
              </div>
            )}
            <div class="tile-copy">
              <h3>{project.title}</h3>
              <ul id={`project-${project.id}-tools`} class="tile-tools">
                {projectTools[project.id].map((name) => (
                  <li title={name}>
                    <span class="sr-only">{name}</span>
                    <ToolIcon name={name} />
                  </li>
                ))}
              </ul>
              <p
                id={`project-${project.id}-description`}
                class="tile-description"
              >
                {descriptions[project.id]}
              </p>
              <p id={`project-${project.id}-concepts`} class="tile-concepts">
                {projectConcepts[project.id].join(" · ")}
              </p>
            </div>
          </Surface>
        </article>
      );
    })}
  </div>
</section>

<script>
  import { onPageLoad } from "../scripts/page-lifecycle";

  onPageLoad((signal) => {
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const activeBooks = new Map<HTMLElement, Animation | null>();
    const rest = "rotateY(-4deg)";
    const lifted = "translateZ(calc(var(--book-depth) + 16px)) rotateY(-4deg)";
    const extracted =
      "translateZ(calc(var(--book-depth) + 16px)) rotateX(-8deg) rotateY(-27deg)";
    const stop = (book: HTMLElement) => {
      const animation = activeBooks.get(book);
      if (animation) {
        animation.onfinish = null;
        animation.cancel();
      }
    };
    const release = (book: HTMLElement) => {
      stop(book);
      activeBooks.delete(book);
      book.style.removeProperty("transform");
      book.parentElement?.removeAttribute("data-book-active");
    };
    const releaseAll = () => {
      for (const book of activeBooks.keys()) release(book);
    };
    for (const slot of document.querySelectorAll<HTMLElement>(
      ".library-book",
    )) {
      const book = slot.querySelector<HTMLElement>(".book-volume");
      if (!book) continue;
      slot.addEventListener(
        "pointerenter",
        (event) => {
          if (event.pointerType === "touch" || reduced.matches) return;
          const start = activeBooks.has(book)
            ? getComputedStyle(book).transform
            : rest;
          stop(book);
          slot.setAttribute("data-book-active", "");
          book.style.transform = extracted;
          // One transform owns both phases; no nested compositor animations.
          const animation = book.animate(
            [
              { transform: start, easing: "ease" },
              {
                transform: lifted,
                offset: 0.45,
                easing: "cubic-bezier(.2,.7,.25,1)",
              },
              { transform: extracted },
            ],
            { duration: 400, fill: "both" },
          );
          activeBooks.set(book, animation);
          animation.onfinish = () => {
            if (activeBooks.get(book) !== animation) return;
            animation.onfinish = null;
            animation.cancel();
            activeBooks.set(book, null);
          };
        },
        { signal },
      );
      slot.addEventListener(
        "pointerleave",
        () => {
          if (!activeBooks.has(book)) return;
          const start = getComputedStyle(book).transform;
          const depth = new DOMMatrixReadOnly(start).m43;
          stop(book);
          book.style.transform = rest;
          // Interrupted extraction returns from its current depth, not the end.
          const animation = book.animate(
            [
              { transform: start, easing: "cubic-bezier(.2,.7,.25,1)" },
              {
                transform: `translateZ(${depth}px) ${rest}`,
                offset: 0.55,
                easing: "ease",
              },
              { transform: rest },
            ],
            { duration: 400, fill: "both" },
          );
          activeBooks.set(book, animation);
          animation.onfinish = () => {
            if (activeBooks.get(book) === animation) release(book);
          };
        },
        { signal },
      );
    }
    reduced.addEventListener("change", releaseAll, { signal });
    signal.addEventListener("abort", releaseAll, { once: true });
    const graph = document.querySelector<SVGSVGElement>("[data-project-graph]");
    const card = graph?.closest<HTMLElement>(".project-tile");
    if (!graph || !card) return;
    const nodes = Array.from(
      graph.querySelectorAll<SVGGElement>(".graph-node"),
    );
    const positions = nodes.map((node) => [
      Number(node.dataset.x),
      Number(node.dataset.y),
    ]);
    const near = new Uint8Array(nodes.length);
    let frame = 0;
    let x = 0;
    let y = 0;
    const reset = () => {
      cancelAnimationFrame(frame);
      frame = 0;
      for (let i = 0; i < nodes.length; i++) {
        if (!near[i]) continue;
        near[i] = 0;
        nodes[i].classList.remove("is-near");
      }
    };
    const update = () => {
      frame = 0;
      const matrix = graph.getScreenCTM();
      if (!matrix) return;
      // The graph and its entrance use 2D affine transforms. Apply the
      // inverse directly instead of allocating an inverse matrix and point.
      const determinant = matrix.a * matrix.d - matrix.b * matrix.c;
      if (!determinant) return;
      const inverse = 1 / determinant;
      const clientX = x - matrix.e;
      const clientY = y - matrix.f;
      const graphX = (matrix.d * clientX - matrix.c * clientY) * inverse;
      const graphY = (matrix.a * clientY - matrix.b * clientX) * inverse;
      for (let i = 0; i < nodes.length; i++) {
        const dx = positions[i][0] - graphX;
        const dy = positions[i][1] - graphY;
        const value = dx * dx + dy * dy < 85 * 85 ? 1 : 0;
        if (value === near[i]) continue;
        near[i] = value;
        nodes[i].classList.toggle("is-near", value === 1);
      }
    };
    card.addEventListener(
      "pointermove",
      (event) => {
        if (event.pointerType === "touch" || reduced.matches) return;
        x = event.clientX;
        y = event.clientY;
        if (frame) return;
        frame = requestAnimationFrame(update);
      },
      { passive: true, signal },
    );
    card.addEventListener("pointerleave", reset, { signal });
    reduced.addEventListener("change", reset, { signal });
    signal.addEventListener("abort", reset, { once: true });
  });
</script>

<style>
  .projects-section h2 {
    margin-bottom: 1.5rem;
  }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-template-rows: minmax(0, 2fr) minmax(0, 1fr);
    gap: 1rem;
    height: clamp(36rem, calc(100svh - 12rem), 44rem);
  }
  .project-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    grid-column: span 2;
    --tile-padding: clamp(1.15rem, 2vw, 2rem);
    border: 1px solid var(--tile-border);
    background: var(--tile-bg);
    color: #f1eee5;
    border-radius: 0.35rem;
    scroll-margin-top: 6rem;
    overflow: hidden;
    isolation: isolate;
  }
  .tile-surface {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    width: 100%;
    padding: var(--tile-padding);
    color: inherit;
    text-decoration: none;
  }
  .tile-genomint {
    --tile-bg: #0c2222;
    --tile-border: #345451;
    --tile-accent: #b0ded0;
    grid-column: span 2;
  }
  .tile-sillage {
    --tile-bg: #182330;
    --tile-border: #435367;
    --tile-accent: #bdd1ec;
    grid-column: span 2;
  }
  .tile-nacre {
    --tile-bg: #252733;
    --tile-border: #575b76;
    --tile-accent: #d1cbee;
  }
  .tile-encrypted-voting {
    --tile-bg: #29231e;
    --tile-border: #605043;
    --tile-accent: #dbc09c;
    grid-column: span 3;
  }
  .tile-justsyncit {
    --tile-bg: #202b2d;
    --tile-border: #496366;
    --tile-accent: #b1d9d5;
    grid-column: span 3;
  }
  .tile-mark {
    position: absolute;
    top: var(--tile-padding);
    right: var(--tile-padding);
    z-index: 2;
    color: var(--tile-accent);
    font-size: 1.1rem;
    pointer-events: none;
  }
  .tile-art {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .tile-genomint::before,
  .tile-sillage::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgb(5 15 17 / 0.85),
      transparent 22%,
      transparent 38%,
      rgb(5 15 17 / 0.75) 64%,
      #091718 100%
    );
  }
  .tile-sillage::before {
    background: linear-gradient(
      180deg,
      rgb(18 17 16 / 0.8),
      transparent 18%,
      transparent 35%,
      rgb(18 17 16 / 0.82) 66%,
      #121110 100%
    );
  }
  .graph-art {
    background-color: #102523;
    background-image: radial-gradient(#a9c8ba24 1px, transparent 1px);
    background-size: 22px 22px;
  }
  .graph-art svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .graph-edges {
    stroke-width: 1;
    stroke-linecap: round;
    opacity: 0.65;
  }
  .node-core {
    fill: var(--node-color);
    fill-opacity: 0.7;
    stroke: var(--node-color);
    stroke-width: 1;
  }
  .node-halo {
    fill: var(--node-color);
    opacity: 0;
  }
  .graph-node.is-near .node-core {
    fill-opacity: 1;
    stroke: #e9f8ed;
    stroke-width: 2;
  }
  .graph-node.is-near .node-halo {
    opacity: 0.2;
  }
  .node-label {
    fill: #d5e3d8;
    font-size: 10px;
    letter-spacing: 0.025em;
  }
  .library-art {
    display: flex;
    flex-direction: column;
    inset: -1.5rem -1.75rem;
    padding: 0 1rem;
    background: #241f1a;
    border-inline: 12px solid #514333;
    box-shadow: inset 0 0 0 3px #1b1713;
  }
  .bookshelf {
    position: relative;
    display: flex;
    flex: 1;
    min-height: 0;
    align-items: flex-end;
    gap: 3px;
    padding: 1rem 0.2rem 0;
    border-bottom: 7px solid #756957;
    box-shadow: 0 3px 0 #171411;
  }
  .library-book {
    --book-depth: clamp(3.5rem, 7vw, 6rem);
    position: relative;
    flex: var(--book-width) 1 0;
    min-width: 0;
    height: var(--book-height);
    color: var(--book-ink, #e6e1d5);
    z-index: 0;
  }
  .book-volume {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transform-origin: 50% 100%;
  }
  .library-book[data-book-active] {
    z-index: 2;
    perspective: 850px;
    perspective-origin: 50% 100%;
  }
  .library-book[data-book-active] .book-volume {
    transform-style: preserve-3d;
    transform: rotateY(-4deg);
    will-change: transform;
  }
  .library-book[data-book-active] .book-cover {
    display: flex;
  }
  .library-book[data-book-active] .book-pages {
    display: block;
  }
  .library-book[data-book-active] .book-spine {
    backface-visibility: hidden;
  }
  .book-spine::before {
    content: "";
    position: absolute;
    inset: 2px 3px auto;
    height: 2px;
    background: #ddd4bf;
    border-radius: 2px 2px 0 0;
  }
  .book-spine {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.9rem 0.1rem 0.6rem;
    background-color: var(--binding);
    background-image: linear-gradient(
      90deg,
      #00000015,
      transparent 15%,
      #ffffff09 38%,
      transparent 75%,
      #00000020
    );
    border-radius: 3px 2px 2px 3px;
    border-left: 1px solid #ffffff18;
    border-right: 1px solid #00000025;
    box-shadow: 1px 0 2px #00000040;
    backface-visibility: visible;
  }
  .book-cover {
    position: absolute;
    left: 100%;
    top: 0;
    width: var(--book-depth);
    height: 100%;
    display: none;
    flex-direction: column;
    padding: 0.8rem;
    background: var(--binding);
    border: 1px solid #00000030;
    border-radius: 0 3px 3px 0;
    transform-origin: 0 50%;
    transform: rotateY(90deg);
    backface-visibility: hidden;
    pointer-events: none;
  }
  .cover-series {
    font-size: 0.4rem;
    line-height: 1.5;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.7;
  }
  .cover-title {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: 0.85rem;
    line-height: 1.2;
