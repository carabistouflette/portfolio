---
import BaseLayout from "../layouts/BaseLayout.astro";
import Contact from "./Contact.astro";
import Journey from "./Journey.astro";
import Hero from "./Hero.astro";
import SelectedProjects from "./SelectedProjects.astro";
import Skills from "./Skills.astro";
import SelectedContributions from "./SelectedContributions.astro";
import Personal from "./Personal.astro";
import type { Locale, PortfolioContent } from "../data/portfolio";

interface Props {
  locale: Locale;
  content: PortfolioContent;
}

const { locale, content } = Astro.props;
const canonicalPath = locale === "fr" ? "/" : "/en/";
---
<BaseLayout locale={locale} content={content} canonicalPath={canonicalPath}>
  <div class="portfolio-page">
    <div class="portfolio-composition">
      <main id="main">
        <Hero content={content} />
        <SelectedProjects content={content} locale={locale} />
        <Skills content={content} />
        <Journey content={content} />
        <SelectedContributions content={content} locale={locale} />
        <Personal content={content.personal} />
      </main>
      <Contact content={content} />
    </div>
  </div>
</BaseLayout>
