{
  "name": "alexis-robin-portfolio",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "sync:github": "node scripts/sync-github.mjs",
    "test:github": "node --test scripts/github-integrity.test.mjs",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "build": "node scripts/sync-github.mjs --allow-stale && astro build",
    "preview": "astro preview",
    "deploy": "node scripts/sync-github.mjs --allow-stale && astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/vue": "^7.0.3",
    "@tailwindcss/vite": "4.3.3",
    "@vueuse/motion": "^3.0.3",
    "astro": "7.3.3",
    "tailwindcss": "4.3.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "parse5": "8.0.1",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "simple-icons": "16.32.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "wrangler": "4.135.0"
  }
}
